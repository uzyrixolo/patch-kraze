<!doctype html>
<html
  class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}"
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    <link
      rel="expect"
      href="#MainContent"
      blocking="render"
      id="view-transition-render-blocker"
    >

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
      :root {
        --font-body--family: 'Inter', sans-serif !important;
        --font-heading--family: 'Inter', sans-serif !important;

        /* Patch Kraze homepage type scale - consolidates ~30 ad-hoc
           font-size values (scattered one-off rem numbers per section)
           down to this shared set. Every step only ever equals or exceeds
           the largest value it replaces, so nothing on the page renders
           smaller than before - only more consistent. */
        --pk-fs-hero: 2.6rem;          /* hero heading, desktop */
        --pk-fs-hero-mobile: 1.9rem;   /* hero heading, mobile */
        --pk-fs-heading: 2.25rem;      /* section headings (h2), desktop */
        --pk-fs-heading-mobile: 1.875rem;/* section headings (h2), mobile */
        --pk-fs-heading-sm: 1.5rem;    /* card/feature titles, rail labels, popup heading */
        --pk-fs-subheading: 1.125rem;  /* subheadings / section intro text */
        --pk-fs-body: 1rem;            /* body copy */
        --pk-fs-label: 0.875rem;       /* labels, eyebrows, badges, meta */
        --pk-fs-tiny: 0.65rem;         /* smallest utility text */

        /* Patch Kraze homepage corner-radius scale - consolidates ~13 ad-hoc
           border-radius values (0.25rem to 1.4rem, plus 999px/9999px used
           interchangeably for the same "fully round" intent) down to this
           shared set. Perfect circles (50%, on icon buttons/dots/close
           buttons) are left alone - that's already a consistent, distinct
           convention, not a real inconsistency. */
        --pk-radius-sm: 0.5rem;    /* buttons, chips, small thumbnails, inputs */
        --pk-radius-md: 0.75rem;   /* content cards */
        --pk-radius-lg: 1.25rem;   /* prominent containers: hero media, mega-menu, popups */
        --pk-radius-pill: 999px;   /* pills, eyebrows, badges, search bar, selected controls */

        /* Patch Kraze homepage button system - consolidates ~25 ad-hoc
           button treatments down to a shared set of colors/transitions so
           every button on the page draws from one source of truth. Existing
           class names, markup and JS hooks are untouched everywhere this is
           used - only the CSS values feeding each button's look change. */
        --pk-btn-primary-bg: #10b981;
        --pk-btn-primary-bg-hover: #059669;
        --pk-btn-primary-fg: #ffffff;
        --pk-btn-dark-bg: #111827;
        --pk-btn-dark-bg-hover: #1f2937;
        --pk-btn-dark-fg: #ffffff;
        --pk-btn-outline-bg: #1f2937;
        --pk-btn-outline-bg-hover: #111827;
        --pk-btn-outline-border: #374151;
        --pk-btn-outline-fg: #ffffff;
        --pk-btn-text-fg: #6b7280;
        --pk-btn-text-fg-hover: #111827;
        --pk-btn-icon-fg: #111827;
        --pk-btn-icon-bg-hover: rgba(17, 24, 39, 0.06);
        --pk-btn-transition: 0.15s ease;
      }
      /* Utility/Icon button recipe - reusable base for any icon-only control
         (nav icons, carousel arrows, dialog close buttons). Components opt
         in by adding this class alongside their own; component-specific
         rules still set width/height/position since those vary by context. */
      .pk-btn-icon {
        display: inline-flex; align-items: center; justify-content: center;
        background: transparent; border: none; color: var(--pk-btn-icon-fg);
        cursor: pointer; transition: background-color var(--pk-btn-transition), color var(--pk-btn-transition);
      }
      .pk-btn-icon:hover { background: var(--pk-btn-icon-bg-hover); }
      .pk-btn-icon:focus-visible, .pk-btn-text:focus-visible, .pk-btn-primary:focus-visible,
      .pk-btn-dark:focus-visible, .pk-btn-outline:focus-visible {
        outline: 2px solid #111827; outline-offset: 2px;
      }
      /* Text/Link CTA recipe - plain-text actions (view-all links, dismiss
         buttons, disclosure toggles). No fill, no border. */
      .pk-btn-text {
        background: none; border: none; color: var(--pk-btn-text-fg);
        cursor: pointer; transition: color var(--pk-btn-transition);
      }
      .pk-btn-text:hover { color: var(--pk-btn-text-fg-hover); }
      /* Primary CTA recipe - the main "buy/act now" action, filled brand
         green. Component classes keep their own padding/radius/font-size
         (those vary by context) and only inherit color from here. */
      .pk-btn-primary {
        background: var(--pk-btn-primary-bg); color: var(--pk-btn-primary-fg);
        transition: background-color var(--pk-btn-transition);
      }
      .pk-btn-primary:hover { background: var(--pk-btn-primary-bg-hover); }
      /* Dark CTA recipe - a strong but not primary action, filled
         near-black with no border. */
      .pk-btn-dark {
        background: var(--pk-btn-dark-bg); color: var(--pk-btn-dark-fg);
        transition: background-color var(--pk-btn-transition);
      }
      .pk-btn-dark:hover { background: var(--pk-btn-dark-bg-hover); }
      /* Secondary/Outline CTA recipe - the alternate choice next to a
         Primary CTA (e.g. hero's "Get a Free Quote" beside "Shop Custom
         Patches"). Same dark family as the Dark CTA but with a visible
         border, which is what distinguished it in the existing design. */
      .pk-btn-outline {
        background: var(--pk-btn-outline-bg); color: var(--pk-btn-outline-fg);
        border: 1px solid var(--pk-btn-outline-border);
        transition: background-color var(--pk-btn-transition);
      }
      .pk-btn-outline:hover { background: var(--pk-btn-outline-bg-hover); }
      body, h1, h2, h3, h4, h5, h6, p, span, a, div, input, button {
        font-family: 'Inter', sans-serif !important;
      }
      /* Judge.me's star rating renders via its own icon fonts (JudgemeStar /
         JudgemeIcons) on plain <span> elements - the blanket rule above was
         forcing Inter onto them too, so the star glyphs never painted even
         though the numeric rating was correct. `revert` doesn't restore a
         third-party author stylesheet's own rule, so the icon font is named
         explicitly here instead. */
      .jm-star-rating__font-icon, .jm-star-rating__font-icon *,
      .jdgm-star, .jdgm-star *,
      [class*="jdgm-"][class*="icon"], [class*="jdgm-"][class*="icon"] *,
      [class*="jm-"][class*="icon"], [class*="jm-"][class*="icon"] * {
        font-family: JudgemeStar, JudgemeIcons, monospace !important;
      }
      /* Native product-card blocks derive their border color from
         --color-border-rgb on a color-scheme wrapper class, but that class
         renders empty here ("color-" with nothing appended) - the
         rgb(var(--color-border-rgb) / 0.12) formula then falls back to solid
         black instead of a light gray. Set the border color directly. */
      .product-grid__card.border-style {
        --border-color: #9ca3af !important;
      }
      /* "Complete your order" caps carousel: the theme editor's
         mobile_card_size setting (cqw-based) is overridden by a fixed-pixel
         width rule in Shopify's own base CSS below ~750px, so changing that
         setting alone doesn't change how many cards show on mobile. Force it
         directly so 3 cards fit per screen instead of ~1.3. */
      @media (max-width: 749px) {
        .resource-list__carousel .resource-list__slide {
          width: calc(33.333% - 6px) !important;
        }
      }
    </style>

    {{ content_for_header }}
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <script>
      // Inline header height calculation to prevent layout shift
      // Note: Updates in calculateHeaderGroupHeight() and updateTransparentHeaderOffset()utilities.js should be kept in sync with this function
      (function setHeaderHeighCustomProperties() {
        /*
         * Header calculation functions for maintaining CSS variables
         * Mimic calculateHeaderGroupHeight() in utilities.js
         */
        const header = document.querySelector('header-component');
        const headerGroup = document.querySelector('#header-group');
        const hasHeaderSection = headerGroup?.querySelector('.header-section');

        if (!header || !headerGroup) return;

        const headerHeight = header.offsetHeight;

        // Calculate the total height of the header group
        let headerGroupHeight = 0;
        const children = headerGroup.children;
        for (let i = 0; i < children.length; i++) {
          const element = children[i];
          if (element === header || !(element instanceof HTMLElement)) continue;
          headerGroupHeight += element.offsetHeight;
        }

        // Check for transparent header special case
        if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
          headerGroupHeight += headerHeight;
        }

        // Set CSS variables
        document.body.style.setProperty('--header-height', `${headerHeight}px`);
        document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);

        /**
         * Updates CSS custom properties for transparent header offset calculation
         * Mimic updateTransparentHeaderOffset() in utilities.js
         */

        if (!hasHeaderSection || !header?.hasAttribute('transparent')) {
          document.body.style.setProperty('--transparent-header-offset-boolean', '0');
          return;
        }

        const hasImmediateSection = hasHeaderSection.nextElementSibling?.classList.contains('shopify-section');

        const shouldApplyOffset = !hasImmediateSection ? '1' : '0';
        document.body.style.setProperty('--transparent-header-offset-boolean', shouldApplyOffset);
      })();
    </script>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}
  </body>
</html>
