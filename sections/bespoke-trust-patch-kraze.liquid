{% schema %}
{
  "name": "Bespoke Trust PK",
  "class": "section-bespoke-trust",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Special patches made with love!"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Bespoke Patches is a reliable patch-making company in the USA that can make your garments stand out with quality emblems. Let's design some for you."
    },
    {
      "type": "text",
      "id": "brand_name_1",
      "label": "Brand Name Layout Line 1",
      "default": "BESPOKE"
    },
    {
      "type": "text",
      "id": "brand_name_2",
      "label": "Brand Name Layout Line 2",
      "default": "PATCHES"
    }
  ],
  "presets": [
    {
      "name": "Bespoke Trust PK"
    }
  ]
}
{% endschema %}

<div class="bespoke-section" {% if section.settings.background_image %}style="background-image: url('{{ section.settings.background_image | image_url: width: 2000 }}');"{% endif %}>
  <div class="bespoke-container">
    <div class="bespoke-content">
      
      <!-- Trust Badge (SVG) -->
      <div class="trust-badge">
        <svg viewBox="0 0 100 100" class="badge-svg">
          <circle cx="50" cy="50" r="48" fill="none" stroke="currentColor" stroke-width="2" />
          <circle cx="50" cy="50" r="42" fill="none" stroke="currentColor" stroke-width="1" />
          <text x="50" y="35" text-anchor="middle" fill="currentColor" font-size="10" font-weight="bold">ESTABLISHED</text>
          <text x="50" y="65" text-anchor="middle" fill="currentColor" font-size="10" font-weight="bold">TRUSTED</text>
           <g transform="translate(50, 50)">
            <circle cx="0" cy="-30" r="2" fill="currentColor" />
            <circle cx="21" cy="-21" r="2" fill="currentColor" />
            <circle cx="30" cy="0" r="2" fill="currentColor" />
            <circle cx="21" cy="21" r="2" fill="currentColor" />
            <circle cx="0" cy="30" r="2" fill="currentColor" />
            <circle cx="-21" cy="21" r="2" fill="currentColor" />
            <circle cx="-30" cy="0" r="2" fill="currentColor" />
            <circle cx="-21" cy="-21" r="2" fill="currentColor" />
          </g>
        </svg>
      </div>

      <h2 class="bespoke-heading">{{ section.settings.heading }}</h2>
      <p class="bespoke-desc">{{ section.settings.description }}</p>

      <!-- Brand Logo (Simulated) -->
      <div class="bespoke-logo-box">
        <div class="brand-line">{{ section.settings.brand_name_1 }}</div>
        <div class="brand-line">{{ section.settings.brand_name_2 }}</div>
      </div>

    </div>
  </div>
</div>

<style>
  .bespoke-section {
    position: relative;
    width: 100%;
    padding: 4rem 0;
    background-color: #0f172a; /* slate-900 */
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    color: white;
  }
  
  .bespoke-container {
    max-width: 1200px; /* max-w-6xl */
    margin: 0 auto;
    padding: 0 1rem;
    position: relative;
    z-index: 10;
  }
  
  .bespoke-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 600px;
  }

  .trust-badge {
    margin-bottom: 2rem;
    width: 6rem; /* w-24 */
    height: 6rem;
    color: white;
  }
  
  .badge-svg {
    width: 100%;
    height: 100%;
  }

  .bespoke-heading {
    font-size: 2.25rem; /* text-4xl */
    font-weight: 700;
    margin-bottom: 1.5rem;
    line-height: 1.1;
  }

  .bespoke-desc {
    color: #d1d5db; /* gray-300 */
    font-size: 1.125rem; /* text-lg */
    margin-bottom: 2rem;
    line-height: 1.625;
  }

  .bespoke-logo-box {
    display: inline-flex;
    flex-direction: column;
    background-color: #ea580c; /* orange-600 */
    color: white;
    padding: 1rem 1.5rem;
    border-radius: 0.25rem;
    width: fit-content;
  }

  .brand-line {
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1;
  }
</style>
