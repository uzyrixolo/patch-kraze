{% comment %}
  Category rail for the Blanks collection page: pill cards across the top, a
  filter sidebar, and the matching product grid underneath. The first block
  renders expanded, so the page opens on whichever category is ordered first
  (Hats).

  Filters are client-side (checkbox/swatch toggles show or hide the already-
  rendered cards) rather than real Shopify collection filters, because this
  section renders a fixed product list per category block, not a paginated
  collection object main-collection can filter natively.

  Style and Fabric have no metafield on these products, so those two facets
  are derived from words already in the product title (see
  snippets/derive-facet-tags.liquid) rather than invented. A product whose
  title names none of the known words simply carries no tag for that facet.
{% endcomment %}

{% schema %}
{
  "name": "Blanks Categories",
  "class": "section-blanks-categories",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop Blanks by Category" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Pick a category to browse every blank we stock." },
    { "type": "range", "id": "limit", "label": "Products per category", "min": 4, "max": 48, "step": 4, "default": 24 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show a \"View all\" link per category", "default": true },
    { "type": "checkbox", "id": "show_swatches", "label": "Show colour swatches on product cards", "default": true },
    { "type": "range", "id": "swatch_limit", "label": "Swatches per card", "min": 3, "max": 12, "step": 1, "default": 6, "info": "Remaining colours are summarised as \"+N\"." },
    { "type": "range", "id": "filter_swatch_limit", "label": "Colour swatches shown before \"Show all\"", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "checkbox", "id": "enable_filters", "label": "Show the filter sidebar", "default": true, "info": "Colour, Price, Style and Fabric — only facets with at least one matching product are shown." }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label", "info": "Defaults to the collection title." },
        { "type": "image_picker", "id": "image", "label": "Card image", "info": "Defaults to the collection image, then its first product image." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Blanks Categories",
      "blocks": [{ "type": "category" }, { "type": "category" }]
    }
  ]
}
{% endschema %}

<style>
  .bkc { max-width: 1280px; margin: 0 auto; padding: 2rem 1rem 3rem; }
  .bkc__head { margin-bottom: 1.5rem; }
  .bkc__heading { font-size: 1.75rem; font-weight: 800; color: #111827; margin: 0 0 0.35rem; }
  .bkc__sub { font-size: 0.95rem; color: #6b7280; margin: 0; }

  /* Card rail: scrolls sideways on small screens rather than wrapping to a
     second row, which is what the reference layout does. */
  .bkc__rail { display: flex; gap: 0.75rem; overflow-x: auto; padding-bottom: 0.5rem; margin-bottom: 2rem; scrollbar-width: thin; }
  .bkc__card { display: flex; align-items: center; gap: 0.7rem; flex: 0 0 auto; padding: 0.6rem 1rem 0.6rem 0.6rem; background: #fff; border: 1px solid #e5e7eb; border-radius: 0.85rem; box-shadow: 0 1px 2px rgba(0,0,0,0.04); cursor: pointer; font-family: inherit; font-size: 0.95rem; font-weight: 600; color: #111827; transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s; }
  .bkc__card:hover { border-color: #10b981; transform: translateY(-1px); }
  .bkc__card[aria-selected='true'] { border-color: #10b981; box-shadow: 0 0 0 1px #10b981; }
  .bkc__card-icon { width: 3rem; height: 3rem; border-radius: 0.65rem; overflow: hidden; background: #f3f4f6; flex-shrink: 0; display: block; }
  .bkc__card-icon img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .bkc__card-chevron { width: 0.85rem; height: 0.85rem; color: #9ca3af; flex-shrink: 0; }

  .bkc__panel[hidden] { display: none; }
  .bkc__panel-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .bkc__panel-title { font-size: 1.15rem; font-weight: 700; color: #111827; margin: 0; }
  .bkc__view-all { font-size: 0.875rem; font-weight: 600; color: #059669; text-decoration: none; white-space: nowrap; }
  .bkc__view-all:hover { text-decoration: underline; }

  /* ---- Filter sidebar + grid layout ---- */
  .bkc__panel-body { display: flex; align-items: flex-start; gap: 1.75rem; }

  /* The whole panel sits in one bordered card, matching the product cards below
     it, rather than floating loose against the page background. */
  .bkc__filters { flex: 0 0 216px; width: 216px; background: #fff; border: 1px solid #e5e7eb; border-radius: 0.9rem; box-shadow: 0 1px 2px rgba(0,0,0,0.04); overflow: hidden; }
  .bkc__filters-toggle { display: none; }
  .bkc__filters-body { padding: 1.1rem 1.1rem 0.5rem; }
  .bkc__filters-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem; }
  .bkc__filters-title { font-weight: 700; font-size: 0.95rem; color: #111827; }
  .bkc__filters-clear { background: none; border: none; color: #059669; font-size: 0.8rem; font-weight: 600; cursor: pointer; padding: 0; }
  .bkc__filters-clear:hover { text-decoration: underline; }

  /* Each facet is a native <details> accordion — free open/close behaviour and
     keyboard support with no JS of our own to maintain. */
  .bkc__filter-group { border-top: 1px solid #e5e7eb; padding: 0.9rem 0; }
  .bkc__filter-group:first-of-type { border-top: none; padding-top: 0.15rem; }
  .bkc__filter-heading {
    display: flex; align-items: center; justify-content: space-between; cursor: pointer;
    font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
    color: #374151; margin: 0; list-style: none;
  }
  .bkc__filter-heading::-webkit-details-marker { display: none; }
  .bkc__filter-chevron { width: 0.8rem; height: 0.8rem; color: #9ca3af; flex-shrink: 0; transition: transform 0.15s; }
  .bkc__filter-group[open] .bkc__filter-chevron { transform: rotate(180deg); }
  .bkc__filter-group > *:not(summary) { margin-top: 0.75rem; }

  .bkc__filter-swatches { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .bkc__filter-swatch { display: inline-flex; padding: 2px; border-radius: 6px; border: none; background: none; cursor: pointer; line-height: 0; outline: 2px solid transparent; outline-offset: 1px; transition: outline-color 0.15s; }
  .bkc__filter-swatch:hover { outline-color: #d1d5db; }
  .bkc__filter-swatch[aria-pressed='true'] { outline-color: #111827; }
  .bkc__filter-swatch .swatch { --swatch-width: 22px; --swatch-height: 22px; border-radius: 5px; }
  /* Fixed rainbow-wheel icon for "Multi Color" — it stands for the whole two-tone
     bucket, not any one product's colours, so it isn't drawn from swatch data. */
  .bkc__multi-swatch { background: conic-gradient(from 0deg, #ef4444, #f59e0b, #eab308, #22c55e, #0ea5e9, #6366f1, #a855f7, #ef4444) !important; }
  .bkc__show-more { display: block; margin-top: 0.6rem; background: none; border: none; padding: 0; font-size: 0.8rem; font-weight: 600; color: #059669; cursor: pointer; }
  .bkc__show-more:hover { text-decoration: underline; }

  .bkc__filter-check { display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; color: #374151; padding: 0.3rem 0; cursor: pointer; }
  .bkc__filter-check input { accent-color: #10b981; width: 15px; height: 15px; flex-shrink: 0; }
  .bkc__filter-check span { color: #9ca3af; }

  .bkc__grid-wrap { flex: 1; min-width: 0; }
  .bkc__result-count { font-size: 0.85rem; color: #6b7280; margin: 0 0 0.85rem; }
  .bkc__no-results { color: #6b7280; font-size: 0.95rem; padding: 2.5rem 0; text-align: center; }

  .bkc__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1.25rem; }
  /* Each product sits in its own white card, so the photo, the colours and the
     price read as one unit against the page. */
  .bkc__product { display: flex; flex-direction: column; background: #fff; border: 1px solid #e5e7eb; border-radius: 0.9rem; padding: 0.85rem; box-shadow: 0 1px 2px rgba(0,0,0,0.04); transition: box-shadow 0.18s ease, transform 0.18s ease; }
  .bkc__product:hover { box-shadow: 0 10px 26px rgba(0,0,0,0.10); transform: translateY(-2px); }
  .bkc__product[hidden] { display: none; }
  .bkc__product-link { display: block; text-decoration: none; color: inherit; }
  .bkc__product-img { aspect-ratio: 1; border-radius: 0.6rem; overflow: hidden; background: #fff; }
  /* contain, not cover: these are catalogue product shots, and cropping a cap
     or a jacket to fill a square hides the shape the shopper is judging. */
  .bkc__product-img img { width: 100%; height: 100%; object-fit: contain; display: block; transition: transform 0.25s ease; }
  .bkc__product:hover .bkc__product-img img { transform: scale(1.04); }
  /* Colour rail. Sized through the theme's own swatch variables so both native
     swatches and the name-derived chips land the same size. */
  .bkc__chips { display: flex; flex-wrap: wrap; align-items: center; gap: 0.3rem; margin: 0.75rem 0 0; }
  .bkc__chip { display: inline-flex; line-height: 0; border-radius: 4px; outline: 2px solid transparent; outline-offset: 2px; transition: outline-color 0.15s; }
  .bkc__chip:hover, .bkc__chip:focus-visible { outline-color: #111827; }
  .bkc__chips .swatch { --swatch-width: 20px; --swatch-height: 20px; border-radius: 4px; }
  .bkc__chip-more { font-size: 0.75rem; font-weight: 600; color: #6b7280; text-decoration: none; padding-inline-start: 0.15rem; }
  .bkc__chip-more:hover { color: #111827; text-decoration: underline; }
  .bkc__product-meta { margin-top: 0.75rem; }
  .bkc__product-eyebrow { display: block; font-size: 0.68rem; font-weight: 600; letter-spacing: 0.09em; text-transform: uppercase; color: #9ca3af; margin-bottom: 0.1rem; }
  .bkc__product-price { display: block; font-size: 1.15rem; font-weight: 800; color: #16a34a; line-height: 1.2; }
  .bkc__product-title { display: block; font-size: 0.85rem; font-weight: 500; color: #4b5563; margin-top: 0.3rem; line-height: 1.35; }
  .bkc__empty { color: #6b7280; font-size: 0.95rem; margin: 0; }

  @media (max-width: 899px) {
    .bkc { padding: 1.5rem 1rem 2.5rem; }
    .bkc__heading { font-size: 1.4rem; }
    .bkc__grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 1.25rem 0.9rem; }
    .bkc__card-icon { width: 2.5rem; height: 2.5rem; }

    .bkc__panel-body { flex-direction: column; }
    .bkc__filters { width: 100%; flex-basis: auto; border-radius: 0.75rem; margin-bottom: 1.25rem; }
    .bkc__filters-toggle {
      display: flex; width: 100%; align-items: center; justify-content: space-between;
      padding: 0.8rem 1rem; background: #f9fafb; border: none; font-weight: 600;
      font-size: 0.9rem; color: #111827; cursor: pointer;
    }
    .bkc__filters-toggle svg { width: 1rem; height: 1rem; transition: transform 0.15s; }
    .bkc__filters--open .bkc__filters-toggle svg { transform: rotate(180deg); }
    .bkc__filters-body { display: none; padding: 0 1rem 1.1rem; }
    .bkc__filters--open .bkc__filters-body { display: block; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bkc__card, .bkc__product-img img, .bkc__filters-toggle svg { transition: none; }
  }
</style>

<div class="bkc" id="BlanksCats-{{ section.id }}">
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="bkc__head">
      {%- if section.settings.heading != blank -%}
        <h2 class="bkc__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="bkc__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="bkc__rail" role="tablist" aria-label="{{ section.settings.heading | default: 'Categories' | escape }}">
    {%- for block in section.blocks -%}
      {%- liquid
        assign cat = block.settings.collection
        assign label = block.settings.label | default: cat.title | default: 'Category'
        assign card_image = block.settings.image | default: cat.image | default: cat.products.first.featured_image
      -%}
      <button
        type="button"
        class="bkc__card"
        role="tab"
        id="BkcTab-{{ block.id }}"
        aria-controls="BkcPanel-{{ block.id }}"
        aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
        tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
        data-bkc-handle="{{ cat.handle }}"
        {{ block.shopify_attributes }}
      >
        <span class="bkc__card-icon">
          {%- if card_image -%}
            {{ card_image | image_url: width: 120 | image_tag: widths: '60,90,120', sizes: '48px', alt: label, loading: 'lazy' }}
          {%- endif -%}
        </span>
        <span class="bkc__card-label">{{ label }}</span>
        <svg class="bkc__card-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    {%- endfor -%}
  </div>

  {%- for block in section.blocks -%}
    {%- liquid
      assign cat = block.settings.collection
      assign label = block.settings.label | default: cat.title | default: 'Category'
      assign panel_products = cat.products
    -%}
    <div
      class="bkc__panel"
      role="tabpanel"
      id="BkcPanel-{{ block.id }}"
      aria-labelledby="BkcTab-{{ block.id }}"
      tabindex="0"
      {% unless forloop.first %}hidden{% endunless %}
    >
      <div class="bkc__panel-head">
        <h3 class="bkc__panel-title">{{ label }}</h3>
        {%- if section.settings.show_view_all and cat != blank -%}
          <a class="bkc__view-all" href="{{ cat.url }}">View all {{ cat.all_products_count }} &rarr;</a>
        {%- endif -%}
      </div>

      {%- if cat != blank and panel_products.size > 0 -%}
        {%- comment %} ---- Facet pre-pass: one sweep over this category's products to
             collect distinct colours and count Price/Style/Fabric matches, all computed
             fresh per category so Hats and Jackets never leak into each other. ---- {%- endcomment %}
        {%- liquid
          assign filter_color_values = '' | split: ','
          assign seen_color_handles = '' | split: ','
          assign has_multi_color = false

          assign count_dadcap = 0
          assign count_trucker = 0
          assign count_snapback = 0
          assign count_unstructured = 0
          assign count_structured = 0
          assign count_fitted = 0
          assign count_cadet = 0
          assign count_driver = 0
          assign count_distressed = 0
          assign count_cuff = 0
          assign count_lowprofile = 0
          assign count_baseball = 0
          assign count_safety = 0
          assign count_performance = 0

          assign count_cottontwill = 0
          assign count_woolblend = 0
          assign count_foammesh = 0
          assign count_hemp = 0
          assign count_poly = 0
          assign count_knit = 0
          assign count_piqueknit = 0

          assign price_min_overall = null
          assign price_max_overall = null

          for product in panel_products
            assign color_option = null
            for product_option in product.options_with_values
              assign option_key = product_option.name | downcase
              if option_key contains 'colo' and color_option == null
                assign color_option = product_option
              endif
            endfor

            if color_option != blank
              for value in color_option.values
                if value.name contains '/'
                  # Two-tone values ("Black / White Sleeves") join the single "Multi
                  # Color" swatch instead of each becoming their own filter entry —
                  # matches the reference site's "Multi" bucket rather than listing
                  # every body/sleeve combination as its own colour.
                  assign has_multi_color = true
                else
                  assign value_handle = value.name | handleize
                  unless seen_color_handles contains value_handle
                    assign one_handle = value_handle | split: '|'
                    assign seen_color_handles = seen_color_handles | concat: one_handle
                    assign matching_value = color_option.values | where: 'name', value.name
                    assign filter_color_values = filter_color_values | concat: matching_value
                  endunless
                endif
              endfor
            endif

            capture style_csv
              render 'derive-facet-tags', title: product.title, kind: 'style'
            endcapture
            capture fabric_csv
              render 'derive-facet-tags', title: product.title, kind: 'fabric'
            endcapture

            if style_csv contains 'Dad Cap'
              assign count_dadcap = count_dadcap | plus: 1
            endif
            if style_csv contains 'Trucker'
              assign count_trucker = count_trucker | plus: 1
            endif
            if style_csv contains 'Snapback'
              assign count_snapback = count_snapback | plus: 1
            endif
            if style_csv contains 'Unstructured'
              assign count_unstructured = count_unstructured | plus: 1
            elsif style_csv contains 'Structured'
              assign count_structured = count_structured | plus: 1
            endif
            if style_csv contains 'Fitted'
              assign count_fitted = count_fitted | plus: 1
            endif
            if style_csv contains 'Cadet'
              assign count_cadet = count_cadet | plus: 1
            endif
            if style_csv contains 'Driver'
              assign count_driver = count_driver | plus: 1
            endif
            if style_csv contains 'Distressed'
              assign count_distressed = count_distressed | plus: 1
            endif
            if style_csv contains 'Cuff'
              assign count_cuff = count_cuff | plus: 1
            endif
            if style_csv contains 'Low-Profile'
              assign count_lowprofile = count_lowprofile | plus: 1
            endif
            if style_csv contains 'Baseball'
              assign count_baseball = count_baseball | plus: 1
            endif
            if style_csv contains 'Safety'
              assign count_safety = count_safety | plus: 1
            endif
            if style_csv contains 'Performance'
              assign count_performance = count_performance | plus: 1
            endif

            if fabric_csv contains 'Cotton Twill'
              assign count_cottontwill = count_cottontwill | plus: 1
            endif
            if fabric_csv contains 'Wool Blend'
              assign count_woolblend = count_woolblend | plus: 1
            endif
            if fabric_csv contains 'Foam Mesh'
              assign count_foammesh = count_foammesh | plus: 1
            endif
            if fabric_csv contains 'Hemp'
              assign count_hemp = count_hemp | plus: 1
            endif
            if fabric_csv contains 'Poly'
              assign count_poly = count_poly | plus: 1
            endif
            if fabric_csv contains 'Pique Knit'
              assign count_piqueknit = count_piqueknit | plus: 1
            elsif fabric_csv contains 'Knit'
              assign count_knit = count_knit | plus: 1
            endif

            assign this_price = product.price_min
            if price_min_overall == null or this_price < price_min_overall
              assign price_min_overall = this_price
            endif
            if price_max_overall == null or this_price > price_max_overall
              assign price_max_overall = this_price
            endif
          endfor

          assign price_span = 0
          if price_min_overall != null and price_max_overall != null
            assign price_span = price_max_overall | minus: price_min_overall
          endif

          if price_span > 0
            assign price_break_1 = price_span | times: 0.34 | plus: price_min_overall
            assign price_break_2 = price_span | times: 0.67 | plus: price_min_overall
            assign price_break_1_display = price_break_1 | round
            assign price_break_2_display = price_break_2 | round

            assign count_price_0 = 0
            assign count_price_1 = 0
            assign count_price_2 = 0
            for product in panel_products
              assign this_price = product.price_min
              if this_price <= price_break_1
                assign count_price_0 = count_price_0 | plus: 1
              elsif this_price <= price_break_2
                assign count_price_1 = count_price_1 | plus: 1
              else
                assign count_price_2 = count_price_2 | plus: 1
              endif
            endfor
          endif

          assign has_style_facet = false
          if count_dadcap > 0 or count_trucker > 0 or count_snapback > 0 or count_unstructured > 0 or count_structured > 0 or count_fitted > 0 or count_cadet > 0 or count_driver > 0 or count_distressed > 0 or count_cuff > 0 or count_lowprofile > 0 or count_baseball > 0 or count_safety > 0 or count_performance > 0
            assign has_style_facet = true
          endif

          assign has_fabric_facet = false
          if count_cottontwill > 0 or count_woolblend > 0 or count_foammesh > 0 or count_hemp > 0 or count_poly > 0 or count_knit > 0 or count_piqueknit > 0
            assign has_fabric_facet = true
          endif

          assign has_any_facet = false
          if filter_color_values.size > 0 or has_multi_color or price_span > 0 or has_style_facet or has_fabric_facet
            assign has_any_facet = true
          endif
        -%}

        <div class="bkc__panel-body">
          {%- if section.settings.enable_filters and has_any_facet -%}
            <aside class="bkc__filters" data-bkc-filters aria-label="Filter {{ label | escape }}">
              <button type="button" class="bkc__filters-toggle" data-bkc-filters-toggle aria-expanded="false">
                <span>Filters</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
              </button>

              <div class="bkc__filters-body">
                <div class="bkc__filters-head">
                  <span class="bkc__filters-title">Filters</span>
                  <button type="button" class="bkc__filters-clear" data-bkc-clear hidden>Clear all</button>
                </div>

                {%- if filter_color_values.size > 0 or has_multi_color -%}
                  {%- assign filter_swatch_limit = section.settings.filter_swatch_limit -%}
                  <details class="bkc__filter-group" open>
                    <summary class="bkc__filter-heading">Colors<svg class="bkc__filter-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></summary>
                    <div class="bkc__filter-swatches" data-bkc-swatch-list>
                      {%- for value in filter_color_values -%}
                        <button
                          type="button"
                          class="bkc__filter-swatch{% if forloop.index0 >= filter_swatch_limit %} bkc__filter-swatch--extra{% endif %}"
                          data-facet="color"
                          data-value="{{ value.name | handleize }}"
                          aria-pressed="false"
                          title="{{ value.name | escape }}"
                          {% if forloop.index0 >= filter_swatch_limit %}hidden{% endif %}
                        >
                          {%- if value.swatch -%}
                            {% render 'swatch', swatch: value.swatch, mode: 'unscaled' %}
                          {%- else -%}
                            {% render 'color-name-swatch', value: value.name %}
                          {%- endif -%}
                        </button>
                      {%- endfor -%}
                      {%- if has_multi_color -%}
                        {%- comment %} Represents every two-tone value as one bucket, the same
                           way the reference site's "Multi" swatch does — a specific
                           "Black / White Sleeves" combo isn't a useful filter on its own,
                           but "has more than one colour" is. {%- endcomment %}
                        <button
                          type="button"
                          class="bkc__filter-swatch"
                          data-facet="color"
                          data-value="multi-color"
                          aria-pressed="false"
                          title="Multi Color"
                        >
                          <span class="swatch swatch--unscaled bkc__multi-swatch"></span>
                        </button>
                      {%- endif -%}
                    </div>
                    {%- if filter_color_values.size > filter_swatch_limit -%}
                      <button type="button" class="bkc__show-more" data-bkc-show-more>Show all ({{ filter_color_values.size }})</button>
                    {%- endif -%}
                  </details>
                {%- endif -%}

                {%- if price_span > 0 -%}
                  <details class="bkc__filter-group" open>
                    <summary class="bkc__filter-heading">Price<svg class="bkc__filter-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></summary>
                    {%- if count_price_0 > 0 -%}
                      <label class="bkc__filter-check"><input type="checkbox" data-facet="price" value="0"> Under ${{ price_break_1_display }} <span>({{ count_price_0 }})</span></label>
                    {%- endif -%}
                    {%- if count_price_1 > 0 -%}
                      <label class="bkc__filter-check"><input type="checkbox" data-facet="price" value="1"> ${{ price_break_1_display }} &ndash; ${{ price_break_2_display }} <span>({{ count_price_1 }})</span></label>
                    {%- endif -%}
                    {%- if count_price_2 > 0 -%}
                      <label class="bkc__filter-check"><input type="checkbox" data-facet="price" value="2"> ${{ price_break_2_display }}+ <span>({{ count_price_2 }})</span></label>
                    {%- endif -%}
                  </details>
                {%- endif -%}

                {%- if has_style_facet -%}
                  <details class="bkc__filter-group" open>
                    <summary class="bkc__filter-heading">Style<svg class="bkc__filter-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></summary>
                    {%- if count_trucker > 0 -%}<label class="bkc__filter-check"><input type="checkbox" data-facet="style" value="{{ 'Trucker' | handleize }}"> Trucker <span>({{ count_trucker }})</span></label>{%- endif -%}
                    {%- if count_snapback > 0 -%}<label class="bkc__filter-check"><input type="checkbox" data-facet="style" value="{{ 'Snapback' | handleize }}"> Snapback <span>({{ count_snapback }})</span></label>{%- endif -%}
                    {%- if count_dadcap > 0 -%}<label class="bkc__filter-check"><input type="checkbox" data-facet="style" value="{{ 'Dad Cap' | handleize }}"> Dad Cap <span>({{ count_dadcap }})</span></label>{%- endif -%}
                    {%- if count_unstructured > 0 -%}<label class="bkc__filter-check"><input type="checkbox" data-facet="style" value="{{ 'Unstructured' | handleize }}"> Unstructured <span>({{ count_unstructured }})</span></label>{%- endif -%}
                    {%- if count_structured > 0 -%}<label class="bkc__filter-check"><input type="checkbox" data-facet="style" value="{{ 'Structured' | handleize }}"> Structured <span>({{ count_structured }})</span></label>{%- endif -%}
                    {%- if count_fitted > 0 -%}<label class="bkc__filter-check"><input type="checkbox" data-facet="style" value="{{ 'Fitted' | handleize }}"> Fitted <span>({{ count_fitted }})</span></label>{%- endif -%}
                    {%- if count_performance > 0 -%}<label class="bkc__filter-check"><input type="checkbox" data-facet="style" value="{{ 'Performance' | handleize }}"> Performance <span>({{ count_performance }})</span></label>{%- endif -%}
                    {%- if count_cadet > 0 -%}<label class="bkc__filter-check"><input type="checkbox" data-facet="style" value="{{ 'Cadet' | handleize }}"> Cadet <span>({{ count_cadet }})</span></label>{%- endif -%}
                    {%- if count_driver > 0 -%}<label class="bkc__filter-check"><input type="checkbox" data-facet="style" value="{{ 'Driver' | handleize }}"> Driver <span>({{ count_driver }})</span></label>{%- endif -%}
                    {%- if count_lowprofile > 0 -%}<label class="bkc__filter-check"><input type="checkbox" data-facet="style" value="{{ 'Low-Profile' | handleize }}"> Low-Profile <span>({{ count_lowprofile }})</span></label>{%- endif -%}
                    {%- if count_baseball > 0 -%}<label class="bkc__filter-check"><input type="checkbox" data-facet="style" value="{{ 'Baseball' | handleize }}"> Baseball <span>({{ count_baseball }})</span></label>{%- endif -%}
                    {%- if count_safety > 0 -%}<label class="bkc__filter-check"><input type="checkbox" data-facet="style" value="{{ 'Safety' | handleize }}"> Safety <span>({{ count_safety }})</span></label>{%- endif -%}
                    {%- if count_cuff > 0 -%}<label class="bkc__filter-check"><input type="checkbox" data-facet="style" value="{{ 'Cuff' | handleize }}"> Cuff <span>({{ count_cuff }})</span></label>{%- endif -%}
                    {%- if count_distressed > 0 -%}<label class="bkc__filter-check"><input type="checkbox" data-facet="style" value="{{ 'Distressed' | handleize }}"> Distressed <span>({{ count_distressed }})</span></label>{%- endif -%}
                  </details>
                {%- endif -%}

                {%- if has_fabric_facet -%}
                  <details class="bkc__filter-group" open>
                    <summary class="bkc__filter-heading">Fabric<svg class="bkc__filter-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></summary>
                    {%- if count_cottontwill > 0 -%}<label class="bkc__filter-check"><input type="checkbox" data-facet="fabric" value="{{ 'Cotton Twill' | handleize }}"> Cotton Twill <span>({{ count_cottontwill }})</span></label>{%- endif -%}
                    {%- if count_woolblend > 0 -%}<label class="bkc__filter-check"><input type="checkbox" data-facet="fabric" value="{{ 'Wool Blend' | handleize }}"> Wool Blend <span>({{ count_woolblend }})</span></label>{%- endif -%}
                    {%- if count_foammesh > 0 -%}<label class="bkc__filter-check"><input type="checkbox" data-facet="fabric" value="{{ 'Foam Mesh' | handleize }}"> Foam Mesh <span>({{ count_foammesh }})</span></label>{%- endif -%}
                    {%- if count_poly > 0 -%}<label class="bkc__filter-check"><input type="checkbox" data-facet="fabric" value="{{ 'Poly' | handleize }}"> Poly <span>({{ count_poly }})</span></label>{%- endif -%}
                    {%- if count_knit > 0 -%}<label class="bkc__filter-check"><input type="checkbox" data-facet="fabric" value="{{ 'Knit' | handleize }}"> Knit <span>({{ count_knit }})</span></label>{%- endif -%}
                    {%- if count_piqueknit > 0 -%}<label class="bkc__filter-check"><input type="checkbox" data-facet="fabric" value="{{ 'Pique Knit' | handleize }}"> Pique Knit <span>({{ count_piqueknit }})</span></label>{%- endif -%}
                    {%- if count_hemp > 0 -%}<label class="bkc__filter-check"><input type="checkbox" data-facet="fabric" value="{{ 'Hemp' | handleize }}"> Hemp <span>({{ count_hemp }})</span></label>{%- endif -%}
                  </details>
                {%- endif -%}
              </div>
            </aside>
          {%- endif -%}

          {%- comment %} Rendered-card count, not the category's full size — the grid below
             stops at section.settings.limit, and the JS filter engine's own count (which
             counts actual DOM cards) would otherwise disagree with this initial number. {%- endcomment %}
          {%- assign shown_count = panel_products.size | at_most: section.settings.limit -%}
          <div class="bkc__grid-wrap">
            <p class="bkc__result-count" data-bkc-count>{{ shown_count }} product{% if shown_count != 1 %}s{% endif %}</p>

            <div class="bkc__grid" data-bkc-grid>
              {%- for product in panel_products limit: section.settings.limit -%}
                {%- liquid
                  assign color_option = null
                  for product_option in product.options_with_values
                    assign option_key = product_option.name | downcase
                    if option_key contains 'colo' and color_option == null
                      assign color_option = product_option
                    endif
                  endfor

                  assign color_handles = '' | split: ','
                  if color_option != blank
                    for value in color_option.values
                      if value.name contains '/'
                        assign one_color_handle = 'multi-color' | split: '|'
                      else
                        assign one_color_handle = value.name | handleize | split: '|'
                      endif
                      assign color_handles = color_handles | concat: one_color_handle
                    endfor
                  endif

                  capture card_style_csv
                    render 'derive-facet-tags', title: product.title, kind: 'style'
                  endcapture
                  assign card_style_list = card_style_csv | split: ','
                  assign style_handles = '' | split: ','
                  for label in card_style_list
                    assign one_style_handle = label | handleize | split: '|'
                    assign style_handles = style_handles | concat: one_style_handle
                  endfor

                  capture card_fabric_csv
                    render 'derive-facet-tags', title: product.title, kind: 'fabric'
                  endcapture
                  assign card_fabric_list = card_fabric_csv | split: ','
                  assign fabric_handles = '' | split: ','
                  for label in card_fabric_list
                    assign one_fabric_handle = label | handleize | split: '|'
                    assign fabric_handles = fabric_handles | concat: one_fabric_handle
                  endfor

                  assign card_price_bucket = 0
                  if price_span > 0
                    if product.price_min <= price_break_1
                      assign card_price_bucket = 0
                    elsif product.price_min <= price_break_2
                      assign card_price_bucket = 1
                    else
                      assign card_price_bucket = 2
                    endif
                  endif
                -%}
                <div
                  class="bkc__product"
                  data-color="{{ color_handles | join: ',' }}"
                  data-style="{{ style_handles | join: ',' }}"
                  data-fabric="{{ fabric_handles | join: ',' }}"
                  data-price-bucket="{{ card_price_bucket }}"
                >
                  <a class="bkc__product-link" href="{{ product.url }}">
                    <div class="bkc__product-img">
                      {%- if product.featured_image -%}
                        {{ product.featured_image | image_url: width: 500 | image_tag: widths: '190,300,400,500', sizes: '(max-width: 749px) 45vw, 240px', alt: product.title, loading: 'lazy', class: 'bkc__product-photo' }}
                      {%- endif -%}
                    </div>
                  </a>

                  {%- if color_option != blank and section.settings.show_swatches -%}
                    {%- assign shown = 0 -%}
                    {%- capture chips -%}
                      {%- for value in color_option.values -%}
                        {%- if shown < section.settings.swatch_limit -%}
                          {%- capture chip -%}
                            {%- if value.swatch -%}
                              {% render 'swatch', swatch: value.swatch, mode: 'unscaled' %}
                            {%- else -%}
                              {% render 'color-name-swatch', value: value.name %}
                            {%- endif -%}
                          {%- endcapture -%}
                          {%- if chip != blank -%}
                            {%- assign shown = shown | plus: 1 -%}
                            {%- liquid
                              # Prefer the variant image, but fall back to the first photo
                              # named after this colour — the same filename/alt convention
                              # the product gallery groups by. Variant images come and go
                              # when media is re-uploaded; the naming does not.
                              assign chip_image = value.variant.featured_image
                              if chip_image == blank
                                assign value_file_key = value.name | handleize
                                assign value_alt_key = value.name | downcase
                                for candidate in product.images
                                  assign candidate_src = candidate.src | downcase
                                  assign candidate_alt = candidate.alt | default: '' | downcase
                                  if candidate_src contains value_file_key or candidate_alt contains value_alt_key
                                    assign chip_image = candidate
                                    break
                                  endif
                                endfor
                              endif
                            -%}
                            <a
                              class="bkc__chip"
                              href="{{ product.url }}?variant={{ value.variant.id }}"
                              title="{{ value.name | escape }}"
                              aria-label="{{ product.title | escape }} — {{ value.name | escape }}"
                              {% if chip_image %}
                                data-bkc-swap="{{ chip_image | image_url: width: 500 }}"
                              {% endif %}
                            >{{ chip }}</a>
                          {%- endif -%}
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endcapture -%}

                    {%- if shown > 0 -%}
                      {%- assign extra = color_option.values.size | minus: shown -%}
                      <div class="bkc__chips">
                        {{ chips }}
                        {%- if extra > 0 -%}
                          <a class="bkc__chip-more" href="{{ product.url }}">+{{ extra }}</a>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  {%- endif -%}

                  <a class="bkc__product-link bkc__product-meta" href="{{ product.url }}">
                    {%- if product.price_varies -%}
                      <span class="bkc__product-eyebrow">As low as</span>
                      <span class="bkc__product-price">{{ product.price_min | money }}</span>
                    {%- else -%}
                      <span class="bkc__product-price">{{ product.price | money }}</span>
                    {%- endif -%}
                    <span class="bkc__product-title">{{ product.title }}</span>
                  </a>
                </div>
              {%- endfor -%}
            </div>

            <p class="bkc__no-results" data-bkc-no-results hidden>No products match these filters.</p>
          </div>
        </div>
      {%- else -%}
        <p class="bkc__empty">Nothing in this category yet — check back soon.</p>
      {%- endif -%}
    </div>
  {%- endfor -%}
</div>

<script>
  (function () {
    var root = document.getElementById('BlanksCats-{{ section.id }}');
    if (!root) return;

    var tabs = Array.prototype.slice.call(root.querySelectorAll('[role="tab"]'));
    if (!tabs.length) return;

    function select(tab, focus) {
      tabs.forEach(function (t) {
        var on = t === tab;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
        var panel = document.getElementById(t.getAttribute('aria-controls'));
        if (panel) panel.hidden = !on;
      });
      if (focus) tab.focus();

      // Keep the category in the URL so a chosen tab survives refresh and sharing.
      var handle = tab.getAttribute('data-bkc-handle');
      if (handle && window.history.replaceState) {
        var url = new URL(window.location.href);
        url.searchParams.set('category', handle);
        window.history.replaceState({}, '', url);
      }
    }

    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        select(tab, false);
      });
      tab.addEventListener('keydown', function (event) {
        var i = tabs.indexOf(tab);
        var next = null;
        if (event.key === 'ArrowRight') next = tabs[(i + 1) % tabs.length];
        if (event.key === 'ArrowLeft') next = tabs[(i - 1 + tabs.length) % tabs.length];
        if (event.key === 'Home') next = tabs[0];
        if (event.key === 'End') next = tabs[tabs.length - 1];
        if (!next) return;
        event.preventDefault();
        select(next, true);
      });
    });

    // Hovering a colour shows that colour's photo without leaving the grid.
    root.addEventListener('mouseover', swapOn);
    root.addEventListener('focusin', swapOn);
    root.addEventListener('mouseout', swapOff);
    root.addEventListener('focusout', swapOff);

    function cardPhoto(chip) {
      var card = chip.closest('.bkc__product');
      return card ? card.querySelector('.bkc__product-photo') : null;
    }

    function swapOn(event) {
      var chip = event.target.closest && event.target.closest('[data-bkc-swap]');
      if (!chip) return;
      var photo = cardPhoto(chip);
      if (!photo) return;
      if (!photo.dataset.bkcOriginal) photo.dataset.bkcOriginal = photo.getAttribute('src');
      photo.removeAttribute('srcset');
      photo.setAttribute('src', chip.getAttribute('data-bkc-swap'));
    }

    function swapOff(event) {
      var chip = event.target.closest && event.target.closest('[data-bkc-swap]');
      if (!chip) return;
      var photo = cardPhoto(chip);
      if (!photo || !photo.dataset.bkcOriginal) return;
      photo.setAttribute('src', photo.dataset.bkcOriginal);
    }

    // ---- Facet filtering: client-side, since each panel is a fixed, already-
    // rendered product list rather than a paginated Shopify collection. ----
    root.querySelectorAll('.bkc__panel').forEach(function (panel) {
      var grid = panel.querySelector('[data-bkc-grid]');
      if (!grid) return;
      var cards = Array.prototype.slice.call(grid.querySelectorAll('.bkc__product'));
      var countEl = panel.querySelector('[data-bkc-count]');
      var noResultsEl = panel.querySelector('[data-bkc-no-results]');
      var clearBtn = panel.querySelector('[data-bkc-clear]');
      var controls = Array.prototype.slice.call(panel.querySelectorAll('[data-facet]'));
      if (!controls.length) return;

      function isOn(el) {
        return el.tagName === 'BUTTON' ? el.getAttribute('aria-pressed') === 'true' : el.checked;
      }

      function selectedValues(facet) {
        return controls
          .filter(function (el) { return el.dataset.facet === facet && isOn(el); })
          .map(function (el) { return el.value || el.dataset.value; });
      }

      function cardMatches(card, facetKey, values) {
        if (!values.length) return true;
        if (facetKey === 'price') return values.indexOf(card.dataset.priceBucket) !== -1;
        var list = (card.dataset[facetKey] || '').split(',').filter(Boolean);
        return values.some(function (v) { return list.indexOf(v) !== -1; });
      }

      function apply() {
        var sel = {
          color: selectedValues('color'),
          price: selectedValues('price'),
          style: selectedValues('style'),
          fabric: selectedValues('fabric')
        };
        var anyActive = sel.color.length || sel.price.length || sel.style.length || sel.fabric.length;
        if (clearBtn) clearBtn.hidden = !anyActive;

        var visible = 0;
        cards.forEach(function (card) {
          var show =
            cardMatches(card, 'color', sel.color) &&
            cardMatches(card, 'price', sel.price) &&
            cardMatches(card, 'style', sel.style) &&
            cardMatches(card, 'fabric', sel.fabric);
          card.hidden = !show;
          if (show) visible++;
        });

        if (countEl) countEl.textContent = visible + (visible === 1 ? ' product' : ' products');
        if (noResultsEl) noResultsEl.hidden = visible !== 0;
      }

      controls.forEach(function (el) {
        var evt = el.tagName === 'BUTTON' ? 'click' : 'change';
        el.addEventListener(evt, function () {
          if (el.tagName === 'BUTTON') {
            el.setAttribute('aria-pressed', isOn(el) ? 'false' : 'true');
          }
          apply();
        });
      });

      if (clearBtn) {
        clearBtn.addEventListener('click', function () {
          controls.forEach(function (el) {
            if (el.tagName === 'BUTTON') el.setAttribute('aria-pressed', 'false');
            else el.checked = false;
          });
          apply();
        });
      }

      // Mobile: filters collapse behind a toggle so a long list doesn't push
      // the grid below the fold; desktop shows the sidebar open via CSS.
      var toggle = panel.querySelector('[data-bkc-filters-toggle]');
      var aside = panel.querySelector('[data-bkc-filters]');
      if (toggle && aside) {
        toggle.addEventListener('click', function () {
          var open = aside.classList.toggle('bkc__filters--open');
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
      }

      // "Show all (N)" reveals the swatches past the configured cap.
      var showMore = panel.querySelector('[data-bkc-show-more]');
      if (showMore) {
        showMore.addEventListener('click', function () {
          var list = showMore.previousElementSibling;
          if (list) {
            list.querySelectorAll('.bkc__filter-swatch--extra[hidden]').forEach(function (el) {
              el.hidden = false;
            });
          }
          showMore.hidden = true;
        });
      }
    });

    // Deep link: ?category=<handle> wins over the default first tab.
    var wanted = new URLSearchParams(window.location.search).get('category');
    if (wanted) {
      var match = tabs.filter(function (t) {
        return t.getAttribute('data-bkc-handle') === wanted;
      })[0];
      if (match) select(match, false);
    }
  })();
</script>
