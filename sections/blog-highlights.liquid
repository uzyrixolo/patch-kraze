{% comment %}
  Latest posts from one blog, as cards: picture, date, title, a few lines of
  the post and a "read" link. The whole card is the link.

  Pictures are cropped to one shape so a row of cards lines up whatever the
  posts' own images look like. On phones the cards are one row that is swiped
  sideways, or a stacked list ("Layout on phones").

  Background: a color or gradient, or a picture with its own mobile version
  and a tint. "Heading color" switches the heading row to white for a dark
  background; the cards always stay dark-on-white.
{% endcomment %}

{% schema %}
{
  "name": "Blog Highlights",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "text", "id": "eyebrow", "label": "Small label above the heading", "default": "Blog", "info": "Leave empty to hide." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Guides and Ideas for Custom Patches" },
    { "type": "text", "id": "link_label", "label": "Link to all posts", "default": "See all posts", "info": "Goes to the blog. Leave empty to hide." },
    { "type": "range", "id": "post_limit", "label": "Posts to show", "min": 3, "max": 6, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "show_date", "label": "Show the date", "default": true },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show the first lines of the post", "default": true },
    { "type": "text", "id": "read_label", "label": "Read link label", "default": "Read the post", "info": "Leave empty to hide." },
    {
      "type": "select", "id": "mobile_layout", "label": "Layout on phones", "default": "swipe",
      "options": [
        { "value": "swipe", "label": "One row, swipe sideways" },
        { "value": "stack", "label": "Stacked list" }
      ]
    },
    { "type": "header", "content": "Background" },
    { "type": "color_background", "id": "background", "label": "Background (color or gradient)", "default": "#ffffff", "info": "Hidden by a background image when one is set below." },
    { "type": "image_picker", "id": "bg_image", "label": "Background image", "info": "Optional. Fills the whole section and is cropped to fit." },
    { "type": "image_picker", "id": "bg_image_mobile", "label": "Background image, mobile", "info": "Optional. Used on screens under 750px; falls back to the image above." },
    { "type": "range", "id": "bg_tint", "label": "Tint over the image", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 30, "info": "Light tint behind a dark heading, dark tint behind a white one. 0 turns it off." },
    {
      "type": "select", "id": "text_tone", "label": "Heading color", "default": "dark",
      "options": [
        { "value": "dark", "label": "Dark (for light backgrounds)" },
        { "value": "light", "label": "White (for dark backgrounds)" }
      ]
    }
  ],
  "presets": [{ "name": "Blog Highlights" }]
}
{% endschema %}

<style>
  .pk-bl { position: relative; background: var(--bl-bg, #fff); padding: 3.5rem 0; }
  .pk-bl__inner { position: relative; z-index: 1; max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
  .pk-bl__top { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 0.75rem 1.5rem; margin-bottom: 1.75rem; }
  .pk-bl__eyebrow { margin: 0 0 0.5rem; font-size: var(--pk-fs-label); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--pk-text-brand); }
  .pk-bl__heading { margin: 0; font-size: var(--pk-fs-heading); font-weight: 800; line-height: 1.15; letter-spacing: -0.01em; color: var(--pk-text-primary); }
  .pk-bl__all { font-size: var(--pk-fs-body); font-weight: 600; color: var(--pk-text-primary); text-decoration: none; white-space: nowrap; }
  .pk-bl__all:hover { color: var(--pk-text-brand); }
  .pk-bl--light .pk-bl__heading, .pk-bl--light .pk-bl__all, .pk-bl--light .pk-bl__all:hover { color: #fff; }
  .pk-bl--light .pk-bl__all:hover { text-decoration: underline; text-underline-offset: 3px; }
  .pk-bl--light .pk-bl__eyebrow { color: #e9d5ff; }

  .pk-bl__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  /* The card is a positioning box so the title link can cover all of it. */
  .pk-bl__card { position: relative; display: flex; flex-direction: column; min-width: 0; overflow: hidden; background: #fff; border: 1px solid #e5e7eb; border-radius: var(--pk-radius-lg); transition: border-color 0.15s ease, box-shadow 0.15s ease; }
  .pk-bl__card:hover { border-color: #d8b4fe; box-shadow: 0 18px 32px -24px rgba(88, 28, 135, 0.5); }
  .pk-bl__media { display: block; aspect-ratio: 16 / 10; overflow: hidden; background: #f3e8ff; }
  .pk-bl__media img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease; }
  .pk-bl__card:hover .pk-bl__media img { transform: scale(1.04); }
  .pk-bl__body { display: flex; flex-direction: column; flex: 1; padding: 1.1rem 1.25rem 1.3rem; }
  .pk-bl__date { margin: 0 0 0.45rem; font-size: var(--pk-fs-tiny); font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--pk-text-muted); }
  .pk-bl__title { margin: 0; font-size: 1.1rem; font-weight: 700; line-height: 1.35; color: var(--pk-text-primary); display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; line-clamp: 3; overflow: hidden; }
  .pk-bl__title a { color: inherit; text-decoration: none; }
  .pk-bl__title a::after { content: ""; position: absolute; inset: 0; }
  .pk-bl__title a:focus-visible { outline: none; }
  .pk-bl__card:focus-within { outline: 2px solid var(--pk-btn-primary-bg); outline-offset: 2px; }
  .pk-bl__card:hover .pk-bl__title { color: var(--pk-text-brand); }
  .pk-bl__excerpt { margin: 0.55rem 0 0; font-size: var(--pk-fs-label); line-height: 1.55; color: var(--pk-text-secondary); display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; line-clamp: 3; overflow: hidden; }
  .pk-bl__read { margin: auto 0 0; padding-top: 0.9rem; font-size: var(--pk-fs-label); font-weight: 700; color: var(--pk-text-brand); }

  @media (max-width: 999px) {
    .pk-bl__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 749px) {
    .pk-bl { padding: 2.5rem 0; }
    .pk-bl__heading { font-size: var(--pk-fs-heading-sm); }
    .pk-bl__top { margin-bottom: 1.25rem; }
    .pk-bl__all { font-size: var(--pk-fs-label); }
    /* Swipe: one row, most of a card in view and the next one peeking in. */
    .pk-bl--swipe .pk-bl__grid { display: flex; gap: 0.85rem; margin: 0 -1.5rem; padding: 0 1.5rem 0.5rem; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scroll-padding: 0 1.5rem; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
    .pk-bl--swipe .pk-bl__grid::-webkit-scrollbar { display: none; }
    .pk-bl--swipe .pk-bl__card { flex: 0 0 80%; max-width: 20rem; scroll-snap-align: start; }
    .pk-bl--stack .pk-bl__grid { grid-template-columns: 1fr; gap: 1rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pk-bl__card, .pk-bl__media img { transition: none; }
  }
</style>

{%- liquid
  assign bl_blog = section.settings.blog
  assign bl_limit = section.settings.post_limit | default: 3
-%}

{%- if bl_blog != blank and bl_blog.articles_count > 0 -%}
<section class="pk-bl pk-bl--{{ section.settings.mobile_layout | default: 'swipe' }}{% if section.settings.text_tone == 'light' %} pk-bl--light{% endif %}" style="--bl-bg: {{ section.settings.background | default: '#ffffff' }};">
  {%- render 'pk-section-bg', image: section.settings.bg_image, image_mobile: section.settings.bg_image_mobile, tint: section.settings.bg_tint, tone: section.settings.text_tone -%}
  <div class="pk-bl__inner">
    <div class="pk-bl__top">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="pk-bl__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="pk-bl__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a class="pk-bl__all" href="{{ bl_blog.url }}">{{ section.settings.link_label }} &rarr;</a>
      {%- endif -%}
    </div>

    <ul class="pk-bl__grid">
      {%- for article in bl_blog.articles limit: bl_limit -%}
        <li class="pk-bl__card">
          <span class="pk-bl__media">
            {%- if article.image -%}
              <img
                src="{{ article.image | image_url: width: 720 }}"
                srcset="{{ article.image | image_url: width: 480 }} 480w, {{ article.image | image_url: width: 720 }} 720w, {{ article.image | image_url: width: 1080 }} 1080w"
                sizes="(max-width: 749px) 80vw, (max-width: 999px) 46vw, 370px"
                width="720"
                height="450"
                alt="{{ article.image.alt | escape }}"
                loading="lazy"
              >
            {%- endif -%}
          </span>
          <div class="pk-bl__body">
            {%- if section.settings.show_date -%}
              <p class="pk-bl__date"><time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %-d, %Y' }}</time></p>
            {%- endif -%}
            <h3 class="pk-bl__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
            {%- if section.settings.show_excerpt -%}
              <p class="pk-bl__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 30 }}</p>
            {%- endif -%}
            {%- if section.settings.read_label != blank -%}
              <span class="pk-bl__read" aria-hidden="true">{{ section.settings.read_label }} &rarr;</span>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- elsif request.design_mode -%}
  <div style="max-width: 1200px; margin: 0 auto; padding: 2rem 1.5rem; color: #6b7280;">Blog Highlights: pick a blog with at least one post in this section's settings.</div>
{%- endif -%}
