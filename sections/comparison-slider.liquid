{% schema %}
{
  "name": "Comp Slider PK",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You Upload Your Design, We Turn it into an Embroidered Patch"
    },
    {
      "type": "header",
      "content": "Before Image (Left)"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before Image"
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Before Label",
      "default": "Your Design as a Digital Proof"
    },
    {
      "type": "header",
      "content": "After Image (Right)"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After Image"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "After Label",
      "default": "Your Design as a Embroidered Patch"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "initial_position",
      "label": "Initial Slider Position",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f3f4f6"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label Background Color",
      "default": "#10b981"
    }
  ],
  "presets": [
    {
      "name": "Comp Slider PK"
    }
  ]
}
{% endschema %}

{%- assign uid = section.id -%}

<div class="pk-comp-slider-wrap-{{ uid }}" style="background-color: {{ section.settings.background_color | default: '#f3f4f6' }}; padding: 4rem 1rem;">
  <div class="page-width" style="max-width: 1280px; margin: 0 auto;">
    {%- if section.settings.heading != blank -%}
      <h2 style="font-size: 1.875rem; font-weight: 700; text-align: center; color: #111827; margin-bottom: 2.5rem;">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    <div style="max-width: 56rem; margin: 0 auto;">
      <div class="comparison-container" id="comparisonContainer-{{ uid }}" data-initial="{{ section.settings.initial_position | default: 50 }}">

        <!-- Left Image (Before / Digital Proof) -->
        <div class="img-wrapper detail-proof">
          {%- if section.settings.before_image != blank -%}
            {{ section.settings.before_image | image_url: width: 1600 | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1200, 1600',
              sizes: '(min-width: 1024px) 56rem, 100vw',
              alt: section.settings.before_label,
              class: 'pk-comp-img'
            }}
          {%- else -%}
            <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; background:white; color:#9ca3af;">Before Image</div>
          {%- endif -%}
        </div>

        <!-- Right Image (After / Embroidered Patch) - Clipped -->
        <div class="img-wrapper embroidered-patch" id="overlayImage-{{ uid }}">
          {%- if section.settings.after_image != blank -%}
            {{ section.settings.after_image | image_url: width: 1600 | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1200, 1600',
              sizes: '(min-width: 1024px) 56rem, 100vw',
              alt: section.settings.after_label,
              class: 'pk-comp-img'
            }}
          {%- else -%}
            <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; background:#e5e7eb; color:#1f2937;">After Image</div>
          {%- endif -%}
        </div>

        <!-- Slider Handle -->
        <div class="slider-handle" id="sliderHandle-{{ uid }}">
          <div class="handle-circle">
            <svg style="width:16px;height:16px;fill:currentColor" viewBox="0 0 24 24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
            <svg style="width:16px;height:16px;fill:currentColor" viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
          </div>
        </div>

        <!-- Labels -->
        {%- if section.settings.before_label != blank -%}
          <div class="label-badge label-left" style="background-color: {{ section.settings.label_color | default: '#10b981' }};">{{ section.settings.before_label }}</div>
        {%- endif -%}
        {%- if section.settings.after_label != blank -%}
          <div class="label-badge label-right" style="background-color: {{ section.settings.label_color | default: '#10b981' }};">{{ section.settings.after_label }}</div>
        {%- endif -%}

      </div>
    </div>
  </div>
</div>

<style>
  #comparisonContainer-{{ uid }} {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: #e5e7eb;
    border-radius: 1rem;
    overflow: hidden;
    cursor: col-resize;
    user-select: none;
  }
  #comparisonContainer-{{ uid }} .img-wrapper {
    position: absolute;
    top: 0; left: 0; bottom: 0; right: 0;
    overflow: hidden;
  }
  #comparisonContainer-{{ uid }} .pk-comp-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #comparisonContainer-{{ uid }} .slider-handle {
    position: absolute;
    top: 0; bottom: 0;
    width: 2px;
    background-color: #1f2937;
    left: {{ section.settings.initial_position | default: 50 }}%;
    z-index: 10;
    transform: translateX(-1px);
  }
  #comparisonContainer-{{ uid }} .handle-circle {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 2.5rem; height: 2.5rem;
    background-color: #fff;
    border-radius: 50%;
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
    display: flex; align-items: center; justify-content: center;
    color: #4b5563;
  }
  #comparisonContainer-{{ uid }} #overlayImage-{{ uid }} {
    clip-path: inset(0 0 0 {{ section.settings.initial_position | default: 50 }}%);
  }
  #comparisonContainer-{{ uid }} .label-badge {
    position: absolute;
    top: 1.5rem;
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    z-index: 20;
    pointer-events: none;
  }
  #comparisonContainer-{{ uid }} .label-left { left: 5%; }
  #comparisonContainer-{{ uid }} .label-right { right: 5%; }
</style>

<script>
  (function() {
    const container = document.getElementById('comparisonContainer-{{ uid }}');
    const overlay = document.getElementById('overlayImage-{{ uid }}');
    const handle = document.getElementById('sliderHandle-{{ uid }}');
    if (!container || !overlay || !handle) return;
    let isDragging = false;

    function updateSlider(x) {
      const rect = container.getBoundingClientRect();
      let pos = ((x - rect.left) / rect.width) * 100;
      pos = Math.max(0, Math.min(100, pos));

      overlay.style.clipPath = `inset(0 0 0 ${pos}%)`;
      handle.style.left = `${pos}%`;
    }

    container.addEventListener('mousedown', (e) => { isDragging = true; updateSlider(e.clientX); });
    window.addEventListener('mouseup', () => isDragging = false);
    window.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      updateSlider(e.clientX);
    });

    // Touch support
    container.addEventListener('touchstart', (e) => { isDragging = true; updateSlider(e.touches[0].clientX); }, { passive: true });
    window.addEventListener('touchend', () => isDragging = false);
    window.addEventListener('touchmove', (e) => {
      if (!isDragging) return;
      updateSlider(e.touches[0].clientX);
    }, { passive: true });
  })();
</script>
