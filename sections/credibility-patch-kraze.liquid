{% schema %}
{
  "name": "Credibility (Patch Kraze)",
  "class": "section-credibility-patch-kraze",
  "settings": [],
  "presets": [
    {
      "name": "Credibility (Patch Kraze)"
    }
  ]
}
{% endschema %}

<style>
  .credibility-section {
    width: 100%;
    background-color: #fff;
    padding: 2.5rem 0 5rem;
  }
  .credibility-container {
    max-width: 1152px;
    margin: 0 auto;
    padding: 0 1rem;
  }
  
  /* Brand Logos: infinite marquee */
  .credibility-logos-marquee {
    overflow: hidden;
    margin-bottom: 4rem;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }
  .credibility-logos {
    display: flex;
    width: max-content;
    animation: credibility-scroll 40s linear infinite;
  }
  .credibility-logos__set {
    display: flex;
    align-items: center;
    gap: 3rem;
    padding-right: 3rem; /* keeps gap even at the loop seam */
  }
  .credibility-logos-marquee:hover .credibility-logos { animation-play-state: paused; }
  @keyframes credibility-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  /* Each brand is a monochrome lockup: mark (Simple Icons SVG from
     assets/brand-*.svg) + name. Brands with no available mark render the
     name alone in the same style. One shared opacity keeps every logo the
     same gray (~4.7:1 on white) and the hover still brings it to full ink. */
  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    opacity: 0.55;
    transition: opacity 0.3s ease;
  }
  .brand-logo:hover { opacity: 1; }
  .brand-logo__mark { height: 1.75rem; width: 1.75rem; display: block; }
  .brand-logo__name {
    font-size: var(--pk-fs-subheading);
    font-weight: 700;
    color: var(--pk-text-primary);
    white-space: nowrap;
    letter-spacing: -0.01em;
  }
  @media (max-width: 640px) {
    .credibility-logos__set { gap: 2rem; padding-right: 2rem; }
    .brand-logo { height: 2rem; gap: 0.4rem; }
    .brand-logo__mark { height: 1.5rem; width: 1.5rem; }
    .brand-logo__name { font-size: var(--pk-fs-body); }
  }
  @media (prefers-reduced-motion: reduce) {
    .credibility-logos { animation: none; width: auto; justify-content: center; }
    .credibility-logos__set { flex-wrap: wrap; justify-content: center; row-gap: 1rem; padding-right: 0; }
    .credibility-logos__set[aria-hidden="true"] { display: none; }
  }

  /* Headline */
  .credibility-header {
    text-align: center;
    margin-bottom: 4rem;
  }
  .credibility-title {
    font-size: var(--pk-fs-heading);
    font-weight: 700;
    color: var(--pk-text-primary);
    margin-bottom: 1rem;
    line-height: 1.2;
  }
  .credibility-subtitle {
    font-size: var(--pk-fs-subheading);
    color: var(--pk-text-secondary);
    max-width: 48rem;
    margin: 0 auto;
  }

  /* Features */
  .credibility-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .credibility-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .credibility-feature {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .feature-icon {
    font-size: 3rem; /* 5xl */
    margin-bottom: 1.5rem;
  }
  .feature-title {
    font-size: var(--pk-fs-heading-sm);
    font-weight: 700;
    color: var(--pk-text-primary);
    margin-bottom: 0.75rem;
  }
  .feature-desc {
    color: var(--pk-text-secondary);
    font-size: var(--pk-fs-label);
    line-height: 1.625;
  }
</style>

<div class="credibility-section">
  <div class="credibility-container">
    
    <!-- Brand Logos: infinite marquee (logo set rendered twice for a seamless loop) -->
    {%- comment -%}
      handle:Name pairs. A handle with a matching assets/brand-<handle>.svg
      gets its mark; amazon/pepsi/linkedin have no mark available (removed
      from Simple Icons at the brands' request), so they show the name only.
    {%- endcomment -%}
    {%- assign brand_list = 'apple:Apple|google:Google|amazon:Amazon|nike:Nike|pepsi:Pepsi|spotify:Spotify|tesla:Tesla|north-face:The North Face|linkedin:LinkedIn|mcdonalds:McDonald’s|honda:Honda|kfc:KFC|shopify:Shopify|adidas:Adidas|tiktok:TikTok|youtube:YouTube' | split: '|' -%}
    {%- assign no_mark = 'amazon,pepsi,linkedin' | split: ',' -%}
    {%- capture brand_logos -%}
      {%- for pair in brand_list -%}
        {%- assign parts = pair | split: ':' -%}
        <span class="brand-logo" role="listitem">
          {%- unless no_mark contains parts[0] -%}
            <img class="brand-logo__mark" src="{{ 'brand-' | append: parts[0] | append: '.svg' | asset_url }}" alt="" width="28" height="28" decoding="async">
          {%- endunless -%}
          <span class="brand-logo__name">{{ parts[1] }}</span>
        </span>
      {%- endfor -%}
    {%- endcapture -%}
    <div class="credibility-logos-marquee">
      <div class="credibility-logos">
        <div class="credibility-logos__set" role="list" aria-label="Brands that trust Patch Kraze">{{ brand_logos }}</div>
        <div class="credibility-logos__set" aria-hidden="true">{{ brand_logos }}</div>
      </div>
    </div>

    <!-- Headline and Subtitle -->
    <div class="credibility-header">
      <h2 class="credibility-title">
        #1 Site In The USA To Order Personalized Embroidery Patches
      </h2>
      <p class="credibility-subtitle">
        Out of so many reasons, let's focus on the top three ones why we are the best team to customize embroidered patches for you.
      </p>
    </div>

    <!-- Features Grid -->
    <div class="credibility-grid">
      
      <!-- Feature 1 -->
      <div class="credibility-feature">
        <div class="feature-icon">⭐</div>
        <h3 class="feature-title">High-Quality Materials</h3>
        <p class="feature-desc">We use premium threads and durable fabrics to ensure long-lasting emblems that withstand wear and tear.</p>
      </div>

      <!-- Feature 2 -->
      <div class="credibility-feature">
        <div class="feature-icon">💡</div>
        <h3 class="feature-title">All Shapes & Sizes</h3>
        <p class="feature-desc">From classic circles and squares to unique shapes, we can create crests in virtually any size to match your vision.</p>
      </div>

      <!-- Feature 3 -->
      <div class="credibility-feature">
        <div class="feature-icon">%</div>
        <h3 class="feature-title">Cost-Effective Prices</h3>
        <p class="feature-desc">You can order our cool Velcro patches at your desired rates. Yes, our prices will never fall out of your budget.</p>
      </div>

    </div>
  </div>
</div>
