<style>
  .site-footer {
    background-color: #000;
    color: #fff;
    font-size: 0.875rem; /* text-sm */
  }
  .footer-container {
    max-width: 1280px; /* container */
    margin: 0 auto;
    padding: 4rem 1rem; /* py-16 px-4 */
  }
  
  .footer-row-1 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    margin-bottom: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid #1f2937; /* gray-800 */
  }
  @media (min-width: 768px) {
    .footer-row-1 { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .footer-row-1 { grid-template-columns: repeat(4, 1fr); }
  }

  .footer-col-title {
    font-weight: 700;
    color: #fff;
    margin-bottom: 1rem;
    font-size: 0.875rem;
  }
  
  .footer-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .footer-nav-item {
    margin-bottom: 0.5rem;
  }
  .footer-nav-link {
    color: #9ca3af; /* gray-400 */
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-nav-link:hover {
    color: #22c55e; /* primary/green */
  }

  .footer-contact-block {
    margin-bottom: 1rem;
    color: #9ca3af;
  }
  .contact-title {
    font-weight: 600;
    color: #fff;
    margin-bottom: 0.25rem;
    display: block;
  }

  .footer-row-2 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (min-width: 768px) {
    .footer-row-2 { grid-template-columns: repeat(3, 1fr); }
  }

  .footer-bottom {
    border-top: 1px solid #1f2937;
    background-color: #000;
    color: #9ca3af;
  }
  .footer-bottom-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .footer-bottom-container { flex-direction: row; }
  }

</style>

