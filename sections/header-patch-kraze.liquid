  {% assign bumper_stickers = all_products['holographic-stickers'] %}
  {% assign uv_stickers = all_products['uv-transparent-stickers'] %}
  {% assign dtf_transfers = all_products['dtf-transfers'] %}
  {% assign full_color_printed = all_products['full-color-printed-patches'] %}
  {% assign ready_made_collection = collections['ready-made-patches'] %}
  
  const MEGA_MENUS = {
