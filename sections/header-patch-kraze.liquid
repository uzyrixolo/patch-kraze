{% schema %}
{
  "name": "Header Patch Kraze",
  "class": "section-header",
  "settings": [
    { "type": "header", "content": "Announcement strip" },
    { "type": "text", "id": "announcement", "label": "Announcement (desktop)", "default": "Rush production in as little as 5 business days • 10 piece order minimum • Free shipping on orders over $100" },
    { "type": "text", "id": "announcement_mobile", "label": "Announcement (mobile)", "default": "Free shipping over $100 • 10 piece minimum", "info": "Shorter line for phones. Leave empty to reuse the desktop text." },
    { "type": "header", "content": "Contact" },
    { "type": "text", "id": "contact_phone", "label": "Phone number", "default": "909-931-6231", "info": "Shown in the strip above the header and in the mobile menu; used for the tap-to-call link." },
    { "type": "text", "id": "contact_label", "label": "Text before the phone number", "default": "Questions? Call" },
    { "type": "header", "content": "Links" },
    { "type": "url", "id": "url_readymade", "label": "Ready-made patches link", "info": "Defaults to /collections/ready-made-patches." },
    { "type": "url", "id": "url_blanks", "label": "Blank hats link", "info": "Defaults to /collections/patch-kraze-blanks." },
    { "type": "url", "id": "url_quote", "label": "Quote button link", "info": "Defaults to /pages/quote." },
    { "type": "header", "content": "Colors and background" },
    { "type": "color_background", "id": "bar_bg", "label": "Header background (color or gradient)", "default": "#ffffff", "info": "The bar holding the logo and menu." },
    { "type": "image_picker", "id": "bar_image", "label": "Header background image", "info": "Optional. Fills the bar behind the logo and menu and is cropped to fit, so use a wide, short image: about 2400 x 200 px." },
    { "type": "range", "id": "bar_tint", "label": "Tint over the image", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 40, "info": "Keeps the menu readable on a busy picture. Dark tint behind white text, light tint behind dark text. 0 turns it off." },
    {
      "type": "select", "id": "bar_text", "label": "Header text and icons", "default": "dark",
      "options": [
        { "value": "dark", "label": "Dark (for light backgrounds)" },
        { "value": "light", "label": "White (for dark backgrounds)" }
      ]
    },
    { "type": "color_background", "id": "strip_bg", "label": "Announcement strip background", "default": "#f5f3ff" },
    { "type": "color", "id": "strip_text", "label": "Announcement strip text", "default": "#4c1d95" }
  ],
  "blocks": [
    {
      "type": "menu_product",
      "name": "Menu product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product", "info": "The link goes to this product and shows its main photo." },
        { "type": "text", "id": "backup_handle", "label": "Backup product handle", "info": "Used when the product above is not available. The last part of the product's address, for example custom-embroidered-patches." },
        { "type": "text", "id": "label", "label": "Label", "info": "Leave empty to use the product title." },
        {
          "type": "select", "id": "group", "label": "Menu group", "default": "stitched",
          "options": [
            { "value": "stitched", "label": "Patches: Embroidered & woven" },
            { "value": "printed", "label": "Patches: Printed & flex" },
            { "value": "molded", "label": "Patches: PVC, rubber & silicone" },
            { "value": "leather", "label": "Patches: Leather" },
            { "value": "stickers", "label": "Stickers" }
          ]
        }
      ]
    }
  ],
  "max_blocks": 40
}
{% endschema %}

{% comment %}
  Two rows: a slim announcement/utility strip, then one bar holding the logo,
  the menu and the search/account/cart tools. Product types live in grouped
  text panels under "Patches", "Stickers" and "Services"; phones get the same
  groups in a slide-in drawer. All menu markup is static HTML (real links), so
  it survives the cart's section re-renders without being rebuilt by script.

  Product links are "Menu product" blocks (product + label + group), so each
  link can show the product's own photo as a thumbnail; snippets/pk-menu-links
  renders a group for the desktop panel and again for the drawer. The "Label|/url"
  lists below are the fallback used when a group has no blocks, and the source
  for the Services links (pages, with a Files image name as a third part).
  Labels must not contain a comma or a pipe.

  Colors: the bar's background (color or gradient, optional image, tint over
  the image), whether its text and icons are dark or white, and the strip's
  background and text color are all section settings ("Colors and background").
{% endcomment %}

{%- liquid
  assign pk_phone = section.settings.contact_phone | default: '909-931-6231'
  assign pk_tel = pk_phone | remove: '-' | remove: ' ' | remove: '(' | remove: ')' | remove: '.'
  assign pk_url_readymade = section.settings.url_readymade | default: '/collections/ready-made-patches'
  assign pk_url_blanks = section.settings.url_blanks | default: '/collections/patch-kraze-blanks'
  assign pk_url_quote = section.settings.url_quote | default: '/pages/quote'
  assign pk_announcement_mobile = section.settings.announcement_mobile | default: section.settings.announcement
  assign pk_logo = 'https://cdn.shopify.com/s/files/1/0661/2965/7940/files/Patch_Kraze_Logo_horizontal_low_9ea09d1a-6c9e-4f1b-8b6a-58cbadcfdf50.png?v=1787003036'

  assign pk_grp_stitched = 'Embroidered|/products/embroidered-patches,3D embroidered|/products/3d-embroidered-patches,Name patches|/products/name-patches,Chenille|/products/chenille-patches,Tackle twill letters|/products/tackle-twill-letters,Woven|/products/woven-patches,Glow-in-the-dark embroidered|/products/glow-in-the-dark-embroidery-patches' | split: ','
  assign pk_grp_printed = 'Full color printed|/products/full-color-printed-patches,Full color flex|/products/full-color-flex-patches,Gold flex|/products/gold-flex-patches,Silver flex|/products/silver-flex-patches,TPU UV 3D|/products/pu-uv-3d-patches' | split: ','
  assign pk_grp_molded = 'PVC rubber|/products/pvc-rubber-patches,3D PVC|/products/3d-pvc-patches,Glow-in-the-dark PVC|/products/glow-in-the-dark-pvc-rubber-patches,Silicone|/products/silicone-patches,PVC keychains|/products/custom-keychains' | split: ','
  assign pk_grp_leather = 'Genuine leather|/products/leather-patches,Faux leather|/products/faux-leather-patches' | split: ','
  assign pk_grp_stickers = 'Vinyl stickers|/products/custom-vinyl-stickers,Holographic stickers|/products/holographic-stickers,UV transparent stickers|/products/uv-transparent-stickers' | split: ','
  assign pk_grp_services = 'Direct embroidery|/pages/direct-embroidery|services_4.webp,Screen printing|/pages/screen-printing|services_5.webp,Heat press service|/pages/heat-press-service|services_1.webp,Tees with DTF prints|/pages/tees-with-dtf-prints|services_2.webp' | split: ','
-%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

  .pk-header * { box-sizing: border-box; }
  /* position:fixed instead of sticky - sticky silently fails to pin here
     because Shopify's base theme sets `overflow-y: auto` directly on <html>,
     a known engine quirk where sticky elements don't stick to that specific
     scrolling box. Fixed sidesteps it; the script at the bottom reserves the
     equivalent space so page content doesn't slide under the header. */
  .pk-header { position: fixed; top: 0; left: 0; right: 0; width: 100%; z-index: 1100; background: #fff; font-family: 'Inter', sans-serif !important; line-height: 1.5; color: #111827; }
  .pk-wrap { max-width: 1440px; margin: 0 auto; padding: 0 1.25rem; }

  /* ANNOUNCEMENT / UTILITY STRIP - drops away once the page is scrolled */
  .pk-strip { background: var(--pk-strip-bg, #f5f3ff); border-bottom: 1px solid rgba(17, 24, 39, 0.06); color: var(--pk-strip-fg, #4c1d95); font-size: 0.78rem; }
  .pk-strip__row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 2.25rem; }
  .pk-strip__msg { margin: 0; font-weight: 500; }
  .pk-strip__msg--mobile { display: none; }
  .pk-strip__links { display: flex; align-items: center; gap: 1.25rem; white-space: nowrap; }
  .pk-strip__links a { color: inherit; text-decoration: none; font-weight: 600; }
  .pk-strip__links a:hover { text-decoration: underline; }
  .pk-strip__phone { display: inline-flex; align-items: center; gap: 0.35rem; font-weight: 500 !important; }
  .pk-strip__phone strong { font-weight: 700; }
  .pk-strip__phone svg { width: 0.85rem; height: 0.85rem; }
  .pk-header--scrolled .pk-strip { display: none; }
  /* Below 1200px the long announcement would wrap next to the links, so the
     short line is used from there down. */
  @media (max-width: 1199px) {
    .pk-strip__msg--desktop { display: none; }
    .pk-strip__msg--mobile { display: block; }
  }

  /* MAIN BAR. Its background is set in the theme editor (Header > Colors and
     background): a color or gradient, an optional image over it, and a tint
     over the image. The three are stacked as background layers. */
  .pk-bar { background: linear-gradient(var(--pk-bar-tint, transparent), var(--pk-bar-tint, transparent)), var(--pk-bar-img, none) center / cover no-repeat, var(--pk-bar-bg, #fff); border-bottom: 1px solid #e5e7eb; }
  /* White text and icons, for a dark bar. Scoped to the bar so the drop-down
     panels, the drawer and the search box keep their own dark-on-white. */
  .pk-header--light .pk-bar { --pk-btn-icon-fg: #fff; --pk-btn-icon-bg-hover: rgba(255, 255, 255, 0.16); border-bottom-color: rgba(255, 255, 255, 0.16); }
  .pk-header--light .pk-bar .pk-menu__link { color: #fff; }
  .pk-header--light .pk-bar .pk-menu__link::after { background: #fff; }
  .pk-header--light .pk-bar .pk-menu__link:focus-visible { outline-color: #fff; }
  .pk-header--light .pk-bar .pk-quote-btn { background: #fff; color: #111827; }
  .pk-header--light .pk-bar .pk-quote-btn:hover { background: #f3f4f6; }
  .pk-bar__row { position: relative; display: flex; align-items: stretch; gap: 1.5rem; min-height: 4.25rem; }
  .pk-bar__logo { display: flex; align-items: center; flex-shrink: 0; }
  .pk-bar__logo img { height: 2.75rem; width: auto; display: block; object-fit: contain; }

  .pk-menu { display: flex; align-items: stretch; gap: 0.15rem; }
  .pk-menu__item { display: flex; align-items: stretch; }
  .pk-menu__item--compact { position: relative; }
  .pk-menu__link {
    position: relative; display: inline-flex; align-items: center; gap: 0.3rem; padding: 0 0.85rem;
    background: none; border: none; cursor: pointer; font: inherit; font-size: 0.95rem; font-weight: 600;
    color: #111827; text-decoration: none; white-space: nowrap;
  }
  .pk-menu__link::after {
    content: ""; position: absolute; left: 0.85rem; right: 0.85rem; bottom: 0; height: 3px;
    background: #9333ea; border-radius: 3px 3px 0 0; transform: scaleX(0); transition: transform 0.15s ease;
  }
  .pk-menu__item:hover > .pk-menu__link::after,
  .pk-menu__item[data-open] > .pk-menu__link::after { transform: scaleX(1); }
  .pk-menu__link:focus-visible { outline: 2px solid #9333ea; outline-offset: -3px; border-radius: 0.4rem; }
  .pk-menu__chev { display: inline-flex; width: 0.8rem; height: 0.8rem; transition: transform 0.15s ease; }
  .pk-menu__chev svg, .pk-drawer__chev svg { display: block; width: 100%; height: 100%; }
  .pk-menu__item[data-open] .pk-menu__chev { transform: rotate(180deg); }

  /* DROPDOWN PANELS - text links in named groups */
  .pk-panel {
    position: absolute; top: 100%; left: 0; z-index: 50; background: #fff;
    border: 1px solid #e5e7eb; border-top: none; border-radius: 0 0 1rem 1rem;
    box-shadow: 0 24px 40px -12px rgba(17, 24, 39, 0.18); padding: 1.5rem;
    opacity: 0; visibility: hidden; transform: translateY(-4px);
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0s linear 0.15s;
  }
  .pk-panel--wide { right: 0; display: grid; grid-template-columns: repeat(var(--pk-cols, 4), minmax(0, 1fr)) minmax(0, 1.15fr); gap: 2rem; }
  .pk-panel--list { min-width: 17rem; padding: 0.9rem 1rem; }
  @media (hover: hover) {
    .pk-menu__item:hover > .pk-panel { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
  }
  .pk-menu__item[data-open] > .pk-panel { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
  .pk-panel__head { margin: 0 0 0.6rem; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #7e22ce; }
  .pk-panel__links { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.1rem; }
  .pk-panel__links a { display: flex; align-items: center; gap: 0.65rem; margin: 0 -0.6rem; padding: 0.35rem 0.6rem; border-radius: 0.5rem; color: #111827; text-decoration: none; font-size: 0.92rem; font-weight: 500; line-height: 1.25; }
  .pk-thumb { flex-shrink: 0; display: block; width: 2.5rem; height: 2.5rem; border-radius: 0.5rem; object-fit: cover; background: #f3f4f6; box-shadow: 0 0 0 1px rgba(17, 24, 39, 0.08); }
  .pk-panel__links a:hover, .pk-panel__links a:focus-visible { background: #f5f3ff; color: #6b21a8; outline: none; }
  .pk-panel__aside { align-self: start; display: flex; flex-direction: column; gap: 0.6rem; background: #111827; color: #fff; border-radius: 0.9rem; padding: 1.25rem; }
  .pk-panel__aside-title { margin: 0; font-size: 1rem; font-weight: 700; line-height: 1.3; }
  .pk-panel__aside-text { margin: 0; font-size: 0.85rem; line-height: 1.5; color: #d1d5db; }
  .pk-panel__aside-btn { align-self: flex-start; margin-top: 0.25rem; display: inline-flex; align-items: center; height: 2.4rem; padding: 0 1rem; border-radius: 0.6rem; font-size: 0.85rem; font-weight: 700; text-decoration: none; }

  /* TOOLS: search, account, cart, quote button, menu button */
  .pk-tools { display: flex; align-items: center; gap: 0.25rem; flex-shrink: 0; margin-left: auto; }
  .pk-tool { position: relative; width: 2.5rem; height: 2.5rem; display: inline-flex; align-items: center; justify-content: center; border-radius: 0.6rem; padding: 0; text-decoration: none; }
  /* Icons are the base theme's own files (assets/icon-*.svg). Search, account
     and cart are drawn on a 20-unit grid, menu and close on a 14-unit one, so
     the two sets take different sizes to end up with the same line weight. */
  .pk-tool .svg-wrapper, .pk-tool .svg-wrapper > svg { width: 1.6rem; height: 1.6rem; }
  .pk-tool--menu .svg-wrapper, .pk-tool--menu .svg-wrapper > svg,
  .pk-tool--close .svg-wrapper, .pk-tool--close .svg-wrapper > svg { width: 1.15rem; height: 1.15rem; }
  .pk-tool cart-icon { display: block; position: relative; }
  .pk-tool .cart-bubble { position: absolute; top: -8px; right: -8px; }
  .pk-tool .cart-bubble__background { background-color: #9333ea !important; }
  .pk-tool--menu { display: none; }
  .pk-quote-btn { display: inline-flex; align-items: center; justify-content: center; height: 2.5rem; padding: 0 1.1rem; margin-left: 0.5rem; border-radius: 0.6rem; font-size: 0.9rem; font-weight: 700; text-decoration: none; white-space: nowrap; }

  /* PHONES AND TABLETS */
  @media (max-width: 1023px) {
    .pk-wrap { padding: 0 0.9rem; }
    .pk-strip { font-size: 0.72rem; }
    .pk-strip__row { justify-content: center; text-align: center; min-height: 1.9rem; padding-top: 0.25rem; padding-bottom: 0.25rem; }
    .pk-strip__links { display: none; }
    .pk-bar__row { min-height: 3.5rem; gap: 0.5rem; }
    .pk-bar__logo img { height: 2.25rem; }
    .pk-menu, .pk-tool--account, .pk-bar .pk-quote-btn { display: none; }
    .pk-tool--menu { display: inline-flex; }
  }

  /* SLIDE-IN MENU (phones and tablets) */
  .pk-overlay { position: fixed; inset: 0; background: rgba(17, 24, 39, 0.5); z-index: 55; display: none; }
  .pk-overlay.open { display: block; }
  .pk-drawer {
    position: fixed; top: 0; right: 0; height: 100%; width: 88%; max-width: 22rem; background: #fff; z-index: 60;
    display: flex; flex-direction: column; transform: translateX(100%); visibility: hidden;
    transition: transform 0.28s ease, visibility 0s linear 0.28s;
  }
  .pk-drawer.open { transform: translateX(0); visibility: visible; transition-delay: 0s; }
  .pk-drawer__head { display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 0.75rem 0.75rem 1.1rem; border-bottom: 1px solid #e5e7eb; }
  .pk-drawer__title { font-size: 1rem; font-weight: 700; }
  .pk-drawer__body { flex: 1; overflow-y: auto; -webkit-overflow-scrolling: touch; }
  .pk-drawer__group > summary,
  .pk-drawer__link { display: flex; align-items: center; justify-content: space-between; padding: 0.95rem 1.1rem; border-bottom: 1px solid #f3f4f6; font-size: 1rem; font-weight: 700; color: #111827; text-decoration: none; cursor: pointer; }
  .pk-drawer__group > summary { list-style: none; }
  .pk-drawer__group > summary::-webkit-details-marker { display: none; }
  .pk-drawer__chev { display: inline-flex; width: 0.9rem; height: 0.9rem; transition: transform 0.15s ease; }
  .pk-drawer__group[open] > summary .pk-drawer__chev { transform: rotate(180deg); }
  .pk-drawer__sub { background: #faf5ff; padding: 0.5rem 1.1rem 0.9rem; border-bottom: 1px solid #f3f4f6; }
  .pk-drawer__label { margin: 0.75rem 0 0.25rem; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #7e22ce; }
  .pk-drawer__sub a { display: flex; align-items: center; gap: 0.7rem; padding: 0.4rem 0; color: #1f2937; text-decoration: none; font-size: 0.95rem; }
  /* Bottom padding keeps the footer clear of the chat bubble, which is pinned
     to the bottom-right corner above everything else on the page. */
  .pk-drawer__foot { padding: 1rem 1.1rem 5rem; border-top: 1px solid #e5e7eb; display: grid; gap: 0.75rem; }
  .pk-drawer__foot .pk-quote-btn { margin-left: 0; height: 2.75rem; }
  .pk-drawer__foot-links { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.9rem; }
  .pk-drawer__foot-links a { color: #374151; text-decoration: none; font-weight: 600; }

  @media (prefers-reduced-motion: reduce) {
    .pk-panel, .pk-drawer, .pk-menu__link::after, .pk-menu__chev, .pk-drawer__chev { transition: none; }
  }
</style>

{%- liquid
  assign pk_bar_tint = 'transparent'
  if section.settings.bar_image != blank and section.settings.bar_tint > 0
    assign pk_bar_tint_alpha = section.settings.bar_tint | divided_by: 100.0
    if section.settings.bar_text == 'light'
      assign pk_bar_tint = 'rgba(17, 24, 39, ' | append: pk_bar_tint_alpha | append: ')'
    else
      assign pk_bar_tint = 'rgba(255, 255, 255, ' | append: pk_bar_tint_alpha | append: ')'
    endif
  endif
-%}
{%- style -%}
  #pk-header {
    --pk-bar-bg: {{ section.settings.bar_bg | default: '#ffffff' }};
    --pk-bar-tint: {{ pk_bar_tint }};
    {%- if section.settings.bar_image != blank %}
    --pk-bar-img: url('{{ section.settings.bar_image | image_url: width: 2400 }}');
    {%- endif %}
    --pk-strip-bg: {{ section.settings.strip_bg | default: '#f5f3ff' }};
    --pk-strip-fg: {{ section.settings.strip_text | default: '#4c1d95' }};
  }
{%- endstyle -%}

<div class="pk-header{% if section.settings.bar_text == 'light' %} pk-header--light{% endif %}" id="pk-header">

  <!-- ANNOUNCEMENT / UTILITY STRIP -->
  <div class="pk-strip">
    <div class="pk-wrap pk-strip__row">
      <p class="pk-strip__msg pk-strip__msg--desktop">{{ section.settings.announcement }}</p>
      <p class="pk-strip__msg pk-strip__msg--mobile">{{ pk_announcement_mobile }}</p>
      <div class="pk-strip__links">
        <a href="{{ pk_url_readymade }}">Ready-made patches</a>
        <a href="{{ pk_url_blanks }}">Blank hats</a>
        <a href="tel:+1{{ pk_tel }}" class="pk-strip__phone" aria-label="Call Patch Kraze at {{ pk_phone }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          {{ section.settings.contact_label }} <strong>{{ pk_phone }}</strong>
        </a>
      </div>
    </div>
  </div>

  <!-- MAIN BAR -->
  <div class="pk-bar">
    <div class="pk-wrap pk-bar__row">
      <a class="pk-bar__logo" href="{{ routes.root_url }}" aria-label="Patch Kraze home">
        <img src="{{ pk_logo }}" alt="Patch Kraze" width="160" height="64">
      </a>

      <nav class="pk-menu" aria-label="Main">
        <div class="pk-menu__item" data-pk-menu>
          <button type="button" class="pk-menu__link" aria-expanded="false" aria-controls="pk-panel-patches">
            Patches
            <span class="pk-menu__chev" aria-hidden="true">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </button>
          {%- liquid
            comment
              Each group's links are rendered first; a group whose products have all
              gone is left out, heading and all, and the grid closes up around it.
            endcomment
            assign pk_patch_cols = 0
            capture pk_links_stitched
              render 'pk-menu-links', blocks: section.blocks, group: 'stitched', fallback: pk_grp_stitched, variant: 'panel'
            endcapture
            capture pk_links_printed
              render 'pk-menu-links', blocks: section.blocks, group: 'printed', fallback: pk_grp_printed, variant: 'panel'
            endcapture
            capture pk_links_molded
              render 'pk-menu-links', blocks: section.blocks, group: 'molded', fallback: pk_grp_molded, variant: 'panel'
            endcapture
            capture pk_links_leather
              render 'pk-menu-links', blocks: section.blocks, group: 'leather', fallback: pk_grp_leather, variant: 'panel'
            endcapture
            assign pk_links_stitched = pk_links_stitched | strip
            assign pk_links_printed = pk_links_printed | strip
            assign pk_links_molded = pk_links_molded | strip
            assign pk_links_leather = pk_links_leather | strip
            if pk_links_stitched != blank
              assign pk_patch_cols = pk_patch_cols | plus: 1
            endif
            if pk_links_printed != blank
              assign pk_patch_cols = pk_patch_cols | plus: 1
            endif
            if pk_links_molded != blank
              assign pk_patch_cols = pk_patch_cols | plus: 1
