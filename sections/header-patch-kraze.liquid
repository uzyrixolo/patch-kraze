        minQty: 10
      },

      {
        title: "TPU Silver Flex",
        image: "{{ silver_flex.featured_image | img_url: '800x' }}",
        href: "/products/silver-flex-patches",
        minQty: 10
      },
      {
        title: "Full Color Flex",
        image: "{{ full_color_flex.featured_image | img_url: '800x' }}",
        href: "/products/full-color-flex-patches",
        minQty: 10
      }
    ],
    stickers: [
