{% schema %}
{
  "name": "Header Patch Kraze",
  "class": "section-header",
  "settings": [
    {
       "type": "header",
       "content": "Top Bar Links"
    },
    { "type": "url", "id": "url_transfers", "label": "Transfers URL" },
    { "type": "url", "id": "url_blanks", "label": "Blanks URL" },
    { "type": "url", "id": "url_patches", "label": "Patches URL" },
    { "type": "url", "id": "url_printhouse", "label": "Printhouse URL" },
    { "type": "url", "id": "url_pod", "label": "POD URL" },
    {
       "type": "header",
       "content": "Header contact"
    },
    { "type": "text", "id": "contact_phone", "label": "Phone number", "default": "909-931-6231", "info": "Shown under the rotating label and used for the tap-to-call link." },
    { "type": "text", "id": "contact_label_1", "label": "Rotating label 1", "default": "Live Chat 24/7" },
    { "type": "text", "id": "contact_label_2", "label": "Rotating label 2", "default": "Talk to Patch Kraze", "info": "Leave empty to show label 1 only, with no rotation." }
  ]
}
{% endschema %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
  
  .pk-header * { box-sizing: border-box; }
  .pk-header { font-family: 'Inter', sans-serif !important; background: #fff; line-height: 1.5; color: #111827; }

  /* Utilities */
  .pk-container { max-width: 1440px; margin: 0 auto; padding: 0 0.5rem; }
  .pk-flex { display: flex; }
  .pk-items-center { align-items: center; }
  .pk-justify-between { justify-content: space-between; }
  .pk-hidden { display: none; }
  .pk-block { display: block; }
  @media (min-width: 1024px) {
    .lg\:pk-flex { display: flex; }
    .lg\:pk-hidden { display: none !important; }
    .lg\:pk-block { display: block; }
    .desktop\:hidden { display: none !important; }
  }

  /* TOP BAR */
  .pk-top-bar { background-color: #000; color: #fff; border-bottom: 2px solid #10b981; height: 48px; position: relative; z-index: 50; }
  @media (max-width: 1023px) {
    .pk-top-bar { height: auto; }
    .pk-top-bar .pk-mobile-brand-tabs { height: 40px; border-bottom: 1px solid #1f2937; }
    .pk-top-bar .pk-mobile-brand-tabs .pk-brand-link { font-size: 0.65rem; }
  }
  .pk-brand-link { 
    display: flex; flex-direction: column; justify-content: center; height: 100%; padding: 0 0.75rem; 
    font-size: 0.75rem; font-weight: 700; line-height: 1.1; font-style: italic; letter-spacing: 0.025em; text-decoration: none; transition: background 0.2s;
  }
  .pk-brand-link:hover { background-color: #111827; }
  .pk-brand-link + .pk-brand-link { border-left: 1px solid rgba(255, 255, 255, 0.2); }
  .pk-text-cyan { color: #22d3ee; }
  .pk-text-pink { color: #f472b6; }
  .pk-bg-white-link { background-color: #fff; color: #111827; position: relative; }
  .pk-bg-white-link:hover { background-color: #f9fafb; }
  .pk-link-underline { position: absolute; bottom: -2px; left: 0; right: 0; height: 4px; background-color: #fff; z-index: 10; }

  /* MAIN HEADER */
  .pk-main-header { border-bottom: 1px solid #e5e7eb; padding: 1rem 0; }
  .pk-logo { height: 2.75rem; width: auto; object-fit: contain; }
  
  .pk-search-trigger { 
    display: flex; align-items: center; gap: 0.75rem; 
    max-width: 42rem; flex: 1; margin: 0 2rem; height: 2.75rem; 
    padding: 0 1.25rem; border: 1px solid #e5e7eb; border-radius: 0.375rem; 
    font-size: 0.875rem; background: #fff; color: #6b7280; cursor: pointer;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .pk-search-trigger:hover { border-color: #10b981; }
  .pk-search-trigger span { flex: 1; text-align: left; }
  .pk-search-btn { position: absolute; right: 0; top: 0; height: 100%; width: 2.75rem; border: none; background: transparent; cursor: pointer; display: flex; align-items: center; justify-content: center; color: #6b7280; }

  .pk-actions { display: flex; gap: 1.5rem; align-items: center; }
  .pk-action-item { display: flex; flex-direction: column; align-items: flex-end; font-size: 0.875rem; line-height: 1.25; position: relative; }
  .pk-action-title { font-weight: 600; color: #111827; white-space: nowrap; }
  .pk-action-sub { font-size: 0.75rem; color: #4b5563; }
  .pk-live-chat { display: flex; align-items: center; gap: 0.5rem; }
  .pk-dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background-color: #22c55e; } /* Green dot */
  .pk-call { text-decoration: none; color: inherit; }
  /* Both labels sit in one grid cell, so the cell is as wide as the longer of the
     two and the header never reflows as they swap. */
  .pk-rotate { display: inline-grid; }
  .pk-rotate > * { grid-area: 1 / 1; white-space: nowrap; }
  .pk-rotate__ghost { visibility: hidden; }
  .pk-rotate__live { transition: opacity 0.3s ease; }
  .pk-rotate__live[data-fading='true'] { opacity: 0; }
  @media (prefers-reduced-motion: reduce) {
    .pk-rotate__live { transition: none; }
  }

  /* Cart Icon Alignment */
  .pk-action-item cart-icon {
    display: block;
    position: relative;
  }
  .pk-action-item .cart-bubble {
    position: absolute;
    top: -8px;
    right: -8px;
  }
  .pk-action-item .cart-bubble__background {
    background-color: #10b981 !important;
  }

  /* NAV DESKTOP */
  .pk-nav { background: #fff; border-bottom: 1px solid #e5e7eb; position: relative; z-index: 40; }
  .pk-header { position: sticky; top: 0; z-index: 1100; background: #fff; }
  
  /* Mobile Responsive Header */
  @media (max-width: 1023px) {
    .pk-main-header { display: none !important; }
    .pk-nav { display: none !important; }
    .pk-mobile-header { display: grid !important; }
  }
  
  @media (max-width: 768px) {
    .pk-search-trigger { max-width: 100%; margin: 0 0.5rem; }
  }
  .pk-nav-list { display: flex; height: 3rem; align-items: center; gap: 0.25rem; font-size: 0.875rem; font-weight: 500; list-style: none; margin: 0; padding: 0; }
  .pk-nav-item { height: 100%; display: flex; align-items: center; }
  .pk-nav-btn { background: transparent; border: none; padding: 0 0.85rem; height: 100%; display: flex; align-items: center; cursor: pointer; color: #111827; transition: color 0.15s; font-size: 0.8125rem; font-weight: 500;font-family:inherit;}
  .pk-nav-btn:hover { color: #06b6d4; }
  .pk-nav-quote-cta { background: #10b981; color: #fff; border-radius: 999px; height: 2.1rem; align-self: center; margin-left: 0.35rem; padding: 0 1rem; font-weight: 700; }
  .pk-nav-quote-cta:hover { background: #059669; color: #fff; }
  .pk-chevron { width: 0.75rem; height: 0.75rem; margin-left: 0.25rem; }

  /* MEGA MENU */
  .pk-mega-menu {
    position: absolute; top: 100%; left: 0; right: 0; background: #fff; border-bottom: 1px solid #e5e7eb;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1); z-index: 50; padding: 2rem 0; display: none;
  }
  .pk-mega-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 140px)); justify-content: start; gap: 1.5rem; }
  .pk-mega-item { display: flex; flex-direction: column; align-items: center; text-decoration: none; group: hover; }
  .pk-mega-img-box { position: relative; width: 100%; max-width: 140px; aspect-ratio: 1; background: #f3f4f6; border-radius: 0.5rem; overflow: hidden; margin-bottom: 0.75rem; }
  .pk-mega-img { width: 100%; height: 100%; object-fit: cover; transition: scale 0.2s; }
  .pk-mega-badge {
    position: absolute; top: 0.4rem; left: 0.4rem; z-index: 1; background: #10b981; color: #fff;
    font-size: 0.625rem; font-weight: 700; letter-spacing: 0.02em; padding: 0.15rem 0.5rem;
    border-radius: 999px; line-height: 1.4;
  }
  .pk-mega-item:hover .pk-mega-img { transform: scale(1.05); }
  .pk-mega-title { font-size: 0.75rem; font-weight: 600; color: #1f2937; text-align: center; }
  .pk-mega-item:hover .pk-mega-title { color: #06b6d4; }

  /* MOBILE NAV */
  {% comment %} Equal 1fr rails either side of an auto centre column keep the logo on the
     viewport centre line, whatever the icon row weighs — space-between put it 46px left. {% endcomment %}
  .pk-mobile-header { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0.5rem 0.75rem; border-bottom: 1px solid #e5e7eb; }
  .pk-mobile-header > .pk-icon-btn:first-child { justify-self: start; }
  .pk-mobile-logo { height: 2.5rem; width: auto; }
  .pk-mobile-icons { display: flex; gap: 0.375rem; align-items: center; justify-self: end; }
  /* Rides on .pk-icon-btn so it inherits the search/cart icon colour and padding. */
  .pk-mobile-phone { display: inline-flex; align-items: center; text-decoration: none; }
  .pk-icon-btn { padding: 0.5rem; background: transparent; border: none; color: #374151; position: relative; }
  
  /* Mobile Cart Icon */
  .pk-icon-btn cart-icon {
    display: block;
    position: relative;
  }
  .pk-icon-btn .cart-bubble {
    position: absolute;
    top: -4px;
    right: -4px;
  }
  .pk-icon-btn .cart-bubble__background {
    background-color: #10b981 !important;
  }
  
  .pk-mobile-drawer {
    position: fixed; top: 0; left: 0; height: 100%; width: 85%; max-width: 320px; background: #fff; z-index: 60;
    transform: translateX(-100%); transition: transform 0.3s ease-in-out;
    display: flex; flex-direction: column;
  }
  .pk-mobile-drawer.open { transform: translateX(0); }
  .pk-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 55; display: none; }
  .pk-overlay.open { display: block; }
  
  .pk-drawer-header { padding: 1rem; border-bottom: 1px solid #e5e7eb; display: flex; justify-content: space-between; align-items: center; background: #f9fafb; }
  .pk-drawer-content { overflow-y: auto; flex: 1; }
  
  .pk-drawer-brands { padding: 1rem; background: #111827; border-bottom: 1px solid #1f2937; display: none; }
  @media screen and (min-width: 750px) { .pk-drawer-brands { display: block; } }
  .pk-drawer-brands-title { font-size: 0.75rem; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.75rem; }
  .pk-brand-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
  .pk-mobile-brand-btn { 
    display: block; text-align: center; padding: 0.5rem; font-size: 0.75rem; font-weight: 700; border-radius: 0.25rem; text-decoration: none;
  }

  .pk-accordion-btn { 
    width: 100%; display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 1rem; 
    text-align: left; background: #fff; border: none; border-bottom: 1px solid #f3f4f6; font-weight: 500; color: #111827;
  }
  .pk-accordion-content { background: #f9fafb; display: none; }
  .pk-accordion-content.open { display: block; }
  .pk-sub-link { display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1.5rem; text-decoration: none; color: #374151; font-size: 0.875rem; }
  .pk-sub-thumb { width: 2.5rem; height: 2.5rem; background: #e5e7eb; border-radius: 0.25rem; object-fit: cover; }
</style>

{%- liquid
  assign top_active = 'patches'
  if request.path contains 'patch-kraze-blanks'
    assign top_active = 'blanks'
  elsif request.path contains 'ready-made-patches'
    assign top_active = 'readymade'
  endif
-%}
<div class="pk-header">

  <!-- TOP BAR -->
  <div class="pk-top-bar">
    <!-- Mobile Top Bar Tabs -->
     <div class="lg:pk-hidden pk-flex pk-items-center pk-mobile-brand-tabs" style="overflow-x: auto;">
        <a href="/" class="pk-brand-link {% if top_active == 'patches' %}pk-bg-white-link{% else %}pk-text-cyan{% endif %}" style="min-width: 90px; text-align: center;"><span>PATCH KRAZE</span><span>PATCHES</span></a>
        <a href="/collections/patch-kraze-blanks" class="pk-brand-link {% if top_active == 'blanks' %}pk-bg-white-link{% else %}pk-text-cyan{% endif %}" style="min-width: 90px; text-align: center;"><span>PATCH KRAZE</span><span>BLANKS</span></a>
        <a href="/collections/ready-made-patches" class="pk-brand-link {% if top_active == 'readymade' %}pk-bg-white-link{% else %}pk-text-pink{% endif %}" style="min-width: 90px; text-align: center;"><span>READY MADE</span><span>PATCHES</span></a>
     </div>
    <div class="pk-container lg:pk-flex pk-items-center pk-justify-between" style="height: 100%;">
      <div class="pk-hidden lg:pk-flex" style="height: 100%;">
        <a href="/" class="pk-brand-link {% if top_active == 'patches' %}pk-bg-white-link{% else %}pk-text-cyan{% endif %}"><span>PATCH KRAZE</span><span>PATCHES</span>{% if top_active == 'patches' %}<span class="pk-link-underline"></span>{% endif %}</a>
        <a href="/collections/patch-kraze-blanks" class="pk-brand-link {% if top_active == 'blanks' %}pk-bg-white-link{% else %}pk-text-cyan{% endif %}"><span>PATCH KRAZE</span><span>BLANKS</span>{% if top_active == 'blanks' %}<span class="pk-link-underline"></span>{% endif %}</a>
        <a href="/collections/ready-made-patches" class="pk-brand-link {% if top_active == 'readymade' %}pk-bg-white-link{% else %}pk-text-pink{% endif %}"><span>READY MADE</span><span>PATCHES</span>{% if top_active == 'readymade' %}<span class="pk-link-underline"></span>{% endif %}</a>
      </div>
      <div style="font-size: 0.75rem; font-weight: 500; text-align: center; flex: 1; padding: 6px 8px;">
        Select Patches Ship as Fast as 5 Business Days with PatchFast. 10pc Mins with Free Shipping!
      </div>
    </div>
  </div>

  <!-- MAIN HEADER (DESKTOP) -->
  <div class="pk-main-header pk-hidden lg:pk-block">
    <div class="pk-container pk-flex pk-items-center pk-justify-between">
      <a href="/">
        <img src="https://cdn.shopify.com/s/files/1/0661/2965/7940/files/Patch_Kraze_Logo_horizontal_low_9ea09d1a-6c9e-4f1b-8b6a-58cbadcfdf50.png?v=1787003036" alt="Patch Kraze" width="160" height="64" class="pk-logo">
      </a>
      
      <!-- Desktop Search Button - Opens Modal -->
      <button class="pk-search-trigger" onclick="document.querySelector('#search-modal dialog')?.showModal()">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        <span>Search Patch Styles</span>
      </button>

      <div class="pk-actions">
        {%- liquid
          assign pk_phone = section.settings.contact_phone | default: '909-931-6231'
          assign pk_tel = pk_phone | remove: '-' | remove: ' ' | remove: '(' | remove: ')' | remove: '.'
          assign pk_label_1 = section.settings.contact_label_1 | default: 'Live Chat 24/7'
          assign pk_label_2 = section.settings.contact_label_2
        -%}
        <a
          href="tel:+1{{ pk_tel }}"
          class="pk-action-item pk-call"
          aria-label="Call Patch Kraze at {{ pk_phone }}"
        >
          <div class="pk-live-chat">
             <span class="pk-dot"></span>
             <span class="pk-action-title" style="color:#059669;">
               {%- if pk_label_2 != blank -%}
                 <span class="pk-rotate">
                   <span class="pk-rotate__ghost" aria-hidden="true">{{ pk_label_1 }}</span>
                   <span class="pk-rotate__ghost" aria-hidden="true">{{ pk_label_2 }}</span>
                   <span class="pk-rotate__live" data-pk-rotate="{{ section.id }}" aria-hidden="true">{{ pk_label_1 }}</span>
                 </span>
               {%- else -%}
                 {{ pk_label_1 }}
               {%- endif -%}
             </span>
          </div>
          <span class="pk-action-sub">{{ pk_phone }}</span>
        </a>
        <a href="{{ routes.account_url }}" class="pk-action-item" style="text-decoration:none;">
          <span class="pk-action-title">Hello, sign in</span>
          <span class="pk-action-sub">Account & Reorder</span>
        </a>
        
        <button class="pk-action-item" onclick="document.querySelector('cart-drawer-component').open()" style="background:transparent; border:none; cursor:pointer;">
           {% render 'cart-icon-component' %}
        </button>
      </div>
    </div>
  </div>

  <!-- Cart Drawer Component -->


  <!-- MOBILE HEADER -->
  <div class="pk-mobile-header lg:pk-hidden desktop:hidden">
    <button class="pk-icon-btn" onclick="toggleMobileMenu(true)">
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
    </button>
    <a href="/">
      <img src="https://cdn.shopify.com/s/files/1/0661/2965/7940/files/Patch_Kraze_Logo_horizontal_low_9ea09d1a-6c9e-4f1b-8b6a-58cbadcfdf50.png?v=1787003036" width="100" height="40" class="pk-mobile-logo">
    </a>
    <div class="pk-mobile-icons lg:pk-hidden desktop:hidden">
       <a href="tel:+1{{ pk_tel }}" class="pk-icon-btn pk-mobile-phone" aria-label="Call Patch Kraze at {{ pk_phone }}">
         <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
       </a>
       <button class="pk-icon-btn" onclick="document.querySelector('#search-modal dialog')?.showModal()"><svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg></button>
       <button class="pk-icon-btn" onclick="document.querySelector('cart-drawer-component').open()">
          {% render 'cart-icon-component' %}
       </button>
    </div>
  </div>

  {%- if pk_label_2 != blank -%}
    <script>
      (function () {
        var nodes = document.querySelectorAll('[data-pk-rotate="{{ section.id }}"]');
        if (!nodes.length) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        var labels = [{{ pk_label_1 | json }}, {{ pk_label_2 | json }}];
        var HOLD = 2600;
        var FADE = 320;
        var i = 0;

        window.setInterval(function () {
          nodes.forEach(function (node) {
            node.setAttribute('data-fading', 'true');
          });
          window.setTimeout(function () {
            i = (i + 1) % labels.length;
            nodes.forEach(function (node) {
              node.textContent = labels[i];
              node.removeAttribute('data-fading');
            });
          }, FADE);
        }, HOLD);
      })();
    </script>
  {%- endif -%}

  <!-- HORIZON SEARCH MODAL (with predictive search) -->
  {% render 'search-modal' %}

  <!-- NAVIGATION (DESKTOP) -->
  <nav class="pk-nav pk-hidden lg:pk-block">
    <div class="pk-container">
      <ul class="pk-nav-list" id="desktop-nav-list">
         <!-- Populated via JS -->
      </ul>
      <div id="mega-menu-container" class="pk-mega-menu">
         <div class="pk-container">
            <div class="pk-mega-grid" id="mega-menu-content">
               <!-- Content -->
            </div>
         </div>
      </div>
    </div>
  </nav>

  <!-- MOBILE DRAWER -->
  <div class="pk-overlay" id="mobile-overlay" onclick="toggleMobileMenu(false)"></div>
  <div class="pk-mobile-drawer" id="mobile-drawer">
    <div class="pk-drawer-header">
      <img src="https://cdn.shopify.com/s/files/1/0661/2965/7940/files/Patch_Kraze_Logo.webp?v=1770364953" width="80" height="32" style="height:2rem; width:auto; object-fit:contain;">
      <button class="pk-icon-btn" onclick="toggleMobileMenu(false)">
         <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="pk-drawer-content">
      <div class="pk-drawer-brands">
         <div class="pk-drawer-brands-title">Our Brands</div>
         <div class="pk-brand-grid">
            <a href="{{ section.settings.url_transfers | default: '/products/dtf-transfers' }}" class="pk-mobile-brand-btn" style="background:#1f2937; color:#22d3ee;">TRANSFERS</a>
            <a href="{{ section.settings.url_blanks | default: '/collections/blanks' }}" class="pk-mobile-brand-btn" style="background:#fff; color:#111827;">BLANKS</a>
            <a href="{{ section.settings.url_patches | default: '/products/embroidered-patches' }}" class="pk-mobile-brand-btn" style="background:#1f2937; color:#22d3ee;">PATCHES</a>
            <a href="{{ section.settings.url_printhouse | default: '/pages/printhouse' }}" class="pk-mobile-brand-btn" style="background:#1f2937; color:#22d3ee;">PRINTHOUSE</a>
         </div>
      </div>
      <div id="mobile-nav-list">
         <!-- Populated via JS -->
      </div>
    </div>
  </div>

  <!-- Global Cart Drawer (Always in DOM) -->
  <div id="global-cart-drawer">
    {% render 'cart-drawer' %}
  </div>
  <style>
    #global-cart-drawer cart-drawer-component > button.header-actions__action { display: none !important; }
  </style>

</div>

<script>
  // ------------------------------------
  // DATA CONFIGURATION - Dynamic from Shopify Products
  // ------------------------------------
  
  {% comment %}
    Fetch product and collection images dynamically from Shopify
  {% endcomment %}
  {% assign embroidered_patches = all_products['embroidered-patches'] %}
  {% assign patches_3d = all_products['3d-embroidered-patches'] %}
  {% assign name_patches = all_products['name-patches'] %}
  {% assign chenille_patches = all_products['chenille-patches'] %}
  {% assign tackle_twill = all_products['tackle-twill-letters'] %}
  {% assign pvc_rubber = all_products['pvc-rubber-patches'] %}
  {% assign pvc_3d = all_products['3d-pvc-patches'] %}
  {% assign keychains = all_products['custom-keychains'] %}
  {% assign leather_patches = all_products['leather-patches'] %}
  {% assign faux_leather = all_products['faux-leather-patches'] %}
  
  {% assign gold_flex = all_products['gold-flex-patches'] %}
  {% assign silver_flex = all_products['silver-flex-patches'] %}
