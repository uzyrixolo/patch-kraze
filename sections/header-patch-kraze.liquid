    #global-cart-drawer cart-drawer-component > button.header-actions__action { display: none !important; }
  </style>

</div>

<script>
  (function () {
    var header = document.getElementById('pk-header');
    if (!header) return;

    // The header is position:fixed (see the .pk-header comment), so it reserves
    // no space of its own. Pad the page by the header's full height - measured
    // with the strip showing, even if the page is currently scrolled - so
    // nothing shifts when the strip drops away on scroll.
    function syncOffset() {
      var condensed = header.classList.contains('pk-header--scrolled');
      if (condensed) header.classList.remove('pk-header--scrolled');
      document.body.style.paddingTop = header.offsetHeight + 'px';
      if (condensed) header.classList.add('pk-header--scrolled');
    }
    syncOffset();
    window.addEventListener('resize', syncOffset);
    window.addEventListener('load', syncOffset);

    // Past a small threshold (so a 1px scroll doesn't flicker it) the strip hides.
    var ticking = false;
    function applyScrollState() {
      header.classList.toggle('pk-header--scrolled', window.scrollY > 12);
      ticking = false;
    }
    window.addEventListener('scroll', function () {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(applyScrollState);
    }, { passive: true });
    applyScrollState();

    // Dropdown panels open on hover through CSS; a click, tap, or Enter/Space
    // pins one open (the only way in on touch screens and for keyboards). Only
    // one panel is ever pinned, and a pinned panel closes as soon as the
    // pointer or keyboard focus moves to anything else in the header menu.
    // Delegated from document so the handlers still work after the cart
    // re-renders this section's markup.
    function closeMenus(except) {
      header.querySelectorAll('[data-pk-menu][data-open]').forEach(function (item) {
        if (item === except) return;
        item.removeAttribute('data-open');
        var btn = item.querySelector('.pk-menu__link');
        if (btn) btn.setAttribute('aria-expanded', 'false');
      });
    }
    function menuItemOf(node) {
      return node instanceof Element ? node.closest('#pk-header .pk-menu__item') : null;
    }
    document.addEventListener('click', function (event) {
      var target = event.target instanceof Element ? event.target : null;
      var trigger = target ? target.closest('#pk-header [data-pk-menu] > .pk-menu__link') : null;
      if (trigger) {
        var item = trigger.parentElement;
        var open = !item.hasAttribute('data-open');
        closeMenus(item);
        item.toggleAttribute('data-open', open);
        trigger.setAttribute('aria-expanded', String(open));
        return;
      }
      if (!target || !target.closest('#pk-header [data-pk-menu]')) closeMenus();
    });
    document.addEventListener('mouseover', function (event) {
      var item = menuItemOf(event.target);
      if (item) closeMenus(item);
    });
    document.addEventListener('focusin', function (event) {
      closeMenus(menuItemOf(event.target));
    });

    var drawer = document.getElementById('mobile-drawer');
    var overlay = document.getElementById('mobile-overlay');
    window.toggleMobileMenu = function (open) {
      if (!drawer || !overlay) return;
      drawer.classList.toggle('open', !!open);
      overlay.classList.toggle('open', !!open);
      document.body.style.overflow = open ? 'hidden' : '';
    };

    document.addEventListener('keydown', function (event) {
      if (event.key !== 'Escape') return;
      closeMenus();
      if (drawer && drawer.classList.contains('open')) window.toggleMobileMenu(false);
    });
  })();
</script>
