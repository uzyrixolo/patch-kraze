          {%- capture pk_drawer_links -%}{%- render 'pk-menu-links', blocks: section.blocks, group: 'printed', fallback: pk_grp_printed, variant: 'drawer' -%}{%- endcapture -%}
          {%- assign pk_drawer_links = pk_drawer_links | strip -%}
