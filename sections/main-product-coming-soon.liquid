{% schema %}
{
  "name": "Coming Soon Product",
  "tag": "section",
  "class": "section-coming-soon",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Coming Soon"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "This Product is Coming Soon!"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>We're working hard to bring you something amazing. Sign up below to be notified when this product launches.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_email_signup",
      "label": "Show Email Signup",
      "default": true
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge Color",
      "default": "#10b981"
    }
  ],
  "presets": [
    {
      "name": "Coming Soon Product"
    }
  ]
}
{% endschema %}

<style>
  .coming-soon-page {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
    background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  }
  
  .coming-soon-container {
    max-width: 900px;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    background: #fff;
    border-radius: 1.5rem;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
    overflow: hidden;
  }
  
  @media (min-width: 768px) {
    .coming-soon-container {
      grid-template-columns: 1fr 1fr;
    }
  }
  
  .coming-soon-image {
    position: relative;
    aspect-ratio: 1;
    background: #f3f4f6;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  
  .coming-soon-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .coming-soon-badge {
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
    padding: 0.5rem 1rem;
    background: {{ section.settings.badge_color }};
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-radius: 9999px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }
  
  .coming-soon-content {
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.5rem;
  }
  
  .coming-soon-title {
    font-size: 1.875rem;
    font-weight: 800;
    color: #111827;
    line-height: 1.2;
    margin: 0;
  }
  
  .coming-soon-product-title {
    font-size: 1rem;
    font-weight: 600;
    color: #6b7280;
    margin: 0 0 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .coming-soon-heading {
    font-size: 1.5rem;
    font-weight: 700;
    color: #111827;
    margin: 0;
  }
  
  .coming-soon-description {
    color: #4b5563;
    font-size: 1rem;
    line-height: 1.75;
    margin: 0;
  }
  
  .coming-soon-description p {
    margin: 0;
  }
  
  .coming-soon-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  
  @media (min-width: 480px) {
    .coming-soon-form {
      flex-direction: row;
    }
  }
  
  .coming-soon-input {
    flex: 1;
    padding: 0.875rem 1rem;
    border: 2px solid #e5e7eb;
    border-radius: 0.5rem;
    font-size: 1rem;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  
  .coming-soon-input:focus {
    outline: none;
    border-color: {{ section.settings.badge_color }};
    box-shadow: 0 0 0 3px {{ section.settings.badge_color }}33;
  }
  
  .coming-soon-btn {
    padding: 0.875rem 1.5rem;
    background: {{ section.settings.badge_color }};
    color: #fff;
    border: none;
    border-radius: 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
    white-space: nowrap;
  }
  
  .coming-soon-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px {{ section.settings.badge_color }}66;
  }
  
  .coming-soon-success {
    display: none;
    padding: 1rem;
    background: #d1fae5;
    color: #065f46;
    border-radius: 0.5rem;
    font-weight: 500;
    text-align: center;
  }
  
  .coming-soon-success.show {
    display: block;
  }
  
  .coming-soon-features {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
  }
  
  .coming-soon-feature {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: #6b7280;
  }
  
  .coming-soon-feature svg {
    width: 1.25rem;
    height: 1.25rem;
    color: {{ section.settings.badge_color }};
  }
</style>

<div class="coming-soon-page">
  <div class="coming-soon-container">
    <div class="coming-soon-image">
      {% if product.featured_image %}
        <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title }}" width="800" height="800" loading="eager">
      {% else %}
        <svg width="120" height="120" fill="none" stroke="#d1d5db" stroke-width="1.5" viewBox="0 0 24 24">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
          <circle cx="8.5" cy="8.5" r="1.5"/>
          <polyline points="21 15 16 10 5 21"/>
        </svg>
      {% endif %}
      <div class="coming-soon-badge">{{ section.settings.badge_text }}</div>
    </div>
    
    <div class="coming-soon-content">
      <div>
        <p class="coming-soon-product-title">{{ product.title }}</p>
        <h1 class="coming-soon-heading">{{ section.settings.heading }}</h1>
      </div>
      
      <div class="coming-soon-description">
        {{ section.settings.description }}
      </div>
      
      <div class="coming-soon-features">
        <div class="coming-soon-feature">
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span>Launching Soon</span>
        </div>
        <div class="coming-soon-feature">
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
          </svg>
          <span>Get Notified</span>
        </div>
      </div>
      
      {% if section.settings.show_email_signup %}
        <form class="coming-soon-form" id="coming-soon-form" action="{{ routes.root_url }}" method="post">
          <input type="hidden" name="contact[tags]" value="coming-soon,{{ product.handle }}">
          <input 
            type="email" 
            name="contact[email]" 
            class="coming-soon-input" 
            placeholder="Enter your email" 
            required
          >
          <button type="submit" class="coming-soon-btn">Notify Me</button>
        </form>
        <div class="coming-soon-success" id="coming-soon-success">
          Thanks! We'll notify you when this product launches.
        </div>
      {% endif %}
    </div>
  </div>
</div>

<script>
  document.getElementById('coming-soon-form')?.addEventListener('submit', function(e) {
    e.preventDefault();
    const form = this;
    const email = form.querySelector('input[type="email"]').value;
    
    // Simple localStorage to remember signup (could integrate with Klaviyo/Mailchimp)
    const signups = JSON.parse(localStorage.getItem('coming-soon-signups') || '[]');
    signups.push({ email, product: '{{ product.handle }}', date: new Date().toISOString() });
    localStorage.setItem('coming-soon-signups', JSON.stringify(signups));
    
    form.style.display = 'none';
    document.getElementById('coming-soon-success').classList.add('show');
  });
</script>
