<script>
  // AJAX Add to Cart - HIGH PRIORITY HANDLER
  (function() {
    const form = document.getElementById('product-form-pk');
    if(!form) return;
    
    // Override submit with button click handler instead
    const btn = form.querySelector('.checkout-btn');
    if(!btn) return;
    
    btn.addEventListener('click', async function(e) {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      
      // Validate form
      if(!form.checkValidity()) {
        form.reportValidity();
        return false;
      }
      
      const formData = new FormData(form);
      const originalText = btn.innerText;
      
      // Add sections parameter for cart drawer rendering
      const cartItemsComponents = document.querySelectorAll('cart-items-component');
      const sectionIds = [];
      cartItemsComponents.forEach((item) => {
        if (item instanceof HTMLElement && item.dataset.sectionId) {
          sectionIds.push(item.dataset.sectionId);
        }
      });
      if(sectionIds.length > 0) {
        formData.append('sections', sectionIds.join(','));
      }
      
      btn.disabled = true;
      btn.innerText = 'Adding...';
      
      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          body: formData
        });
        
        const responseData = await response.json();
        
        if(response.ok) {
          // Re-render cart drawer sections if returned
          if (responseData.sections) {
            Object.entries(responseData.sections).forEach(([sectionId, html]) => {
              const el = document.querySelector(`[data-section-id="${sectionId}"]`);
              if (el) {
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');
                const newEl = doc.querySelector(`[data-section-id="${sectionId}"]`);
                if (newEl) el.innerHTML = newEl.innerHTML;
              }
            });
          }

          // Fetch real cart count then dispatch event with correct shape
          const cartRes = await fetch('/cart.js');
          const cartData = await cartRes.json();
          const cartUpdateEvent = new CustomEvent('cart:update', {
            bubbles: true,
            detail: {
              resource: cartData,
              data: {
                source: 'product-form-component',
                itemCount: cartData.item_count,
                sections: responseData.sections || {}
              }
            }
          });
          document.dispatchEvent(cartUpdateEvent);

          // Wait briefly before opening drawer so sections have time to render
          await new Promise(resolve => setTimeout(resolve, 100));
          
          // Open cart drawer
          const cartDrawer = document.querySelector('cart-drawer-component');
          if(cartDrawer) {
            if(typeof cartDrawer.open === 'function') {
              cartDrawer.open();
            } else if(typeof cartDrawer.showDialog === 'function') {
              cartDrawer.showDialog();
            }
          }
          
          btn.innerText = 'Added!';
          setTimeout(() => {
            btn.disabled = false;
            btn.innerText = originalText;
          }, 1000);
        } else {
          throw new Error(responseData.description || 'Failed to add to cart');
        }
      } catch(error) {
        console.error('Cart error:', error);
        btn.innerText = 'Error - Try Again';
        btn.disabled = false;
        alert('Error: ' + error.message);
      }
      
      return false;
    }, true);
    
    // Also prevent form submission
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      return false;
    }, true);
  })();
</script>

<script>
  // Zoom Image Functionality
  function zoomImage() {
    // Get currently visible image from gallery
    const scroller = document.getElementById('galleryScroller');
    const slides = scroller.querySelectorAll('.gallery-slide');
    let currentImg = null;
    
    // Find the slide that's most visible in the viewport
    let maxVisible = 0;
    slides.forEach(slide => {
      const rect = slide.getBoundingClientRect();
      const visibleWidth = Math.min(rect.right, scroller.getBoundingClientRect().right) - Math.max(rect.left, scroller.getBoundingClientRect().left);
      if (visibleWidth > maxVisible) {
        maxVisible = visibleWidth;
        currentImg = slide.querySelector('img');
      }
    });
    
    // Fallback to mainProductImage if no visible image found
    if (!currentImg) {
      currentImg = document.getElementById('mainProductImage');
    }
    if (!currentImg) return;
    
    const modal = document.createElement('div');
    modal.style.cssText = `
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.9);
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
      cursor: zoom-out;
    `;
    
    const zoomedImg = document.createElement('img');
    zoomedImg.src = currentImg.src.replace(/width=\d+/, 'width=2000');
    zoomedImg.style.cssText = `
      max-width: 95%;
      max-height: 95%;
      object-fit: contain;
      border-radius: 0.5rem;
    `;
    
    const closeBtn = document.createElement('button');
    closeBtn.innerHTML = `
      <svg width="32" height="32" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    `;
    closeBtn.style.cssText = `
      position: absolute;
      top: 1rem;
      right: 1rem;
      background: rgba(0, 0, 0, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 50%;
      width: 3rem;
      height: 3rem;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.2s;
    `;
    closeBtn.onmouseover = () => closeBtn.style.background = 'rgba(0, 0, 0, 0.8)';
    closeBtn.onmouseout = () => closeBtn.style.background = 'rgba(0, 0, 0, 0.5)';
    
    const closeModal = () => document.body.removeChild(modal);
    modal.onclick = closeModal;
    closeBtn.onclick = closeModal;
    
    modal.appendChild(zoomedImg);
    modal.appendChild(closeBtn);
    document.body.appendChild(modal);
  }
</script>

