              <span id="calculated-size-display" class="pk-size-value">2"</span>
              {%- if pk_noun == 'patch' %}
              <div class="tooltip-container" id="size-tooltip">
                <div class="info-icon">i</div>
                <span class="tooltip-text">Pricing uses the average of your width and height. Your patch is still made at the exact width and height you enter.</span>
              </div>
              {%- endif %}
            </div>

            <div id="artwork-dpi-warning" style="display:none; align-items:flex-start; gap:0.5rem; background:#fef3c7; border:1px solid #fcd34d; border-radius:0.5rem; padding:0.75rem 1rem; margin-bottom:0.75rem; font-size:0.875rem; color:#92400e; line-height:1.4;"></div>
            <div id="artwork-size-note" style="display:none; align-items:flex-start; gap:0.5rem; background:#faf5ff; border:1px solid #e9d5ff; border-radius:0.5rem; padding:0.75rem 1rem; margin-bottom:0.75rem; font-size:0.875rem; color:#6b21a8; line-height:1.4;">
              <span style="flex-shrink:0; font-size:1rem; line-height:1;">📐</span>
              <span><strong id="artwork-size-text">Sized to your artwork.</strong> <span id="artwork-size-detail"></span>
                <a href="#" id="artwork-size-unlock" style="color:#7e22ce; font-weight:600; text-decoration:underline;">Set width &amp; height separately</a></span>
            </div>
            <p class="pk-size-hint" id="size-custom-note">Between sizes? Pick the nearest one and tell us the exact size in a note under your artwork. We'll make it to that size at no extra cost.</p>
          </div>

          <!-- STEP 3: QUANTITY -->
          <div class="pk-step">
            <div class="pk-step__head">
              <span class="pk-step__num" aria-hidden="true"></span>
              <h2 class="pk-step__title">Quantity</h2>
            </div>

            <div class="pk-qty-row">
              <div>
                <label class="pk-field-label" for="qty-input">Number of pieces</label>
                <input type="number" name="quantity" id="qty-input" class="qty-box-large" value="100" min="1" inputmode="numeric">
                <div class="pk-qty-min" id="qty-min-label">Minimum order: 10</div>
                <div class="pk-qty-error" id="qty-error">Please order at least 10 pieces.</div>
              </div>
              <div class="pk-summary">
                <div class="pk-summary__line"><span>Per piece</span><span class="pk-summary__unit" id="unit-price-display">$1.59</span></div>
                <div class="pk-summary__line"><span>Order total</span><span class="total-price-large" id="total-price-display">$159.00</span></div>
                <div class="pk-summary__note" id="total-velcro-note" style="display:none;">Total includes Velcro backing at $0.25 per piece.</div>
              </div>
            </div>

            <div class="pk-tier-heading">Price breaks by quantity</div>
            <div class="pricing-card">
              <div class="pricing-header"><span>Pieces</span><span>Each</span><span>Savings</span></div>
              <div class="pricing-row" data-min="10" data-max="49"><div class="pricing-row__cols"><span>10-49 pcs</span><span id="price-tier-1">Calculating...</span><span id="discount-tier-1">Base</span></div><div class="pricing-row__msg" id="tier-msg-1"></div></div>
              <div class="pricing-row" data-min="50" data-max="99"><div class="pricing-row__cols"><span>50-99 pcs</span><span id="price-tier-2">Calculating...</span><span id="discount-tier-2">...</span></div><div class="pricing-row__msg" id="tier-msg-2"></div></div>
              <div class="pricing-row" data-min="100" data-max="199"><div class="pricing-row__cols"><span>100-199 pcs</span><span id="price-tier-3">Calculating...</span><span id="discount-tier-3">...</span></div><div class="pricing-row__msg" id="tier-msg-3"></div></div>
              <div class="pricing-row" data-min="200" data-max="499"><div class="pricing-row__cols"><span>200-499 pcs</span><span id="price-tier-4">Calculating...</span><span id="discount-tier-4">...</span></div><div class="pricing-row__msg" id="tier-msg-4"></div></div>
              <div class="pricing-row" data-min="500" data-max="999"><div class="pricing-row__cols"><span>500-999 pcs</span><span id="price-tier-5">Calculating...</span><span id="discount-tier-5">...</span></div><div class="pricing-row__msg" id="tier-msg-5"></div></div>
              <div class="pricing-row" data-min="1000" data-max="999999"><div class="pricing-row__cols"><span>1000+ pcs</span><span id="price-tier-6">Calculating...</span><span id="discount-tier-6">...</span></div><div class="pricing-row__msg" id="tier-msg-6"></div></div>
            </div>
          </div>

          {% unless product.handle == 'dtf-transfers' or product.handle contains 'sticker' %}
          <!-- STEP 4: FINISHING (patch products only) -->
          <div class="pk-step">
            <div class="pk-step__head">
              <span class="pk-step__num" aria-hidden="true"></span>
              <h2 class="pk-step__title">Finishing</h2>
            </div>
            <p class="pk-step__sub">All of these are included in your price. The one exception is Velcro backing, which adds $0.25 per piece.</p>

          <div class="control-group pk-color-card">
          <div class="control-label" id="pk-shape-label">Cut shape</div>
          <div class="pk-shapes" role="group" aria-labelledby="pk-shape-label">
            <button type="button" class="pk-shape selected" aria-pressed="true" onclick="selectShape(this, 'Circle')">
              <svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="17"/></svg>
              <span>Circle</span>
            </button>
            <button type="button" class="pk-shape" aria-pressed="false" onclick="selectShape(this, 'Square')">
              <svg viewBox="0 0 48 48" aria-hidden="true"><rect x="8" y="8" width="32" height="32" rx="4"/></svg>
              <span>Square</span>
            </button>
            <button type="button" class="pk-shape" aria-pressed="false" onclick="selectShape(this, 'Rectangle')">
              <svg viewBox="0 0 48 48" aria-hidden="true"><rect x="4" y="13" width="40" height="22" rx="4"/></svg>
              <span>Rectangle</span>
            </button>
            <button type="button" class="pk-shape" aria-pressed="false" onclick="selectShape(this, 'Oval')">
              <svg viewBox="0 0 48 48" aria-hidden="true"><ellipse cx="24" cy="24" rx="20" ry="13"/></svg>
              <span>Oval</span>
            </button>
            <button type="button" class="pk-shape" aria-pressed="false" onclick="selectShape(this, 'Custom')">
              <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M14 37C6 37 3 27 10 23c-3-9 9-16 15-9 5-8 19-4 16 7 8 3 5 16-4 16z"/></svg>
              <span>Follow my design</span>
