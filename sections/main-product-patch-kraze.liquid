          </div>
          <input type="hidden" name="properties[Shape]" id="shape-input" value="Circle">
          </div>

          {%- comment -%}
            Colors: the patch background and the border, side by side. Both are
            optional free text (a color name, a hex code or a Pantone number).
            The swatch opens the browser's color picker and writes a hex code
            into the box; so do the colors read from the uploaded artwork. An
            empty box is left off the order and we follow the artwork.
          {%- endcomment -%}
          <div class="control-group pk-color-card">
            <div class="control-label">Colors <span class="pk-colors__optional">Optional</span></div>
            <p class="pk-colors__hint">Type a color name, a hex code or a Pantone number. Leave a box empty and we'll follow your artwork.</p>
            <div class="pk-colors">
              <div class="pk-colors__field" data-color-field>
                <label class="pk-field-label" for="bg-color-input">Background</label>
                <div class="pk-colors__row">
                  <label class="pk-colors__chip" title="Open the color picker">
                    <input type="color" class="pk-colors__native" value="#7e22ce" aria-label="Pick a background color">
                  </label>
                  <input type="text" id="bg-color-input" name="properties[Background Color]" class="pk-colors__text" maxlength="40" autocomplete="off" placeholder="e.g. navy or #1E3A8A">
                </div>
                <div class="pk-colors__suggests" hidden></div>
              </div>
              <div class="pk-colors__field" data-color-field>
                <label class="pk-field-label" for="thread-color-input">Border</label>
                <div class="pk-colors__row">
                  <label class="pk-colors__chip" title="Open the color picker">
                    <input type="color" class="pk-colors__native" value="#7e22ce" aria-label="Pick a border color">
                  </label>
                  <input type="text" id="thread-color-input" name="properties[Border Color]" class="pk-colors__text" maxlength="40" autocomplete="off" placeholder="e.g. black or #000000">
                </div>
                <div class="pk-colors__suggests" hidden></div>
              </div>
            </div>
            <button type="button" class="pk-match-artwork-btn" onclick="matchMyArtwork()">
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 6l4 4"/><path d="M5 19l1-4 8.5-8.5a2.1 2.1 0 0 1 3 3L9 18l-4 1z"/></svg>
              Suggest colors from my artwork
            </button>
            <p class="pk-colors__note" id="pk-colors-note" hidden></p>
          </div>

          <label class="control-label">Backing: <span id="backing-label-extra" style="font-weight:400; color:#6b7280;">Iron-On</span></label>
          <div class="backing-grid">
            <div class="backing-card selected" onclick="selectBacking(this, 'Iron-On')">
              <div class="backing-preview" style="background-image:url('https://cdn.shopify.com/s/files/1/0661/2965/7940/files/Heat_Applied.jpg?v=1770207494'); background-size:cover; background-position:center;"></div>
              <div>Iron-On</div>
            </div>
            <div class="backing-card" onclick="selectBacking(this, 'Velcro (hook &amp; loop, both sides included)')">
              <div class="backing-preview" style="background-image:url('https://cdn.shopify.com/s/files/1/0661/2965/7940/files/Velcro.jpg?v=1770207494'); background-size:cover; background-position:center;">
                <span class="backing-price-badge">+$0.25/pc</span>
              </div>
              <div>Velcro</div>
            </div>
            <div class="backing-card" onclick="selectBacking(this, 'Adhesive (peel-off)')">
              <div class="backing-preview" style="background-image:url('https://cdn.shopify.com/s/files/1/0661/2965/7940/files/Peel_Stick.jpg?v=1770207494'); background-size:cover; background-position:center;"></div>
              <div>Adhesive</div>
            </div>
          </div>
          <div id="backing-description" style="margin-bottom:0.5rem; font-size:0.9rem; color:#4b5563; line-height:1.5;">
            Bonds to fabric with heat. A heat press gives the most even result; a household iron also works if you press firmly.
          </div>
          <input type="hidden" name="properties[Backing]" id="backing-input" value="Iron-On">

          {% if product.handle == 'faux-leather-patches' %}
          <label class="control-label" style="margin-top:1.5rem;">Leather color: <span id="leather-color-label-extra" style="font-weight:400; color:#6b7280;">Faux Black</span></label>
          <div class="backing-grid">
            <div class="backing-card selected" onclick="selectLeatherColor(this, 'Faux Black')">
              <div class="backing-preview" style="background-image:url('https://cdn.shopify.com/s/files/1/0661/2965/7940/files/Foux_black.jpg?v=1778792496'); background-size:cover; background-position:center;"></div>
              <div>Faux Black</div>
            </div>
            <div class="backing-card" onclick="selectLeatherColor(this, 'Faux Chestnut/Brown')">
              <div class="backing-preview" style="background-image:url('https://cdn.shopify.com/s/files/1/0661/2965/7940/files/Foux_chestnutbrown.jpg?v=1778792496'); background-size:cover; background-position:center;"></div>
              <div>Faux Chestnut/Brown</div>
            </div>
            <div class="backing-card" onclick="selectLeatherColor(this, 'Faux Light Brown')">
              <div class="backing-preview" style="background-image:url('https://cdn.shopify.com/s/files/1/0661/2965/7940/files/Foux_light_brown.jpg?v=1778792496'); background-size:cover; background-position:center;"></div>
              <div>Faux Light Brown</div>
            </div>
            <div class="backing-card" onclick="selectLeatherColor(this, 'Faux Chocolate')">
              <div class="backing-preview" style="background-image:url('https://cdn.shopify.com/s/files/1/0661/2965/7940/files/Foux_chocolate.jpg?v=1778792496'); background-size:cover; background-position:center;"></div>
              <div>Faux Chocolate</div>
            </div>
          </div>
          <input type="hidden" name="properties[Leather Color]" id="leather-color-input" value="Faux Black">
          {% endif %}

          {% if product.handle == 'leather-patches' or product.handle == 'genuine-leather-patches' %}
          <label class="control-label" style="margin-top:1.5rem;">Leather color: <span id="leather-color-label-extra" style="font-weight:400; color:#6b7280;">Genuine Caramel/Brown</span></label>
          <div class="backing-grid">
            <div class="backing-card selected" onclick="selectLeatherColor(this, 'Genuine Caramel/Brown')">
              <div class="backing-preview" style="background-image:url('https://cdn.shopify.com/s/files/1/0661/2965/7940/files/Geniune_caramellbrown.jpg?v=1778792496'); background-size:cover; background-position:center;"></div>
              <div>Genuine Caramel/Brown</div>
            </div>
            <div class="backing-card" onclick="selectLeatherColor(this, 'Genuine Natural/Sand/Tan')">
              <div class="backing-preview" style="background-image:url('https://cdn.shopify.com/s/files/1/0661/2965/7940/files/Geniune_naturalsandtan.jpg?v=1778792496'); background-size:cover; background-position:center;"></div>
              <div>Genuine Natural/Sand/Tan</div>
            </div>
            <div class="backing-card" onclick="selectLeatherColor(this, 'Genuine Taupe')">
              <div class="backing-preview" style="background-image:url('https://cdn.shopify.com/s/files/1/0661/2965/7940/files/Geniune_taupe.jpg?v=1778792496'); background-size:cover; background-position:center;"></div>
              <div>Genuine Taupe</div>
            </div>
            <div class="backing-card" onclick="selectLeatherColor(this, 'Dark Brown Genuine')">
              <div class="backing-preview" style="background-image:url('https://cdn.shopify.com/s/files/1/0661/2965/7940/files/Dark_brown_geniune.jpg?v=1778792494'); background-size:cover; background-position:center;"></div>
              <div>Dark Brown Genuine</div>
            </div>
          </div>
          <input type="hidden" name="properties[Leather Color]" id="leather-color-input" value="Genuine Caramel/Brown">
          {% endif %}
          </div>
          {% endunless %}

          <!-- LAST STEP: ORDER -->
          <div class="pk-step">
            <div class="pk-step__head">
              <span class="pk-step__num" aria-hidden="true"></span>
              <h2 class="pk-step__title">Place your order</h2>
            </div>

            <div style="margin-bottom:1rem; padding:1rem; background:#f9fafb; border-radius:0.75rem; border:1px solid #e5e7eb;">
              <label style="display:flex; align-items:flex-start; gap:0.75rem; cursor:pointer; font-size:0.95rem; line-height:1.5; color:#374151;">
                <input type="checkbox" name="properties[Mockup Request]" id="mockup-request-checkbox" style="width:1.2rem; height:1.2rem; margin-top:0.15rem; flex-shrink:0;">
                <span>Would you like to see a mockup before production? <strong style="color:#a855f7;">Please note:</strong> It takes 24-48 hours.</span>
              </label>
            </div>

            <button type="submit" name="add" class="checkout-btn" style="margin-top:0;">Add to Cart</button>

            <button type="button" id="mockup-quote-btn" class="mockup-quote-btn" onclick="openQuoteModal()">
              Not ready to order? Get Mockup / Quote First
            </button>

            <div style="text-align:center; margin-top:1rem;">
              <a href="/pages/quote" style="color:#a855f7; font-weight:600; font-size:0.95rem; text-decoration:underline;">
                Still confused? Get a free quote!
              </a>
            </div>
          </div>

        </div>
      </form>

      <!-- QUOTE / MOCKUP MODAL -->
      <div id="quote-modal-overlay" class="quote-modal-overlay" onclick="if(event.target===this)closeQuoteModal()">
        <div class="quote-modal">
          <button type="button" class="quote-modal-close" onclick="closeQuoteModal()" aria-label="Close">&times;</button>
          <div id="quote-modal-form-wrap">
            <h3 style="font-size:1.25rem; font-weight:800; margin-bottom:0.25rem;">Get Your Free Quote or Mockup</h3>
            <p style="font-size:0.9rem; color:#6b7280; margin-bottom:1rem;">We'll use the options you've selected on this page. Just tell us how to reach you — no payment needed.</p>
            <div class="quote-modal-fields">
              <div class="row-2" style="gap:0.75rem;">
                <input type="text" id="qm-first-name" class="text-input" placeholder="First name *" required>
                <input type="text" id="qm-last-name" class="text-input" placeholder="Last name">
              </div>
              <input type="email" id="qm-email" class="text-input" placeholder="Email *" required>
              <input type="tel" id="qm-phone" class="text-input" placeholder="Phone (optional)">
              <select id="qm-want" class="text-input">
                <option value="Quote">I want a price quote</option>
                <option value="Design mockup">I want a design mockup (24-48 hrs)</option>
                <option value="Quote + mockup" selected>Both — quote and mockup</option>
              </select>
              <div id="qm-file-note" style="font-size:0.8rem; color:#9333ea; display:none;">✓ Your uploaded design file will be included</div>
              <div id="qm-error" style="font-size:0.85rem; color:#ef4444; display:none;"></div>
              <button type="button" id="qm-submit" class="checkout-btn" style="margin-top:0.25rem;" onclick="submitQuoteModal()">Send My Request</button>
            </div>
          </div>
          <div id="quote-modal-success" style="display:none; text-align:center; padding:1.5rem 0.5rem;">
            <div style="font-size:2.5rem; margin-bottom:0.5rem;">🎉</div>
            <h3 style="font-size:1.2rem; font-weight:800; margin-bottom:0.5rem;">Request received!</h3>
            <p style="font-size:0.95rem; color:#6b7280;">We'll get back to you within 24 hours{% if product.title != blank %} about your {{ product.title | downcase | escape }}{% endif %}. You can close this window.</p>
          </div>
        </div>
      </div>

      <style>
        .mockup-quote-btn {
          display: block;
          width: 100%;
          margin-top: 0.75rem;
          padding: 0.9rem 1rem;
          background: #fff;
          color: #a855f7;
          border: 2px solid #a855f7;
          border-radius: 0.75rem;
          font-weight: 700;
          font-size: 1rem;
          cursor: pointer;
          transition: background 0.15s, color 0.15s;
        }
        .mockup-quote-btn:hover { background: #faf5ff; }
        .quote-modal-overlay {
          display: none;
          position: fixed;
          inset: 0;
          background: rgba(0,0,0,0.55);
          z-index: 9999;
          align-items: center;
          justify-content: center;
          padding: 1rem;
        }
        .quote-modal-overlay.open { display: flex; }
        .quote-modal {
          position: relative;
          background: #fff;
          border-radius: 1rem;
          max-width: 26rem;
          width: 100%;
          padding: 1.5rem;
          box-shadow: 0 20px 50px rgba(0,0,0,0.25);
          max-height: 90vh;
          overflow-y: auto;
        }
        .quote-modal-close {
          position: absolute;
          top: 0.6rem;
          right: 0.9rem;
          background: none;
          border: none;
          font-size: 1.6rem;
          color: #9ca3af;
          cursor: pointer;
          line-height: 1;
        }
        .quote-modal-fields { display: flex; flex-direction: column; gap: 0.7rem; }
        .quote-modal-fields .text-input { width: 100%; }
      </style>

      <script>
        const QUOTE_BACKEND = 'https://patch-kraze-quote-production.up.railway.app';

        function openQuoteModal() {
          const overlay = document.getElementById('quote-modal-overlay');
          overlay.classList.add('open');
          const fileInput = document.getElementById('file-input');
          const note = document.getElementById('qm-file-note');
          if (fileInput && fileInput.files && fileInput.files.length > 0) note.style.display = 'block';
          else note.style.display = 'none';
        }
        function closeQuoteModal() {
          document.getElementById('quote-modal-overlay').classList.remove('open');
        }

        async function submitQuoteModal() {
          const firstName = document.getElementById('qm-first-name').value.trim();
          const email = document.getElementById('qm-email').value.trim();
          const errEl = document.getElementById('qm-error');
          errEl.style.display = 'none';
          if (!firstName || !email || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
            errEl.textContent = 'Please enter your first name and a valid email.';
            errEl.style.display = 'block';
            return;
          }

          const btn = document.getElementById('qm-submit');
          btn.disabled = true;
          btn.textContent = 'Sending...';

          const val = (id) => { const el = document.getElementById(id); return el ? el.value : ''; };
          const want = val('qm-want');
          const notesEl = document.getElementById('design-notes-input');
          const shape = val('shape-input');
          const backing = val('backing-input');

          const infoParts = [
            'Request type: ' + want,
            'Product: {{ product.title | escape }}',
            'Page: ' + window.location.href,
          ];
          if (shape) infoParts.push('Shape: ' + shape);
          const bgColor = val('bg-color-input').trim();
          if (bgColor) infoParts.push('Background color: ' + bgColor);
          const threadColor = val('thread-color-input').trim();
          if (threadColor) infoParts.push('Border color: ' + threadColor);
          if (notesEl && notesEl.value) infoParts.push('Design notes: ' + notesEl.value);

          const fd = new FormData();
          fd.append('first_name', firstName);
          fd.append('last_name', val('qm-last-name'));
          fd.append('email', email);
          fd.append('phone', val('qm-phone'));
          fd.append('patch_type', '{{ product.title | escape }}');
          fd.append('backing_type', backing);
          fd.append('width_inches', val('width-input'));
          fd.append('height_inches', val('height-input'));
          fd.append('quantity', val('qty-input'));
          fd.append('additional_info', infoParts.join('\n'));

          const fileInput = document.getElementById('file-input');
          if (fileInput && fileInput.files && fileInput.files.length > 0) {
            fd.append('design_file', fileInput.files[0]);
          }

          try {
            const res = await fetch(QUOTE_BACKEND + '/quote', { method: 'POST', body: fd });
            const j = await res.json().catch(() => ({}));
            if (!res.ok || !j.ok) throw new Error(j.error || 'Request failed');
            document.getElementById('quote-modal-form-wrap').style.display = 'none';
            document.getElementById('quote-modal-success').style.display = 'block';
          } catch (e) {
            errEl.textContent = 'Something went wrong. Please try again or use our quote page.';
            errEl.style.display = 'block';
          } finally {
            btn.disabled = false;
            btn.textContent = 'Send My Request';
          }
        }
      </script>
    </div>
  </div>
</div>

<script>
  // AJAX Add to Cart - HIGH PRIORITY HANDLER
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('product-form-pk');
    if(!form) return;

    // Override submit with button click handler instead
    const btn = form.querySelector('.checkout-btn');
    if(!btn) return;

    console.log('[Cart Handler] Initialized');

    btn.addEventListener('click', async function(e) {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();

      // Validate form
      if(!form.checkValidity()) {
        form.reportValidity();
        return false;
      }

      // The two color boxes are optional. An empty one is disabled for the
      // moment FormData is read, so the order carries no blank color line.
      const emptyColorInputs = Array.from(form.querySelectorAll('.pk-colors__text'))
        .filter(el => !el.value.trim());
      emptyColorInputs.forEach(el => { el.disabled = true; });
      const formData = new FormData(form);
      emptyColorInputs.forEach(el => { el.disabled = false; });
      const originalText = btn.innerText;

      // Add sections parameter for cart drawer rendering
      const cartItemsComponents = document.querySelectorAll('cart-items-component');
      const sectionIds = [];
      cartItemsComponents.forEach((item) => {
        if (item instanceof HTMLElement && item.dataset.sectionId) {
          sectionIds.push(item.dataset.sectionId);
        }
      });
      if(sectionIds.length > 0) {
        formData.append('sections', sectionIds.join(','));
      }

      btn.disabled = true;
      btn.innerText = 'Adding...';

      // Check if we need to add velcro backing (for all patch products with backing option)
      const backingInput = document.getElementById('backing-input');
      const qtyInput = document.getElementById('qty-input');
      const productHandle = '{{ product.handle }}';
      // Velcro surcharge applies to every product that renders the backing
      // selector - the whole patch template except stickers and DTF transfers.
      const needsVelcroBacking = !productHandle.includes('sticker') &&
                                  productHandle !== 'dtf-transfers' &&
                                  backingInput && backingInput.value.includes('Velcro');
      const patchQty = qtyInput ? parseInt(qtyInput.value) || 1 : 1;

      console.log('[Velcro] Check:', {
        productHandle,
        backingValue: backingInput ? backingInput.value : 'no input',
        needsVelcroBacking,
        patchQty,
        totalVelcroCost: needsVelcroBacking ? (patchQty * 0.25).toFixed(2) : 0
      });

      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          body: formData
        });

        const responseData = await response.json();

        if(response.ok) {
          // Show success immediately - don't wait for background tasks
          btn.innerText = 'Added!';
          setTimeout(() => {
            btn.disabled = false;
            btn.innerText = originalText;
          }, 1500);

          // Open cart drawer immediately
          const cartDrawer = document.querySelector('cart-drawer-component');
          if(cartDrawer) {
            if(typeof cartDrawer.open === 'function') {
              cartDrawer.open();
            } else if(typeof cartDrawer.showDialog === 'function') {
              cartDrawer.showDialog();
            }
          }

          // Background: Add velcro backing if needed (don't block UI)
          if(needsVelcroBacking) {
            console.log('[Velcro] Adding velcro backing in background...');
            (async () => {
              try {
                const velcroRes = await fetch('/products/velcro-backing.js');
                const velcroProduct = await velcroRes.json();
                const velcroVariant = velcroProduct.variants && velcroProduct.variants[0];

                if(velcroVariant) {
                  const velcroFormData = new FormData();
                  velcroFormData.append('id', velcroVariant.id);
                  velcroFormData.append('quantity', patchQty);
                  velcroFormData.append('properties[_added_with]', productHandle);
                  velcroFormData.append('properties[_backing_type]', 'Velcro');
                  velcroFormData.append('properties[_price_per_piece]', '$0.25');

                  const velcroAddRes = await fetch('/cart/add.js', {
                    method: 'POST',
                    body: velcroFormData
                  });

                  if(velcroAddRes.ok) {
                    console.log('[Velcro] Successfully added', patchQty, 'velcro backings');
                  } else {
                    console.error('[Velcro] Failed to add:', await velcroAddRes.text());
                  }
                }
              } catch(velcroError) {
                console.error('[Velcro] Error:', velcroError);
              }
            })();
          }

          // Background: Re-render cart drawer sections and dispatch event
          setTimeout(async () => {
            if (responseData.sections) {
              Object.entries(responseData.sections).forEach(([sectionId, html]) => {
                const el = document.querySelector(`[data-section-id="${sectionId}"]`);
                if (el) {
                  const parser = new DOMParser();
                  const doc = parser.parseFromString(html, 'text/html');
                  const newEl = doc.querySelector(`[data-section-id="${sectionId}"]`);
                  if (newEl) el.innerHTML = newEl.innerHTML;
                }
              });
            }

            try {
              const cartRes = await fetch('/cart.js');
              const cartData = await cartRes.json();
              const cartUpdateEvent = new CustomEvent('cart:update', {
                bubbles: true,
                detail: {
                  resource: cartData,
                  data: {
                    source: 'product-form-component',
                    itemCount: cartData.item_count,
                    sections: responseData.sections || {}
                  }
                }
              });
              document.dispatchEvent(cartUpdateEvent);
            } catch(e) {
              console.error('Cart refresh error:', e);
            }
          }, 100);
        } else {
          throw new Error(responseData.description || 'Failed to add to cart');
        }
      } catch(error) {
        console.error('Cart error:', error);
        btn.innerText = 'Error - Try Again';
        btn.disabled = false;
        alert('Error: ' + error.message);
      }

      return false;
    }, true);

    // Also prevent form submission
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      return false;
    }, true);
  }); // End of DOMContentLoaded
</script>

<script>
  // Zoom Image Functionality
  function zoomImage() {
    // Get currently visible image from gallery
    const scroller = document.getElementById('galleryScroller');
    const slides = scroller.querySelectorAll('.gallery-slide');
    let currentImg = null;

    // Find the slide that's most visible in the viewport
    let maxVisible = 0;
    let activeSlide = null;
    slides.forEach(slide => {
      const rect = slide.getBoundingClientRect();
      const visibleWidth = Math.min(rect.right, scroller.getBoundingClientRect().right) - Math.max(rect.left, scroller.getBoundingClientRect().left);
      if (visibleWidth > maxVisible) {
        maxVisible = visibleWidth;
        activeSlide = slide;
        currentImg = slide.querySelector('img');
      }
    });

    // Don't zoom video/iframe slides
    if (activeSlide && (activeSlide.dataset.mediaType === 'video' || activeSlide.dataset.mediaType === 'external_video')) {
      return;
    }

    // Fallback to mainProductImage if no visible image found
    if (!currentImg) {
      currentImg = document.getElementById('mainProductImage');
    }
    if (!currentImg) return;

    const modal = document.createElement('div');
    modal.style.cssText = `
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.9);
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
      cursor: zoom-out;
    `;

    const zoomedImg = document.createElement('img');
    zoomedImg.src = currentImg.src.replace(/width=\d+/, 'width=2000');
    zoomedImg.style.cssText = `
      max-width: 95%;
      max-height: 95%;
      object-fit: contain;
      border-radius: 0.5rem;
    `;

    const closeBtn = document.createElement('button');
    closeBtn.innerHTML = `
      <svg width="32" height="32" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    `;
    closeBtn.style.cssText = `
      position: absolute;
      top: 1rem;
      right: 1rem;
      background: rgba(0, 0, 0, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 50%;
      width: 3rem;
      height: 3rem;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.2s;
    `;
    closeBtn.onmouseover = () => closeBtn.style.background = 'rgba(0, 0, 0, 0.8)';
    closeBtn.onmouseout = () => closeBtn.style.background = 'rgba(0, 0, 0, 0.5)';

    const closeModal = () => document.body.removeChild(modal);
    modal.onclick = closeModal;
    closeBtn.onclick = closeModal;

    modal.appendChild(zoomedImg);
    modal.appendChild(closeBtn);
    document.body.appendChild(modal);
  }
</script>

