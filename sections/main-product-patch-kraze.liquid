    const PRICING_MATRIX = METAFIELD_MATRIX || FALLBACK_MATRIX;
    if (!METAFIELD_MATRIX) {
      console.error('[Pricing] No custom.prices metafield for "' + PRODUCT_HANDLE + '" -- falling back to LEGACY 2025 embroidered prices. Displayed prices will not match charged variant prices until the metafield and variants are seeded.');
    }

    // Helper: Find size bracket index
    function getSizeBracketIndex(avgSize) {
      for(let i = 0; i < PRICING_MATRIX.sizeBrackets.length; i++) {
        if(avgSize <= PRICING_MATRIX.sizeBrackets[i]) {
          return i;
        }
      }
      return PRICING_MATRIX.sizeBrackets.length - 1; // Max bracket
    }

    // Helper: Find quantity tier
    function getQuantityTier(qty) {
      for(let tier of PRICING_MATRIX.quantityTiers) {
        if(qty >= tier.min && qty <= tier.max) {
          return tier;
        }
      }
      return PRICING_MATRIX.quantityTiers[0]; // Default to first tier
    }

    // Helper: Lookup exact price from matrix
    function lookupPrice(avgSize, qty) {
      // Handle sticker products differently
      if (PRICING_MATRIX.type === 'stickers') {
        const qtyTier = PRICING_MATRIX.quantityTiers.find(t => qty >= t.min && qty <= t.max);
        if (!qtyTier) return PRICING_MATRIX.basePrice;

        // Calculate style number (1-20)
        const styleNum = Math.ceil(avgSize / 5); // Styles are groups of 5 (1-5, 6-10, etc.)
        const styleMultiplier = 1 + (styleNum - 1) * (PRICING_MATRIX.pricePerStyle / PRICING_MATRIX.basePrice);

        return PRICING_MATRIX.basePrice * styleMultiplier * qtyTier.multiplier;
      }

      // Regular patch pricing
      const sizeIdx = getSizeBracketIndex(avgSize);
      const qtyTier = getQuantityTier(qty);
      return qtyTier.prices[sizeIdx];
    }

    const fileInput = document.getElementById('file-input');
    const uploadStage = document.getElementById('upload-stage');
    const customizeStage = document.getElementById('customize-stage');
    const qtyInput = document.getElementById('qty-input');
    const totalDisplay = document.getElementById('total-price-display');
    const headerPrice = document.getElementById('header-price');
    const pricingRows = document.querySelectorAll('.pricing-row');
    const variantInput = document.getElementById('real-variant-id');

    // Make functions safe if elements missing
    if (!fileInput) return;

    // Product-specific minimum quantity overrides (default is 10 for all)
    const minQtyLabels = {
      // Sticker products require a minimum of 25
      'custom-vinyl-stickers': 25,
      'holographic-stickers': 25,
      'uv-transparent-stickers': 25,
      'custom-stickers': 25
    };
    const productMinQty = minQtyLabels[PRODUCT_HANDLE] || 10;

    // Update the minimum-order wording if different from the default HTML
    const minFact = document.getElementById('pk-min-fact');
    if(minFact && productMinQty !== 10) {
      minFact.innerText = `Order from ${productMinQty} pieces`;
    }

    const qtyError = document.getElementById('qty-error');
    if(qtyError && productMinQty !== 10) {
      qtyError.innerText = `Please order at least ${productMinQty} pieces.`;
    }

    const qtyMinLabel = document.getElementById('qty-min-label');
    if(qtyMinLabel && productMinQty !== 10) {
      qtyMinLabel.innerText = `Minimum order: ${productMinQty}`;
    }

    // Sync qty input min attribute and bump value if below minimum.
    // Always set it: the static markup ships min="1", which would let
    // below-minimum quantities pass checkValidity() on add-to-cart.
    if(qtyInput) {
      qtyInput.min = productMinQty;
      const currentVal = parseInt(qtyInput.value) || 0;
      if(currentVal < productMinQty) qtyInput.value = productMinQty;
    }

    // Update pricing row labels if different from default HTML
    if(productMinQty !== 10) {
      const firstPricingRow = document.querySelector('.pricing-row[data-min="10"]');
      if(firstPricingRow) {
        firstPricingRow.dataset.min = productMinQty;
        const qtyLabel = firstPricingRow.querySelector('span:first-child');
        if(qtyLabel) {
          qtyLabel.innerText = `${productMinQty}-49 pcs`;
        }
      }
    }

    // Rebuild pricing rows from the matrix when the tier count differs from the
    // static 6-row markup (e.g. products with an added 10-24 tier).
    if (PRICING_MATRIX.type !== 'stickers' && PRICING_MATRIX.quantityTiers &&
        PRICING_MATRIX.quantityTiers.length !== 6) {
      const card = document.querySelector('.pricing-card');
      if (card) {
        const header = card.querySelector('.pricing-header');
        card.querySelectorAll('.pricing-row').forEach(r => r.remove());
        PRICING_MATRIX.quantityTiers.forEach((tier, idx) => {
          const rowMin = idx === 0 ? Math.min(tier.min, productMinQty) : tier.min;
          // A tier covering a single quantity reads as "10 pcs", not "10-10 pcs".
          const label = tier.max >= 999999
            ? `${tier.min}+ pcs`
            : (rowMin === tier.max ? `${rowMin} pcs` : `${rowMin}-${tier.max} pcs`);
          const row = document.createElement('div');
          row.className = 'pricing-row';
          row.dataset.min = rowMin;
          row.dataset.max = tier.max;
          row.innerHTML = `<div class="pricing-row__cols"><span>${label}</span><span id="price-tier-${idx + 1}">Calculating...</span><span id="discount-tier-${idx + 1}">${idx === 0 ? 'Base' : '...'}</span></div><div class="pricing-row__msg" id="tier-msg-${idx + 1}"></div>`;
          card.appendChild(row);
        });
      }
    }

    // File Preview
    fileInput.addEventListener('change', function() {
      if(this.files && this.files.length > 0) {
         console.log('[File Upload] File selected:', this.files[0].name);
         const file = this.files[0];
         const isImage = file.type && file.type.indexOf('image/') === 0;
         const nameDisplay = document.getElementById('filename-display');
         if(nameDisplay) nameDisplay.innerText = file.name;

         // A genuine new upload (not an AI-edit dispatching a synthetic change
         // event) resets the AI edit state - a stale bg-removed cache or
         // "on" toggle from the last file must not silently carry over.
         if (!isApplyingAiEdit) {
           originalFile = file;
           bgRemovedFile = null;
           setToggleState('pk-toggle-removebg', false);
           clearColorSuggestions();
         }
         isApplyingAiEdit = false;

         // PDFs have nothing to crop / remove background from - hide the
         // image-only stage and AI toolbar rather than showing dead controls.
         const stage = document.querySelector('.pk-preview-stage');
         const toolbar = document.querySelector('.pk-ai-toolbar');
         if (stage) stage.style.display = isImage ? 'flex' : 'none';
         if (toolbar) toolbar.style.display = isImage ? 'flex' : 'none';
         const aiNote = document.getElementById('pk-ai-note');
         if (aiNote) aiNote.style.display = 'none';

         const reader = new FileReader();
         reader.onload = function(e){
             const pvImg = document.getElementById('pk-preview-img');
             if (pvImg) pvImg.src = e.target.result;
             if (isImage) {
               measureArtwork(file).then(function(m) {
                 setSizeFromArtwork(m.w, m.h, m.trimmed);
                 updateArtworkPreview();
               }).catch(function() {
                 // Undecodable image: leave the size alone rather than guessing.
                 showArtworkFallback();
               });
             }
         }
         reader.readAsDataURL(file);

         // Show the artwork panel, collapse the upload box
         if(uploadStage) {
           console.log('[File Upload] Hiding upload stage');
           uploadStage.style.display = 'none';
         }
         const artworkPanel = document.getElementById('pk-artwork-panel');
         if(artworkPanel) artworkPanel.classList.add('active');
      }
    });

    window.resetUpload = function() {
      if(fileInput) fileInput.value = '';
      if(uploadStage) uploadStage.style.display = 'block';
      const artworkPanel = document.getElementById('pk-artwork-panel');
      if(artworkPanel) artworkPanel.classList.remove('active');

      // Fresh upload, fresh state - a stale ratio/crop lock from the last
      // file must not carry over and silently resize the next one.
      artworkRatio = null;
      ratioLocked = false;
      lastArtworkNat = null;
      lastArtworkTrim = null;
      originalFile = null;
      bgRemovedFile = null;
      setToggleState('pk-toggle-removebg', false);
      clearColorSuggestions();
      const sizeNote = document.getElementById('artwork-size-note');
      if (sizeNote) sizeNote.style.display = 'none';
      const dpiWarn = document.getElementById('artwork-dpi-warning');
      if (dpiWarn) dpiWarn.style.display = 'none';
      const aiNote = document.getElementById('pk-ai-note');
      if (aiNote) aiNote.style.display = 'none';
    }

    // --- Preview toolbar: zoom, crop toggle, remove-bg / edit-with-AI -------
    window.zoomArtwork = function() {
      const img = document.getElementById('pk-preview-img');
      if (!img || !img.src) return;
      const modal = document.createElement('div');
      modal.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.9);z-index:9999;display:flex;align-items:center;justify-content:center;padding:2rem;cursor:zoom-out;';
      const zoomedImg = document.createElement('img');
      zoomedImg.src = img.src;
      zoomedImg.style.cssText = 'max-width:95%;max-height:95%;object-fit:contain;border-radius:0.5rem;background:#fff;';
      const closeBtn = document.createElement('button');
      closeBtn.innerHTML = '<svg width="32" height="32" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12"/></svg>';
      closeBtn.style.cssText = 'position:absolute;top:1rem;right:1rem;background:rgba(0,0,0,0.5);border:1px solid rgba(255,255,255,0.2);border-radius:50%;width:3rem;height:3rem;display:flex;align-items:center;justify-content:center;cursor:pointer;';
      const closeModal = () => document.body.removeChild(modal);
      modal.onclick = closeModal;
      closeBtn.onclick = closeModal;
      modal.appendChild(zoomedImg);
      modal.appendChild(closeBtn);
      document.body.appendChild(modal);
    };

    function setToggleState(id, on) {
      const el = document.getElementById(id);
      if (!el) return;
      el.classList.toggle('on', on);
      el.setAttribute('aria-checked', String(on));
    }

    // Crop trims transparent/near-white padding before sizing the patch -
    // exactly what measureArtwork() already does; this just lets the
    // customer opt out and see the untrimmed shape instead.
    window.pkToggleCrop = function() {
      cropEnabled = !cropEnabled;
      setToggleState('pk-toggle-crop', cropEnabled);
      if (!lastArtworkNat) return;
      const active = activeArtworkDims();
      if (ratioLocked) {
        setSizeFromArtwork(active.w, active.h, active.trimmed);
        updateArtworkPreview();
      } else {
        artworkRatio = active.w / active.h;   // remembered for "match shape again"
      }
    };

    // Background removal and Edit with AI both call quote-backend's
    // /edit-image (OpenAI gpt-image-1 edit) with the current file + a prompt.
    function pkShowAiNote(html, isError) {
      const note = document.getElementById('pk-ai-note');
      if (!note) return;
      note.innerHTML = html;
      note.style.display = 'flex';
      note.classList.toggle('pk-ai-note--error', !!isError);
    }

    // Same note element, but with a spinner - the 10-30s wait needs a visible
    // sign of active progress, not just dimmed buttons and static text.
    function pkShowAiLoading(text) {
      pkShowAiNote(`<span class="pk-ai-spinner"></span><span><strong>${text}</strong> usually takes 10&ndash;30 seconds.</span>`, false);
    }

    function pkSetAiBusy(busy) {
      const toolbar = document.querySelector('.pk-ai-toolbar');
      if (toolbar) toolbar.classList.toggle('pk-ai-toolbar--busy', busy);
      const removeBgToggle = document.getElementById('pk-toggle-removebg');
      const editBtn = document.querySelector('.pk-edit-ai-btn');
      if (removeBgToggle) removeBgToggle.style.pointerEvents = busy ? 'none' : '';
      if (editBtn) editBtn.disabled = busy;
    }

    async function pkCallEditImage(file, prompt) {
      const fd = new FormData();
      fd.append('image', file, file.name || 'design.png');
      fd.append('prompt', prompt);
      const r = await fetch(AI_BACKEND_URL + '/edit-image', { method: 'POST', body: fd });
      const j = await r.json().catch(() => ({}));
      if (!r.ok || !j.ok) throw new Error(j.error || 'The AI edit failed. Please try again.');
      return j.image; // data:image/png;base64,...
    }

    // Swaps a File directly into fileInput and replays the same 'change'
    // handler that a real file-picker selection triggers (preview, artwork
    // measurement, size sync) instead of duplicating that logic here.
    function pkSwapInFile(file) {
      const dt = new DataTransfer();
      dt.items.add(file);
      isApplyingAiEdit = true;
      fileInput.files = dt.files;
      fileInput.dispatchEvent(new Event('change'));
    }

    async function pkDataUrlToFile(dataUrl, suffix) {
      const blob = await (await fetch(dataUrl)).blob();
      const baseName = ((originalFile && originalFile.name) || 'design').replace(/\.[^.]+$/, '');
      return new File([blob], `${baseName}-${suffix}.png`, { type: 'image/png' });
    }

    function pkHideAiNote() {
      const note = document.getElementById('pk-ai-note');
      if (note) note.style.display = 'none';
    }

    window.pkToggleRemoveBg = async function() {
      if (!originalFile) return;
      const el = document.getElementById('pk-toggle-removebg');
      const turningOn = el ? !el.classList.contains('on') : true;

      if (!turningOn) {
        setToggleState('pk-toggle-removebg', false);
        pkHideAiNote();
        pkSwapInFile(originalFile);
        return;
      }

      if (!AI_BACKEND_URL) {
        setToggleState('pk-toggle-removebg', false);
        pkShowAiNote('<strong>Background removal isn&rsquo;t configured yet.</strong> Add a note below and our designers will handle it.', true);
        return;
      }

      setToggleState('pk-toggle-removebg', true);
      if (bgRemovedFile) {
        pkHideAiNote();
        pkSwapInFile(bgRemovedFile);
        return;
      }

      pkSetAiBusy(true);
      pkShowAiLoading('Removing the background&hellip;');
      try {
        const image = await pkCallEditImage(
          originalFile,
          'Remove the background from this image entirely and make it fully transparent. ' +
          'Keep the main subject exactly as-is: same position, size, colors, and details - only the background changes.'
        );
        const newFile = await pkDataUrlToFile(image, 'no-bg');
        bgRemovedFile = newFile;
        pkHideAiNote();
        pkSwapInFile(newFile);
      } catch (e) {
        setToggleState('pk-toggle-removebg', false);
        pkShowAiNote(`<strong>Background removal failed.</strong> ${e.message || 'Please try again.'}`, true);
      } finally {
        pkSetAiBusy(false);
      }
    };

    // "Edit with AI" opens an inline prompt box in place of the button
    // instead of a blocking window.prompt() dialog.
    window.pkToggleAiPromptBox = function(force) {
      if (!fileInput.files || !fileInput.files[0]) return;
      const box = document.getElementById('pk-ai-prompt-box');
      const input = document.getElementById('pk-ai-prompt-input');
      if (!box) return;
      const show = typeof force === 'boolean' ? force : box.style.display === 'none';

      if (show && !AI_BACKEND_URL) {
        pkShowAiNote('<strong>AI editing isn&rsquo;t configured yet.</strong> Tell us what you&rsquo;d like changed in a note below and our designers will make the edit by hand.', true);
        return;
      }

      box.style.display = show ? 'flex' : 'none';
      if (show && input) {
        input.focus();
      } else if (input) {
        input.value = '';
      }
    };

    window.pkSubmitAiEdit = async function() {
      if (!fileInput.files || !fileInput.files[0]) return;
      const input = document.getElementById('pk-ai-prompt-input');
      const prompt = input ? input.value.trim() : '';
      if (!prompt) { if (input) input.focus(); return; }

      pkToggleAiPromptBox(false);
      pkSetAiBusy(true);
      pkShowAiLoading('Applying your edit&hellip;');
      try {
        const image = await pkCallEditImage(fileInput.files[0], prompt);
        const newFile = await pkDataUrlToFile(image, 'edited');
        pkHideAiNote();
        pkSwapInFile(newFile);
      } catch (e) {
        pkShowAiNote(`<strong>AI edit failed.</strong> ${e.message || 'Please try again.'}`, true);
      } finally {
        pkSetAiBusy(false);
      }
    };

    const widthInput = document.getElementById('width-input');
    const heightInput = document.getElementById('height-input');
    const unitPriceDisplay = document.getElementById('unit-price-display');
    const calculatedSizeDisplay = document.getElementById('calculated-size-display');
    const sizeFormulaDisplay = document.getElementById('size-formula-display');

    // --- Artwork-driven sizing ------------------------------------------------
    // The uploaded design's aspect ratio drives both size inputs, so a square
    // logo can't be ordered as 2" x 10". Price uses (W+H)/2, which only reads
    // sensibly when the shape matches the artwork it will be made from.
    let artworkRatio = null;   // intrinsic width / height of the uploaded image
    let ratioLocked = false;
    let lastArtworkNat = null;   // {w,h} full decoded pixel size of the last upload
    let lastArtworkTrim = null;  // {w,h} trimmed bounding box, or null if not meaningfully smaller
    let originalFile = null;      // file as the customer actually uploaded, pre-AI-edit
    let bgRemovedFile = null;     // cached result so toggling off/on doesn't re-call the API
    let isApplyingAiEdit = false; // true only while we're programmatically swapping fileInput.files
    let cropEnabled = true;      // Crop toggle: prefer the trimmed box when one exists

    function activeArtworkDims() {
      if (!lastArtworkNat) return null;
      if (cropEnabled && lastArtworkTrim) return { w: lastArtworkTrim.w, h: lastArtworkTrim.h, trimmed: true };
      return { w: lastArtworkNat.w, h: lastArtworkNat.h, trimmed: false };
    }

    // Decode with EXIF orientation applied. Phone photos carry a rotation flag;
    // reading raw pixel dimensions gives a sideways aspect ratio without it.
    function decodeArtwork(file) {
      if (window.createImageBitmap) {
        try {
          return createImageBitmap(file, { imageOrientation: 'from-image' })
            .catch(function() { return decodeViaImg(file); });
        } catch (e) { /* older browsers ignore the options arg */ }
      }
      return decodeViaImg(file);
    }
    function decodeViaImg(file) {
      return new Promise(function(res, rej) {
        const img = new Image();
        const url = URL.createObjectURL(file);
        img.onload = function() { res(img); };
        img.onerror = function() { URL.revokeObjectURL(url); rej(new Error('decode failed')); };
        img.src = url;
      });
    }

    // Bounding box of the actual design, ignoring transparent or near-white
    // padding. A logo centred in a square export is square by pixel count but
    // often a wide design - sizing to the canvas gets the patch shape wrong.
    function artworkBounds(src, w, h) {
      const MAX = 400;                       // sampling cap; bounds only need to be close
      const scale = Math.min(1, MAX / Math.max(w, h));
      const cw = Math.max(1, Math.round(w * scale)), ch = Math.max(1, Math.round(h * scale));
      const c = document.createElement('canvas');
      c.width = cw; c.height = ch;
      const ctx = c.getContext('2d', { willReadFrequently: true });
      if (!ctx) return null;
      ctx.drawImage(src, 0, 0, cw, ch);
      let d;
      try { d = ctx.getImageData(0, 0, cw, ch).data; } catch (err) { return null; }
      let minX = cw, minY = ch, maxX = -1, maxY = -1;
      for (let y = 0; y < ch; y++) {
        for (let x = 0; x < cw; x++) {
          const i = (y * cw + x) * 4;
          if (d[i + 3] < 16) continue;                                   // transparent
          if (d[i] > 244 && d[i + 1] > 244 && d[i + 2] > 244) continue;  // near-white
          if (x < minX) minX = x;
          if (x > maxX) maxX = x;
          if (y < minY) minY = y;
          if (y > maxY) maxY = y;
        }
      }
      if (maxX < 0) return null;             // fully blank / all-white
      return { w: Math.round((maxX - minX + 1) / scale),
               h: Math.round((maxY - minY + 1) / scale) };
    }

    function measureArtwork(file) {
      return Promise.resolve(decodeArtwork(file)).then(function(src) {
        const natW = src.width || src.naturalWidth;
        const natH = src.height || src.naturalHeight;
        if (!natW || !natH) throw new Error('no dimensions');
        const b = artworkBounds(src, natW, natH);
        // Only prefer the trimmed box when it is meaningfully smaller, so noise
        // or a faint border does not nudge the shape around.
        const meaningfullyTrimmed = !!(b && (b.w / natW < 0.92 || b.h / natH < 0.92));
        lastArtworkNat = { w: natW, h: natH };
        lastArtworkTrim = meaningfullyTrimmed ? { w: b.w, h: b.h } : null;
        return activeArtworkDims();
      });
    }

    function showArtworkFallback() {
      const note = document.getElementById('artwork-size-note');
      const detail = document.getElementById('artwork-size-detail');
      if (!note || !detail) return;
      detail.innerHTML = "We couldn't read this file's dimensions, so please set the width and height yourself. ";
      const unlock = document.getElementById('artwork-size-unlock');
      if (unlock) unlock.style.display = 'none';
      note.style.display = 'flex';
    }

    function snapSize(v) {
      const step = PRODUCT_CONFIG.step || 0.5;
      let s = Math.round(v / step) * step;
      if (s < PRODUCT_CONFIG.minSize) s = PRODUCT_CONFIG.minSize;
      if (s > PRODUCT_CONFIG.maxSize) s = PRODUCT_CONFIG.maxSize;
      return s;
    }

    // Largest patch matching `ratio` that still fits the product's size limits.
    function fitRatio(ratio) {
      const min = PRODUCT_CONFIG.minSize, max = PRODUCT_CONFIG.maxSize;
      const target = PRODUCT_CONFIG.defaultSize || 2.0;
      let w, h;
      if (ratio >= 1) { w = target; h = target / ratio; }
      else            { h = target; w = target * ratio; }
      const shortest = Math.min(w, h);
      if (shortest < min) { const k = min / shortest; w *= k; h *= k; }
      const longest = Math.max(w, h);
      if (longest > max) { const k = max / longest; w *= k; h *= k; }
      return { w: snapSize(w), h: snapSize(h) };
    }

    // The preview frame takes the patch's proportions, so what the customer sees
    // is the shape they will actually receive - it re-shapes as they resize.
    function updateArtworkPreview() {
      const stage = document.querySelector('.pk-preview-stage');
      const frame = document.getElementById('pk-preview-frame');
      const dims = document.getElementById('pk-preview-dims');
      if (!frame || !widthInput || !heightInput) return;
      const w = parseFloat(widthInput.value) || 1, h = parseFloat(heightInput.value) || 1;
      const longest = Math.max(w, h);
      // Fill the stage (minus its own padding) up to a sensible cap, instead
      // of a fixed px guess that no longer matched the panel's real size.
      const cap = 320;
      const available = stage ? Math.max(120, stage.clientWidth - 40) : cap;
      const px = Math.min(cap, available);
      frame.style.width  = Math.round(px * (w / longest)) + 'px';
      frame.style.height = Math.round(px * (h / longest)) + 'px';
      if (dims) {
        const f = (n) => n.toFixed(2).replace(/\.00$/, '');
        dims.textContent = f(w) + '" \u00d7 ' + f(h) + '" \u00b7 shown in proportion';
      }
    }

    // Keep the opposite axis in proportion when one axis is driven.
    function applyRatio(driver) {
      if (!ratioLocked || !artworkRatio || !widthInput || !heightInput) return;
      if (driver === 'width') {
        heightInput.value = snapSize(parseFloat(widthInput.value) / artworkRatio).toFixed(2);
      } else {
        widthInput.value = snapSize(parseFloat(heightInput.value) * artworkRatio).toFixed(2);
      }
    }

    function setSizeFromArtwork(pxW, pxH, trimmed) {
      if (!pxW || !pxH || !widthInput || !heightInput) return;
      artworkRatio = pxW / pxH;
      const fit = fitRatio(artworkRatio);
      widthInput.value = fit.w.toFixed(2);
      heightInput.value = fit.h.toFixed(2);
      ratioLocked = true;

      const note = document.getElementById('artwork-size-note');
      const detail = document.getElementById('artwork-size-detail');
      if (note && detail) {
        // Snapping to 0.5" steps can't always hold the exact ratio - say so
        // rather than letting the customer discover it on the proof.
        const got = fit.w / fit.h;
        const off = Math.abs(got - artworkRatio) / artworkRatio > 0.08;
        // Effective print resolution at the size we just chose.
        const dpi = Math.min(pxW / fit.w, pxH / fit.h);
        detail.innerHTML = (trimmed ? 'Ignoring the blank space around it, your' : 'Your')
          + ' design is ' + pxW + '&times;' + pxH + 'px, so we set '
          + '<strong>' + fit.w.toFixed(2).replace(/\.00$/, '') + '&quot; &times; '
          + fit.h.toFixed(2).replace(/\.00$/, '') + '&quot;</strong> to match its shape. '
          + (off ? 'Sizes step in ' + (PRODUCT_CONFIG.step || 0.5) + '&quot;, so this is the closest fit. ' : '')
          + 'Changing one side now adjusts the other. ';
        note.style.display = 'flex';

        // Low-resolution artwork stitches badly; say so before they order.
        const dpiWarn = document.getElementById('artwork-dpi-warning');
        if (dpiWarn) {
          if (dpi < 150) {
            dpiWarn.innerHTML = '<strong>Heads up:</strong> at this size your file works out to about '
              + Math.round(dpi) + ' DPI. Under 150 DPI can look soft or jagged &mdash; a larger file, '
              + 'or a smaller patch, will reproduce better.';
            dpiWarn.style.display = 'flex';
          } else {
            dpiWarn.style.display = 'none';
          }
        }
      }
      updatePriceAndVariant();
    }

    const unlockLink = document.getElementById('artwork-size-unlock');
    if (unlockLink) {
      unlockLink.addEventListener('click', function(e) {
        e.preventDefault();
        if (!artworkRatio) return;
        ratioLocked = !ratioLocked;
        unlockLink.textContent = ratioLocked
          ? 'Set width & height separately'
          : "Match my design's shape again";
        if (ratioLocked) {          // snap back to the artwork's proportions
          const fit = fitRatio(artworkRatio);
          widthInput.value = fit.w.toFixed(2);
          heightInput.value = fit.h.toFixed(2);
          updateArtworkPreview();
          updatePriceAndVariant();
        }
      });
    }

    // Stepper Logic with dynamic min/max from product config
    window.stepSize = function(type, delta) {
      const el = type === 'width' ? widthInput : heightInput;
      if(!el) return;
      let val = parseFloat(el.value) || PRODUCT_CONFIG.defaultSize;
      val += delta;
      if(val < PRODUCT_CONFIG.minSize) val = PRODUCT_CONFIG.minSize;
      if(val > PRODUCT_CONFIG.maxSize) val = PRODUCT_CONFIG.maxSize;
      el.value = val.toFixed(2);
      applyRatio(type);
      updateArtworkPreview();
      updatePriceAndVariant();
    };

    // Typing a size directly never recalculated the price - only the +/- buttons
    // were wired up.
    [['width', widthInput], ['height', heightInput]].forEach(function(pair) {
      const name = pair[0], el = pair[1];
      if (!el) return;
      el.addEventListener('input', updatePriceAndVariant);
      el.addEventListener('change', function() {
        const v = parseFloat(el.value);
        el.value = (isNaN(v) ? PRODUCT_CONFIG.defaultSize : snapSize(v)).toFixed(2);
        applyRatio(name);
        updateArtworkPreview();
        updatePriceAndVariant();
      });
    });

    // Apply product-specific defaults to inputs on load
    if(widthInput) {
      const defSize = PRODUCT_CONFIG.defaultSize || 2.0;
      widthInput.value = defSize.toFixed(2);
      widthInput.min = PRODUCT_CONFIG.minSize || 1.0;
      widthInput.max = PRODUCT_CONFIG.maxSize || 12.0;
      widthInput.step = PRODUCT_CONFIG.step || 0.5;
    }
    if(heightInput) {
      const defSize = PRODUCT_CONFIG.defaultSize || 2.0;
      heightInput.value = defSize.toFixed(2);
      heightInput.min = PRODUCT_CONFIG.minSize || 1.0;
      heightInput.max = PRODUCT_CONFIG.maxSize || 12.0;
      heightInput.step = PRODUCT_CONFIG.step || 0.5;
    }

    // Check if this is a sticker product
    const IS_STICKER = PRODUCT_HANDLE.includes('sticker');

    // Sticker/transfer wording for the size labels is rendered in Liquid.
    if (IS_STICKER) {
      // Hide the 6th pricing tier row (stickers only have 5 tiers)
      const tier6 = document.querySelector('.pricing-row[data-min="1000"]');
      if (tier6) tier6.style.display = 'none';
    }

    // Sticker style brackets (based on square inches: width * height)
    function getStickerStyleBracket(w, h) {
      const sqInches = w * h;
      // Style #1-5: 1-5 sq inches (1x1 to ~2.2x2.2)
      // Style #6-10: 6-10 sq inches
      // etc.
      if (sqInches <= 5) return '1-5';
      if (sqInches <= 10) return '6-10';
      if (sqInches <= 15) return '11-15';
      if (sqInches <= 20) return '16-20';
      if (sqInches <= 25) return '21-25';
      if (sqInches <= 30) return '26-30';
      if (sqInches <= 35) return '31-35';
      if (sqInches <= 40) return '36-40';
      if (sqInches <= 45) return '41-45';
      if (sqInches <= 50) return '46-50';
      if (sqInches <= 55) return '51-55';
      if (sqInches <= 60) return '56-60';
      if (sqInches <= 65) return '61-65';
      if (sqInches <= 70) return '66-70';
      if (sqInches <= 75) return '71-75';
      if (sqInches <= 80) return '76-80';
      if (sqInches <= 85) return '81-85';
      if (sqInches <= 90) return '86-90';
      if (sqInches <= 95) return '91-95';
      return '96-100';
    }

    // Sticker quantity tier
    function getStickerQtyTier(qty) {
      // qty below 25 falls into first tier (25-49) since CSV has no smaller bucket
      if (qty <= 49) return '25-49';
      if (qty <= 99) return '50-99';
      if (qty <= 249) return '100-249';
      if (qty <= 499) return '250-499';
      return '500+';
    }

    // Smart Pricing + Variant Selector using Matrix
    // Upsell nudge: shown only in the row the customer's current qty falls
    // into, naming how many more pieces reach the next tier's discount.
    function updateTierMsg(idx, qty, nextPctOff) {
      const tierEl = document.getElementById(`price-tier-${idx + 1}`);
      const row = tierEl ? tierEl.closest('.pricing-row') : null;
      const msgEl = document.getElementById(`tier-msg-${idx + 1}`);
      if (!row || !msgEl) return;
      const rowMin = parseInt(row.dataset.min, 10), rowMax = parseInt(row.dataset.max, 10);
      const isActive = qty >= rowMin && qty <= rowMax;
      const nextTierEl = document.getElementById(`price-tier-${idx + 2}`);
      const nextRow = nextTierEl ? nextTierEl.closest('.pricing-row') : null;
      if (isActive && nextRow && nextPctOff > 0) {
        const need = parseInt(nextRow.dataset.min, 10) - qty;
        if (need > 0) {
          msgEl.innerHTML = `Order <b>${need}</b> more to unlock ${nextPctOff}% off the base price.`;
          msgEl.classList.add('show');
          return;
        }
      }
      msgEl.classList.remove('show');
    }

    function updatePriceAndVariant() {
      if(!qtyInput) return;
      let qty = parseInt(qtyInput.value) || productMinQty;

      // Show error if qty < minimum
      const qtyError = document.getElementById('qty-error');
      if(qty < productMinQty) {
        if(qtyError) qtyError.style.display = 'block';
        return; // Don't update prices
      } else {
        if(qtyError) qtyError.style.display = 'none';
      }

      // Calculate Size: (W + H) / 2 for patches, max(W, H) for DTF
      let w = parseFloat(widthInput ? widthInput.value : 2) || 2;
      let h = parseFloat(heightInput ? heightInput.value : 2) || 2;
      let avgSize = PRODUCT_HANDLE === 'dtf-transfers' ? (w * h) : (w + h) / 2;

      // Handle STICKER products differently
      if (IS_STICKER) {
        console.log('[STICKER MODE] Product:', PRODUCT_HANDLE, 'Variants count:', shopifyVariants.length);

        // Update Size Text for stickers
        if(calculatedSizeDisplay) {
          calculatedSizeDisplay.innerText = `${w.toFixed(2).replace(/\.00$/, '')}" x ${h.toFixed(2).replace(/\.00$/, '')}"`;
        }
        if(sizeFormulaDisplay) sizeFormulaDisplay.innerText = '';

        // If no variants, show error
        if (!shopifyVariants || shopifyVariants.length === 0) {
          console.error('[STICKER ERROR] No variants found! CSV must be uploaded to Shopify.');
          if(unitPriceDisplay) unitPriceDisplay.innerHTML = '<span style="color: #ef4444;">Product not configured</span>';
          if(totalDisplay) totalDisplay.innerText = '$0.00';
          return;
        }

        const styleBracket = getStickerStyleBracket(w, h);
        const qtyTier = getStickerQtyTier(qty);
        const searchPattern = `Style #${styleBracket} - ${qtyTier}`;

        // ----- Sync pricing table with CSV-uploaded variant prices (single source of truth) -----
        // CSV tiers: 25-49, 50-99, 100-249, 250-499, 500+
        const stickerTierDefs = [
          { min: productMinQty, max: 49,     label: '25-49 pcs',   suffix: '25-49' },
          { min: 50,            max: 99,     label: '50-99 pcs',   suffix: '50-99' },
          { min: 100,           max: 249,    label: '100-249 pcs', suffix: '100-249' },
          { min: 250,           max: 499,    label: '250-499 pcs', suffix: '250-499' },
          { min: 500,           max: 999999, label: '500+ pcs',    suffix: '500+' }
        ];
        const baseVariantForStyle = shopifyVariants.find(v => v.option1 && v.option1.includes(`Style #${styleBracket} - 25-49`));
        const stickerBasePrice = baseVariantForStyle ? parseFloat(baseVariantForStyle.price) / 100 : 0;
        const allStickerRows = document.querySelectorAll('.pricing-card .pricing-row');
        allStickerRows.forEach((row, idx) => {
          const def = stickerTierDefs[idx];
          if (!def) {
            row.style.display = 'none';
            return;
          }
          row.style.display = '';
          row.dataset.min = def.min;
          row.dataset.max = def.max;
          const labelEl = row.querySelector('span:first-child');
          if (labelEl) labelEl.textContent = def.label;
          const tierVariant = shopifyVariants.find(v => v.option1 && v.option1.includes(`Style #${styleBracket} - ${def.suffix}`));
          const tierPriceEl = document.getElementById(`price-tier-${idx + 1}`);
          const tierDiscountEl = document.getElementById(`discount-tier-${idx + 1}`);
          if (tierVariant && tierPriceEl) {
            const tierPrice = parseFloat(tierVariant.price) / 100;
            tierPriceEl.textContent = '$' + tierPrice.toFixed(2) + ' ea';
            if (tierDiscountEl) {
              if (idx === 0) {
                tierDiscountEl.textContent = 'Base';
              } else if (stickerBasePrice > 0) {
                const pctOff = Math.round((1 - tierPrice / stickerBasePrice) * 100);
                tierDiscountEl.textContent = pctOff > 0 ? `Save ${pctOff}%` : 'Base';
              }
            }
          }
        });

        console.log('[Sticker Variant Search]', { w, h, styleBracket, qty, qtyTier, searchPattern });
        console.log('[Available Variants]', shopifyVariants.map(v => ({ title: v.title, option1: v.option1, price: v.price, id: v.id })));

        // Try matching by option1 first (for CSV-imported products), then by title
        let selectedVariant = shopifyVariants.find(v =>
          v.option1 && v.option1.includes(searchPattern)
        );

        // Fallback to title matching
        if (!selectedVariant) {
          selectedVariant = shopifyVariants.find(v =>
            v.title && v.title.includes(searchPattern)
          );
        }

        console.log('[Sticker Variant Match]', selectedVariant ? selectedVariant.title : 'NO MATCH', 'Pattern:', searchPattern);
        console.log('[Selected Variant Price RAW]', selectedVariant ? selectedVariant.price : 'N/A');
        console.log('[Selected Variant Price Type]', selectedVariant ? typeof selectedVariant.price : 'N/A');

        if (selectedVariant) {
          const unitPrice = parseFloat(selectedVariant.price) / 100;
          const total = unitPrice * qty;

          console.log('[Updating Price]', { unitPrice, total, unitPriceDisplayExists: !!unitPriceDisplay, totalDisplayExists: !!totalDisplay });

          // UPDATE MAIN UI
          if(unitPriceDisplay) {
            unitPriceDisplay.textContent = '$' + unitPrice.toFixed(2);
          }
          if(totalDisplay) {
            totalDisplay.innerText = '$' + total.toFixed(2).replace(/\.00$/, '');
          }

          // UPDATE HEADER UI
          if(headerPrice) headerPrice.innerText = '$' + unitPrice.toFixed(2);
          const headerQty = document.getElementById('header-qty');
          if(headerQty) headerQty.innerText = qty;

          // UPDATE TABLE HIGHLIGHTING
          if (pricingRows) {
            pricingRows.forEach(row => {
               const min = parseInt(row.dataset.min);
               const max = parseInt(row.dataset.max);
               if(qty >= min && qty <= max) row.classList.add('active');
               else row.classList.remove('active');
            });
          }

          // Update hidden variant input
          const variantInput = document.getElementById('real-variant-id');
          if(variantInput) variantInput.value = selectedVariant.id;

          // Update quantity input max. Only cap by stock when Shopify would
          // actually refuse the order (tracked inventory, policy deny) -
          // stickers are made to order, so untracked/continue variants get
          // the generous default.
          if(qtyInput) {
            const capByStock = selectedVariant.inventory_management === 'shopify' &&
                               selectedVariant.inventory_policy === 'deny';
            qtyInput.max = (capByStock ? selectedVariant.inventory_quantity : 0) || 9999;
            if(qtyInput.value > qtyInput.max) qtyInput.value = qtyInput.max;
          }
        } else {
          console.error('[STICKER ERROR] No variant matched pattern:', searchPattern);
          if(unitPriceDisplay) unitPriceDisplay.innerHTML = '<span style="color: #ef4444;">Select valid options</span>';
          if(totalDisplay) totalDisplay.innerText = '$0.00';
        }

        // Update pricing table for stickers - already handled above via shopifyVariants direct lookup

        return; // Exit early for stickers
      }

      // Update Size Text for non-stickers
      if(calculatedSizeDisplay) {
         if (PRODUCT_HANDLE === 'dtf-transfers') {
           // DTF: show W x H dimensions
           calculatedSizeDisplay.innerText = `${w}" x ${h}"`;
           if(sizeFormulaDisplay) sizeFormulaDisplay.innerText = '';
         } else {
           if(sizeFormulaDisplay) {
             const fw = w.toFixed(2).replace(/\.00$/, '');
             const fh = h.toFixed(2).replace(/\.00$/, '');
             sizeFormulaDisplay.innerText = `(${fw}" + ${fh}") ÷ 2 =`;
           }
           calculatedSizeDisplay.innerText = avgSize.toFixed(2).replace(/\.00$/, '') + '"';
         }
      }

      // Lookup exact price from matrix
      const unitPrice = lookupPrice(avgSize, qty);
      const qtyTier = getQuantityTier(qty);
      const sizeIdx = getSizeBracketIndex(avgSize);
      const sizeBracket = PRICING_MATRIX.sizeBrackets[sizeIdx];

      // Find variant that matches: "Size inch - QtyRange"
      // E.g., "3.5 inch - 100-199" or fallback to just size
      // For DTF: uses '2" x 2" - 25-49' format
      let selectedVariant = null;

      // Try to find exact match with quantity range in title
      // Variant titles carry the tier label: "1000+", a single quantity like "10"
      // (the new embroidery grid prices exactly 10 pcs on its own), or a range
      // like "26-50". Must match the Shopify variant titles exactly.
      const qtyRangeStr = qtyTier.max >= 999999
        ? `${qtyTier.min}+`
        : (qtyTier.min === qtyTier.max ? `${qtyTier.min}` : `${qtyTier.min}-${qtyTier.max}`);

      let searchPattern1;
      let searchPatternAlt; // Alternate format for products using '.0' inch
      if (PRODUCT_HANDLE === 'dtf-transfers') {
        // DTF uses square inches format like '4 sq in - 100-199'
        // Snap to nearest valid DTF bracket: [4, 9, 16, 25, 36, 49, 64, 81, 100, 121, 144]
        const DTF_BRACKETS = [4, 9, 16, 25, 36, 49, 64, 81, 100, 121, 144];
        const rawSqIn = w * h;
        const sqInches = DTF_BRACKETS.reduce((prev, curr) => Math.abs(curr - rawSqIn) < Math.abs(prev - rawSqIn) ? curr : prev);
        searchPattern1 = `${sqInches} sq in - ${qtyRangeStr}`;
      } else if (PRODUCT_HANDLE.includes('flex-patches')) {
        // Flex patches use format like '3" - 100-199'
        const sizeInt = sizeBracket % 1 === 0 ? sizeBracket.toFixed(0) : sizeBracket.toFixed(1);
        searchPattern1 = `${sizeInt}" - ${qtyRangeStr}`;
      } else {
        // Other patches use format like '3 inch - 100-199' or '3.0 inch - 100-199'
        const sizeBracketStr = sizeBracket % 1 === 0 ? sizeBracket.toFixed(0) : sizeBracket.toFixed(1);
        const sizeBracketStrAlt = sizeBracket.toFixed(1); // Alternate: '3.0 inch' for products that use .0
        searchPattern1 = `${sizeBracketStr} inch - ${qtyRangeStr}`;
        searchPatternAlt = `${sizeBracketStrAlt} inch - ${qtyRangeStr}`;
      }

      console.log('[Variant Search]', {
        avgSize,
        sizeBracket,
        qty,
        qtyRangeStr,
        searchPattern: searchPattern1,
        availableVariants: shopifyVariants.map(v => v.title)
      });

      selectedVariant = shopifyVariants.find(v =>
        v.title === searchPattern1 || (v.option1 && v.option1 === searchPattern1)
      );

      // Try alternate format (e.g., '4.0 inch' vs '4 inch') if first match fails
      if(!selectedVariant && searchPatternAlt) {
        selectedVariant = shopifyVariants.find(v =>
          v.title === searchPatternAlt || (v.option1 && v.option1 === searchPatternAlt)
        );
      }

      // Safety fallback: substring match anchored at start to avoid '5 inch' matching '1.5 inch'
      if(!selectedVariant) {
        selectedVariant = shopifyVariants.find(v =>
          v.title && v.title.indexOf(searchPattern1) === 0
        );
      }
      if(!selectedVariant && searchPatternAlt) {
        selectedVariant = shopifyVariants.find(v =>
          v.title && v.title.indexOf(searchPatternAlt) === 0
        );
      }

      console.log('[Variant Match]', selectedVariant ? selectedVariant.title : 'NO MATCH - using fallback');

      if(!selectedVariant) {
        // Fallback: find variant with matching size only (anchored to avoid substring bleed)
        selectedVariant = shopifyVariants.find(v => {
          if (PRODUCT_HANDLE === 'dtf-transfers') {
            // DTF fallback: match square inches like '4 sq in'
            const sqInches = Math.round(w * h);
            return v.title && v.title.indexOf(`${sqInches} sq in`) === 0;
          } else if (PRODUCT_HANDLE.includes('flex-patches')) {
            // Flex patches fallback: match size like '3"' anchored at start
            const sizeInt = sizeBracket % 1 === 0 ? sizeBracket.toFixed(0) : sizeBracket.toFixed(1);
            return v.title && v.title.indexOf(`${sizeInt}"`) === 0;
          } else {
            // Anchor regex to start so '5 inch' doesn't match '1.5 inch'
            const match = v.title && v.title.match(/^([\d.]+) inch/);
            if(match) {
              const variantSize = parseFloat(match[1]);
              return Math.abs(variantSize - sizeBracket) < 0.01;
            }
            return false;
          }
        });
      }

      // Final fallback
      if(!selectedVariant && shopifyVariants.length > 0) {
        selectedVariant = shopifyVariants[0];
      }

      // UPDATE UI
      if(headerPrice) headerPrice.innerText = '$' + unitPrice.toFixed(2);
      const headerQty = document.getElementById('header-qty');
      if(headerQty) headerQty.innerText = qty;
      if(unitPriceDisplay) unitPriceDisplay.textContent = '$' + unitPrice.toFixed(2);
      // The velcro surcharge is charged as a companion line item in the cart;
      // reflect it in the displayed total so the page and the cart agree.
      const backingSel = document.getElementById('backing-input');
      const velcroInTotal = PRODUCT_HANDLE !== 'dtf-transfers' &&
                            backingSel && backingSel.value.includes('Velcro');
      if(totalDisplay) totalDisplay.innerText = '$' + (qty * unitPrice + (velcroInTotal ? qty * 0.25 : 0)).toFixed(2);
      const velcroNote = document.getElementById('total-velcro-note');
      if(velcroNote) velcroNote.style.display = velcroInTotal ? 'block' : 'none';

      // Update pricing rows highlighting (query live — rows may be rebuilt from matrix)
      document.querySelectorAll('.pricing-row').forEach(row => {
         const min = parseInt(row.dataset.min);
         const max = parseInt(row.dataset.max);
         if(qty >= min && qty <= max) row.classList.add('active');
         else row.classList.remove('active');
      });

      // Update hidden variant input for cart
      if(selectedVariant && variantInput) {
         variantInput.value = selectedVariant.id;
         console.log('[Variant Updated]', {
           variantId: selectedVariant.id,
           variantTitle: selectedVariant.title,
           inputValue: variantInput.value
         });
      } else {
         console.warn('[Variant Update FAILED]', { selectedVariant, variantInput });
      }

      // Update pricing table preview with current size prices + dynamic discounts
      if (PRICING_MATRIX.type === 'stickers') {
        // Sticker pricing table
        const styleNum = 1; // Default to style #1-5
        const basePrice = lookupPrice(1, 25); // Base price for style 1, 25 qty
        const pctOffs = PRICING_MATRIX.quantityTiers.map((tier, idx) =>
          idx === 0 ? 0 : Math.max(0, Math.round((1 - tier.multiplier) * 100)));
        PRICING_MATRIX.quantityTiers.forEach((tier, idx) => {
          const tierPrice = basePrice * tier.multiplier;
          const tierEl = document.getElementById(`price-tier-${idx + 1}`);
          if(tierEl) {
            tierEl.textContent = '$' + tierPrice.toFixed(2) + ' ea';
          }
          const discountEl = document.getElementById(`discount-tier-${idx + 1}`);
          if(discountEl) {
            discountEl.textContent = idx === 0 ? 'Base' : (pctOffs[idx] > 0 ? `Save ${pctOffs[idx]}%` : 'Base');
          }
          updateTierMsg(idx, qty, pctOffs[idx + 1] || 0);
        });
      } else {
        // Regular patch pricing table
        const baseTierPrice = PRICING_MATRIX.quantityTiers[0].prices[sizeIdx]; // 25-49 tier = base
        const pctOffs = PRICING_MATRIX.quantityTiers.map((tier, idx) =>
          idx === 0 ? 0 : Math.max(0, Math.round((1 - tier.prices[sizeIdx] / baseTierPrice) * 100)));
        PRICING_MATRIX.quantityTiers.forEach((tier, idx) => {
          const tierPrice = tier.prices[sizeIdx];
          const tierEl = document.getElementById(`price-tier-${idx + 1}`);
          if(tierEl) {
            tierEl.textContent = '$' + tierPrice.toFixed(2) + ' ea';
          }
          // Update discount label
          const discountEl = document.getElementById(`discount-tier-${idx + 1}`);
          if(discountEl) {
            discountEl.textContent = idx === 0 ? 'Base' : (pctOffs[idx] > 0 ? `Save ${pctOffs[idx]}%` : 'Base');
          }
          updateTierMsg(idx, qty, pctOffs[idx + 1] || 0);
        });
      }
    }

    if(qtyInput) qtyInput.addEventListener('input', updatePriceAndVariant);
    updatePriceAndVariant(); // Init

    // Selectors
    window.selectShape = function(el, val) {
       document.querySelectorAll('.pk-shape').forEach(function(c) {
         c.classList.remove('selected');
         c.setAttribute('aria-pressed', 'false');
       });
       el.classList.add('selected');
       el.setAttribute('aria-pressed', 'true');
       const input = document.getElementById('shape-input');
       if(input) input.value = val;
    }
    // Colors: background and border each hold free text - a color name, a hex
    // code or a Pantone number. The swatch beside the box opens the browser's
    // color picker and writes its hex code into the box; colors read from the
    // uploaded artwork do the same.
    function paintColorField(field) {
       const text = field.querySelector('.pk-colors__text');
       const chip = field.querySelector('.pk-colors__chip');
       const value = text ? text.value.trim() : '';
       // Only a value the browser recognises as a color is shown on the swatch;
       // anything else ("PMS 186 C") leaves the swatch on its default.
       const known = !!value && !!window.CSS && CSS.supports('color', value);
       if (chip) chip.style.background = known ? value : '';
       field.querySelectorAll('.pk-colors__suggest').forEach(function(dot) {
         dot.classList.toggle('selected', dot.dataset.hex === value.toUpperCase());
       });
    }
    function setColorField(field, hex) {
       const text = field.querySelector('.pk-colors__text');
       if (text) text.value = hex.toUpperCase();
       paintColorField(field);
    }
    function clearColorSuggestions() {
       document.querySelectorAll('.pk-colors__suggests').forEach(function(box) {
         box.innerHTML = '';
         box.hidden = true;
       });
       const note = document.getElementById('pk-colors-note');
       if (note) note.hidden = true;
    }
    document.querySelectorAll('[data-color-field]').forEach(function(field) {
       const text = field.querySelector('.pk-colors__text');
       const picker = field.querySelector('.pk-colors__native');
       if (text) {
         text.addEventListener('input', function() { paintColorField(field); });
         // Enter in a text box would otherwise submit the whole order form.
         text.addEventListener('keydown', function(event) {
           if (event.key === 'Enter') { event.preventDefault(); text.blur(); }
         });
       }
       if (picker) {
         picker.addEventListener('input', function() { setColorField(field, picker.value); });
         picker.addEventListener('change', function() { setColorField(field, picker.value); });
       }
       field.addEventListener('click', function(event) {
         const dot = event.target.closest('.pk-colors__suggest');
         if (dot) setColorField(field, dot.dataset.hex);
       });
    });
    function extractDominantColors(img, count) {
       const size = 80;
       const canvas = document.createElement('canvas');
       canvas.width = size; canvas.height = size;
       const ctx = canvas.getContext('2d');
       ctx.drawImage(img, 0, 0, size, size);
       const data = ctx.getImageData(0, 0, size, size).data;
       const buckets = {};
       for (let i = 0; i < data.length; i += 4) {
         const r = data[i], g = data[i + 1], b = data[i + 2], a = data[i + 3];
         if (a < 200) continue; // skip transparent pixels
         const lum = (r * 299 + g * 587 + b * 114) / 1000;
         if (lum > 246) continue; // skip near-white backing/canvas
         const key = [Math.round(r / 32) * 32, Math.round(g / 32) * 32, Math.round(b / 32) * 32].join(',');
         buckets[key] = (buckets[key] || 0) + 1;
       }
       return Object.entries(buckets)
         .sort((a, b) => b[1] - a[1])
         .slice(0, count)
         .map(([key]) => '#' + key.split(',').map(v => Math.min(255, Number(v)).toString(16).padStart(2, '0')).join(''));
    }
    window.matchMyArtwork = function() {
       const note = document.getElementById('pk-colors-note');
       const say = function(message) {
         if (!note) return;
         note.textContent = message;
         note.hidden = !message;
       };
       const img = document.getElementById('pk-preview-img');
       if (!img || !img.getAttribute('src')) {
         say('Upload your design in step 1 first, then we can read colors from it.');
         return;
       }
       const run = function() {
         let colors = [];
         try { colors = extractDominantColors(img, 5); } catch (e) { colors = []; }
         if (!colors.length) {
           say('We could not read colors from this file. Type them in instead.');
           return;
         }
         say('Tap a color to use it for the background or the border.');
         document.querySelectorAll('[data-color-field]').forEach(function(field) {
           const box = field.querySelector('.pk-colors__suggests');
           if (!box) return;
           box.innerHTML = colors.map(function(hex) {
             const upper = hex.toUpperCase();
             return '<button type="button" class="pk-colors__suggest" data-hex="' + upper + '" style="background:' + upper + ';" title="' + upper + '" aria-label="Use ' + upper + '"></button>';
           }).join('');
           box.hidden = false;
           paintColorField(field);
         });
       };
       if (img.complete) {
         // A PDF upload has no picture to sample.
         if (img.naturalWidth) { run(); } else { say('We can only read colors from a picture (PNG or JPG). Type them in instead.'); }
       } else {
         img.addEventListener('load', run, { once: true });
       }
    }
    window.selectBacking = function(el, val) {
       const grid = el.closest('.backing-grid');
       if(grid) {
         grid.querySelectorAll('.backing-card').forEach(c => c.classList.remove('selected'));
       } else {
         document.querySelectorAll('.backing-card').forEach(c => c.classList.remove('selected'));
       }
       el.classList.add('selected');
       const input = document.getElementById('backing-input');
       if(input) input.value = val;

       // Short name next to the "Backing:" label, and the matching description.
       // Keyed by the first word of the stored value so the stored wording can
       // carry extra detail without breaking the lookup.
       const backingKey = val.split(' ')[0];
       const labelMap = {
         'Iron-On': 'Iron-On',
         'Velcro': 'Velcro',
         'Adhesive': 'Adhesive'
       };
       const labelExtra = document.getElementById('backing-label-extra');
       if(labelExtra) labelExtra.innerText = labelMap[backingKey] || val;

       const descMap = {
         'Iron-On': 'Bonds to fabric with heat. A heat press gives the most even result; a household iron also works if you press firmly.',
         'Velcro': 'Hook-and-loop backing with both sides included, so the patch can come off and go back on. Common on uniforms, bags and tactical gear. Adds $0.25 per piece.',
         'Adhesive': 'A peel-off sticky backing for short-term wear or surfaces that cannot take heat. Remove the liner and press the patch on.'
       };
       const desc = document.getElementById('backing-description');
       if(desc) desc.innerText = descMap[backingKey] || '';

       // Backing choice changes the displayed total (velcro surcharge)
       if (typeof updatePriceAndVariant === 'function') updatePriceAndVariant();
    }

    window.selectLeatherColor = function(el, val) {
       // Only de-select cards in the SAME grid (the leather color grid)
       const grid = el.closest('.backing-grid');
       if(grid) {
         grid.querySelectorAll('.backing-card').forEach(c => c.classList.remove('selected'));
       }
       el.classList.add('selected');
       const input = document.getElementById('leather-color-input');
       if(input) input.value = val;
       const labelExtra = document.getElementById('leather-color-label-extra');
       if(labelExtra) labelExtra.innerText = val;
    }

    // --- GALLERY LOGIC (Scroll Snap - Fast) ---
    const galleryScroller = document.getElementById('galleryScroller');
    const btnPrev = document.getElementById('btnPrev');
    const btnNext = document.getElementById('btnNext');
    const thumbnails = document.querySelectorAll('.thumbnail-btn');
    const slides = document.querySelectorAll('.gallery-slide');

    let currentImageIndex = 0;
    const totalSlides = slides.length;

    function scrollToSlide(index) {
      if (!galleryScroller || totalSlides === 0) return;
      if (index < 0) index = totalSlides - 1;
      if (index >= totalSlides) index = 0;

      // Pause all videos in gallery
      galleryScroller.querySelectorAll('video').forEach(v => v.pause());

      currentImageIndex = index;
      const slideWidth = galleryScroller.offsetWidth;
      galleryScroller.scrollTo({ left: slideWidth * index, behavior: 'smooth' });

      // Update thumbnails
      thumbnails.forEach((thumb, i) => {
        thumb.classList.toggle('active', i === currentImageIndex);
      });
    }

    // Sync thumbnails on scroll (for swipe gestures)
    if (galleryScroller) {
      let scrollTimeout;
      galleryScroller.addEventListener('scroll', () => {
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => {
          const slideWidth = galleryScroller.offsetWidth;
          const newIndex = Math.round(galleryScroller.scrollLeft / slideWidth);
          if (newIndex !== currentImageIndex && newIndex >= 0 && newIndex < totalSlides) {
            currentImageIndex = newIndex;
            thumbnails.forEach((thumb, i) => {
              thumb.classList.toggle('active', i === currentImageIndex);
            });
          }
        }, 50);
      }, { passive: true });
    }

    if (btnPrev) {
      btnPrev.addEventListener('click', (e) => {
        e.preventDefault();
        scrollToSlide(currentImageIndex - 1);
      });
    }
    if (btnNext) {
      btnNext.addEventListener('click', (e) => {
        e.preventDefault();
        scrollToSlide(currentImageIndex + 1);
      });
    }
    thumbnails.forEach((thumb, index) => {
      thumb.addEventListener('click', (e) => {
        e.preventDefault();
        scrollToSlide(index);
       });
    });

  }); // End of DOMContentLoaded

</script>

