<script>
  (function() {
    // AJAX Add to Cart + Open Drawer
    const form = document.getElementById('product-form-pk');
    if(form) {
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        e.stopPropagation();
        
        const formData = new FormData(form);
        const btn = form.querySelector('.checkout-btn');
        const originalText = btn.innerText;
        
        btn.disabled = true;
        btn.innerText = 'Adding...';
        
        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            body: formData
          });
          
          if(response.ok) {
            // Trigger cart update event
            document.dispatchEvent(new CustomEvent('cart:add'));
            
            // Open cart drawer with delay
            setTimeout(() => {
              const cartDrawer = document.querySelector('cart-drawer-component');
              if(cartDrawer) {
                if(typeof cartDrawer.open === 'function') {
                  cartDrawer.open();
                } else if(typeof cartDrawer.showDialog === 'function') {
                  cartDrawer.showDialog();
                }
              }
            }, 200);
            
            btn.innerText = 'Added!';
            setTimeout(() => {
              btn.disabled = false;
              btn.innerText = originalText;
            }, 2000);
          } else {
            throw new Error('Failed to add to cart');
          }
        } catch(error) {
          console.error('Cart error:', error);
          btn.innerText = 'Error - Try Again';
          btn.disabled = false;
        }
        
        return false;
      }, true);
    }
  })();
</script>

<script>
  // Zoom Image Functionality
  function zoomImage() {
    const mainImg = document.getElementById('mainProductImage');
    if (!mainImg) return;
    
    const modal = document.createElement('div');
    modal.style.cssText = `
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.9);
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
      cursor: zoom-out;
    `;
    
    const zoomedImg = document.createElement('img');
    zoomedImg.src = mainImg.src.replace(/width=\d+/, 'width=2000');
    zoomedImg.style.cssText = `
      max-width: 95%;
      max-height: 95%;
      object-fit: contain;
      border-radius: 0.5rem;
    `;
    
    const closeBtn = document.createElement('button');
    closeBtn.innerHTML = `
      <svg width="32" height="32" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    `;
    closeBtn.style.cssText = `
      position: absolute;
      top: 1rem;
      right: 1rem;
      background: rgba(0, 0, 0, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 50%;
      width: 3rem;
      height: 3rem;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.2s;
    `;
    closeBtn.onmouseover = () => closeBtn.style.background = 'rgba(0, 0, 0, 0.8)';
    closeBtn.onmouseout = () => closeBtn.style.background = 'rgba(0, 0, 0, 0.5)';
    
    const closeModal = () => document.body.removeChild(modal);
    modal.onclick = closeModal;
    closeBtn.onclick = closeModal;
    
    modal.appendChild(zoomedImg);
    modal.appendChild(closeBtn);
    document.body.appendChild(modal);
  }
</script>

<script>
  (function() {
    // 1. INJECT SHOPIFY VARIANTS
    const shopifyVariants = {{ product.variants | json }};
    const BASE_PRICE = 6.79;
    const PRICING = [
      { min: 10, max: 48, discount: 0 },
      { min: 49, max: 98, discount: 0.15 },
      { min: 99, max: 148, discount: 0.20 },
      { min: 149, max: 298, discount: 0.30 },
      { min: 299, max: 498, discount: 0.40 },
      { min: 499, max: 99999, discount: 0.50 }
    ];

    const fileInput = document.getElementById('file-input');
    const uploadStage = document.getElementById('upload-stage');
    const customizeStage = document.getElementById('customize-stage');
    const qtyInput = document.getElementById('qty-input');
    const totalDisplay = document.getElementById('total-price-display');
    const headerPrice = document.getElementById('header-price');
    const pricingRows = document.querySelectorAll('.pricing-row');
    const variantInput = document.getElementById('real-variant-id');

    // Make functions safe if elements missing
    if (!fileInput || !qtyInput) return;

    // File Preview
    fileInput.addEventListener('change', function() {
      if(this.files && this.files.length > 0) {
         const file = this.files[0]; 
         const nameDisplay = document.getElementById('filename-display');
         if(nameDisplay) nameDisplay.innerText = file.name;
         
         const reader = new FileReader();
         reader.onload = function(e){ 
             const img = document.getElementById('file-preview-img');
             if(img) img.src = e.target.result; 
         }
         reader.readAsDataURL(file);
         
         if(uploadStage) uploadStage.style.display = 'none';
         if(customizeStage) customizeStage.classList.add('active');
      }
    });

    window.resetUpload = function() {
      if(fileInput) fileInput.value = '';
      if(customizeStage) customizeStage.classList.remove('active');
      if(uploadStage) uploadStage.style.display = 'block';
    }

    const widthInput = document.getElementById('width-input');
    const heightInput = document.getElementById('height-input');
    const unitPriceDisplay = document.getElementById('unit-price-display');
    const calculatedSizeDisplay = document.getElementById('calculated-size-display');

    // Stepper Logic
    window.stepSize = function(type, delta) {
      const el = type === 'width' ? widthInput : heightInput;
      if(!el) return;
      let val = parseFloat(el.value) || 2.0;
      val += delta;
      if(val < 1.0) val = 1.0; // Min size
      el.value = val.toFixed(2);
      updatePriceAndVariant();
    };

    // Smart Pricing + Variant Swapper
    function updatePriceAndVariant() {
      if(!qtyInput) return;
      let qty = parseInt(qtyInput.value) || 10;
      if(qty < 10) qty = 10;
      
      // Calculate Size: (W + H) / 2
      let w = parseFloat(widthInput ? widthInput.value : 2) || 2;
      let h = parseFloat(heightInput ? heightInput.value : 2) || 2;
      let avgSize = (w + h) / 2;
      
      // Update Size Text
      if(calculatedSizeDisplay) {
         calculatedSizeDisplay.innerText = avgSize.toFixed(2).replace(/\.00$/, '') + '"';
      }

      // Calculate Unit Price based on Tiers
      let currentTier = PRICING[0];
      for(let tier of PRICING) {
         if(qty >= tier.min) { currentTier = tier; }
      }
      
      let unitPrice = BASE_PRICE * (1 - currentTier.discount);

      // UPDATE UI
      if(headerPrice) headerPrice.innerText = '$' + unitPrice.toFixed(2);
      if(unitPriceDisplay) unitPriceDisplay.innerHTML = '$' + unitPrice.toFixed(2) + ' <span style="font-size: 0.9rem; color: #6b7280; font-weight: 400;">ea.</span>';
      if(totalDisplay) totalDisplay.innerText = '$' + (qty * unitPrice).toFixed(2);
      
      pricingRows.forEach(row => {
         const min = parseInt(row.dataset.min);
         const max = parseInt(row.dataset.max);
         if(qty >= min && qty <= max) row.classList.add('active');
         else row.classList.remove('active');
      });

      // VARIANT SWAP LOGIC (The Magic)
      const foundVariant = shopifyVariants.find(v => {
         return v.title.includes(currentTier.min.toString());
      });
      
      if(foundVariant && variantInput) {
         variantInput.value = foundVariant.id;
      }
    }

    if(qtyInput) qtyInput.addEventListener('input', updatePriceAndVariant);
    updatePriceAndVariant(); // Init

    // Selectors
    window.selectShape = function(el, val) {
       document.querySelectorAll('.shape-card').forEach(c => c.classList.remove('selected'));
       el.classList.add('selected');
       const input = document.getElementById('shape-input');
       if(input) input.value = val;
    }
    window.selectBacking = function(el, val) {
       document.querySelectorAll('.backing-card').forEach(c => c.classList.remove('selected'));
       el.classList.add('selected');
       const input = document.getElementById('backing-input');
       if(input) input.value = val;
       
       // Update label
       const labelMap = {
         'Heat Applied': 'Heat Applied (Most Popular)',
         'Velcro': 'Velcro',
         'Peel & Stick': 'Peel & Stick'
       };
       const labelExtra = document.getElementById('backing-label-extra');
       if(labelExtra) labelExtra.innerText = labelMap[val] || val;

       // Update description
       const descMap = {
         'Heat Applied': 'Our most popular method allows you to quickly and conveniently use a heat press or even a home iron if the right pressure and heat are applied.',
         'Velcro': 'Ideal for uniforms and tactical gear. Allows for easy removal and reattachment.',
         'Peel & Stick': 'Perfect for temporary use or hard-to-iron surfaces. Just peel off the back and stick it on!'
       };
       const desc = document.getElementById('backing-description');
       if(desc) desc.innerText = descMap[val] || '';
    }

    // --- GALLERY LOGIC ---
    const mainImage = document.getElementById('mainProductImage');
    const btnPrev = document.getElementById('btnPrev');
    const btnNext = document.getElementById('btnNext');
    const thumbnails = document.querySelectorAll('.thumbnail-btn');
    
    // Build media array properly from thumbnails
    const mediaJson = [];
    thumbnails.forEach(thumb => {
      const img = thumb.querySelector('img');
      if(img && img.src) {
        // Convert thumbnail URL to full size
        const fullSrc = img.src.replace(/width=\d+/, 'width=1000');
        mediaJson.push({ src: fullSrc });
      }
    });

    let currentImageIndex = 0;

    function updateGallery(index) {
       if(!mainImage || mediaJson.length === 0) return;
       if(index < 0) index = mediaJson.length - 1;
       if(index >= mediaJson.length) index = 0;
       
       currentImageIndex = index;
       
       // Update Main Image with smooth transition
       mainImage.style.opacity = 0.4;
       setTimeout(() => {
          mainImage.src = mediaJson[currentImageIndex].src;
          mainImage.style.opacity = 1;
       }, 150);

       // Update Thumbnails
       thumbnails.forEach((thumb, i) => {
          if(i === currentImageIndex) thumb.classList.add('active');
          else thumb.classList.remove('active');
       });
    }

    if(btnPrev) {
      btnPrev.addEventListener('click', (e) => {
        e.preventDefault();
        updateGallery(currentImageIndex - 1);
      });
    }
    if(btnNext) {
      btnNext.addEventListener('click', (e) => {
        e.preventDefault();
        updateGallery(currentImageIndex + 1);
      });
    }
    thumbnails.forEach((thumb, index) => {
       thumb.addEventListener('click', (e) => {
         e.preventDefault();
         updateGallery(index);
       });
    });

  })();

</script>

