{% schema %}
{
  "name": "Ordering Process PK",
  "class": "section-ordering-process",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Patch Kraze Ordering Process"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Simplifying the Process with Satisfaction Guaranteed"
    }
  ],
  "blocks": [
    {
      "type": "process_step",
      "name": "Process Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Step description goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ordering Process PK",
      "blocks": [
        {
          "type": "process_step",
          "settings": {
            "title": "Upload Your Designs & Place Order Online",
            "description": "Use designs with unlimited colors, simple or high detail artwork. Upload any design you want and we'll turn it into high quality custom patches."
          }
        },
        {
          "type": "process_step",
          "settings": {
            "title": "Approve Your Patch Artwork Proofs",
            "description": "If selected during checkout, we will send you a virtual proof for approval before we can begin production."
          }
        },
        {
          "type": "process_step",
          "settings": {
            "title": "We Create & Ship Your Custom Patch Order",
            "description": "We make ordering custom patches easy. We can create the most detailed, highest quality, full color custom patches you can find."
          }
        },
        {
          "type": "process_step",
          "settings": {
            "title": "Heatpress when Ready. Keep Extras in Storage Forever",
            "description": "Press your custom made patches with a heat press, while using our required pressing instructions for ultimate durability."
          }
        }
      ]
    }
  ]
}
{% endschema %}

<div class="w-full bg-white py-10" style="padding-top: 2.5rem; padding-bottom: 2.5rem; background-color: #fff;">
  <div class="max-w-6xl mx-auto px-4" style="max-width: 72rem; margin-left: auto; margin-right: auto; padding-left: 1rem; padding-right: 1rem;">
    <div class="mb-16" style="margin-bottom: 4rem;">
      <h2 class="text-3xl font-bold text-foreground mb-2" style="font-size: 1.875rem; line-height: 2.25rem; font-weight: 700; margin-bottom: 0.5rem; color: #111827;">
        {{ section.settings.heading }}
      </h2>
      <p class="text-gray-600" style="color: #4b5563;">
        {{ section.settings.subheading }}
      </p>
    </div>

    <div class="process-grid">
      {% for block in section.blocks %}
        <div class="process-step" {{ block.shopify_attributes }}>
          <div class="mb-6 flex justify-center" style="margin-bottom: 1.5rem; display: flex; justify-content: center;">
            <div class="image-container group">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 400 | image_tag: class: 'step-image', loading: 'lazy' }}
              {% else %}
                <img src="https://placehold.co/240x240?text={{ forloop.index }}" class="step-image" alt="{{ block.settings.title }}">
              {% endif %}
            </div>
          </div>

          <h3 class="step-title">{{ block.settings.title }}</h3>
          <p class="step-desc">{{ block.settings.description }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .process-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .process-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .process-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  
  .process-step {
    display: flex;
    flex-direction: column;
  }
  
  .image-container {
    width: 15rem; /* 60 */
    height: 15rem;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    /* group hover effect logic needs parent class, handling simple scaling here */
    overflow: hidden;
  }
  
  .step-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.3s;
  }
  
  .image-container:hover .step-image {
    transform: scale(1.1);
  }

  .step-title {
    font-size: 1.125rem; /* text-lg */
    font-weight: 700;
    color: #111827;
    margin-bottom: 0.75rem;
    text-align: center;
  }
  
  .step-desc {
    color: #4b5563; /* text-gray-600 */
    font-size: 0.875rem; /* text-sm */
    text-align: center;
    line-height: 1.5;
  }
</style>
