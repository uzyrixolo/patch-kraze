{% comment %}
  Ninja-style product card rail ("Best sellers"). Blocks pick products; the
  card auto-pulls image and from-price, with optional rating/review count.

  Optional category tabs ("Show category tabs"): each card is tagged with a
  group (matching the header mega-menu categories) and/or Best seller, and
  the tab row filters the grid client-side. Every card is always rendered in
  the HTML - without JS all cards simply show - and the "All" tab lists the
  full set, so no product is ever unreachable.
{% endcomment %}

{% schema %}
{
  "name": "Patch Shelves",
  "settings": [
    { "type": "text", "id": "heading", "label": "Section heading (blank to hide)", "default": "Shop All Patch Types" },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 3, "max": 5, "step": 1, "default": 4 },
    { "type": "text", "id": "view_all_label", "label": "View-all link label", "default": "View all types" },
    { "type": "url", "id": "view_all_link", "label": "View-all link" },
    { "type": "text", "id": "rail_label", "label": "Rail label", "default": "Best sellers" },
    { "type": "text", "id": "rail_sub", "label": "Rail subtext", "default": "Our most-ordered styles" },
    { "type": "text", "id": "moq_text", "label": "Badge text", "default": "10 pc min" },
    { "type": "header", "content": "Category tabs" },
    { "type": "checkbox", "id": "show_tabs", "label": "Show category tabs", "info": "Filters cards by each card's Group / Best seller setting. The rail label and subtext are replaced by the tab row.", "default": false },
    { "type": "text", "id": "best_tab_label", "label": "Best sellers tab label", "default": "Best Sellers" },
    { "type": "text", "id": "all_tab_label", "label": "All tab label", "default": "All Types" }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Image override (optional)" },
        { "type": "text", "id": "rating", "label": "Star rating (e.g. 4.8, blank to hide)", "default": "4.8" },
        { "type": "text", "id": "review_count", "label": "Review count (blank to hide)" },
        {
          "type": "select", "id": "group", "label": "Group (category tabs)", "default": "",
          "options": [
            { "value": "", "label": "None" },
            { "value": "embroidered", "label": "Embroidered & Woven" },
            { "value": "printed", "label": "Printed & Flex" },
            { "value": "pvc", "label": "PVC & Rubber" },
            { "value": "leather", "label": "Leather" }
          ]
        },
        { "type": "checkbox", "id": "best_seller", "label": "Best seller", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Patch Shelves" }]
}
{% endschema %}

<style>
  .patch-shelves { background: #fff; padding: 3rem 0; }
  .patch-shelves__inner { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
  .patch-shelves__header { display: flex; align-items: baseline; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
  .patch-shelves__heading { font-size: var(--pk-fs-heading); font-weight: 800; margin: 0; color: var(--pk-text-primary); }
  .patch-shelves__viewall { font-size: var(--pk-fs-body); font-weight: 600; color: var(--pk-text-link); text-decoration: none; border-left: 1px solid #d1d5db; padding-left: 1rem; }
  .patch-shelves__viewall:hover { color: var(--pk-text-link-hover); }
  .patch-shelves__rail-head { margin-bottom: 1rem; }
  .patch-shelves__rail-label { font-size: var(--pk-fs-heading-sm); font-weight: 800; margin: 0; color: var(--pk-text-primary); }
  .patch-shelves__rail-sub { font-size: var(--pk-fs-body); color: var(--pk-text-secondary); margin: 0.15rem 0 0; }
  .patch-shelves__track { display: grid; grid-template-columns: repeat(var(--ps-cols, 4), 1fr); gap: 1.25rem; }
  .patch-shelves__item { display: flex; }
  .patch-shelves__tile { display: flex; flex-direction: column; width: 100%; text-decoration: none; }
  .patch-shelves__media { position: relative; border-radius: var(--pk-radius-md); overflow: hidden; background: #f3f4f6; aspect-ratio: 1 / 1.05; }
  .patch-shelves__img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.3s; }
  .patch-shelves__tile:hover .patch-shelves__img { transform: scale(1.04); }
  .patch-shelves__moq { position: absolute; top: 0.7rem; right: 0.7rem; background: #10b981; color: var(--pk-text-inverse); font-size: var(--pk-fs-label); font-weight: 700; padding: 0.3rem 0.7rem; border-radius: var(--pk-radius-pill); z-index: 2; }
  .patch-shelves__scrim { position: absolute; inset: 0; border-radius: inherit; box-shadow: inset 0 0 0 1px rgba(17,24,39,0.06), inset 0 -34px 44px -18px rgba(17,24,39,0.18); pointer-events: none; z-index: 1; }
  .patch-shelves__info { padding: 0.8rem 0.15rem 0; display: flex; flex-direction: column; flex: 1; }
  .patch-shelves__title { font-weight: 700; font-size: var(--pk-fs-body); line-height: 1.3; color: var(--pk-text-primary); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .patch-shelves__meta { display: flex; align-items: center; gap: 0.6rem; margin: 0.3rem 0 0.7rem; flex-wrap: wrap; }
  .patch-shelves__btn { margin-top: auto; }
  .patch-shelves__price { font-size: var(--pk-fs-body); color: var(--pk-text-brand); font-weight: 600; }
  .patch-shelves__rating { display: inline-flex; align-items: center; gap: 0.25rem; font-size: var(--pk-fs-label); color: var(--pk-text-secondary); }
  .patch-shelves__star { color: var(--pk-text-rating); }
  .patch-shelves__count { color: var(--pk-text-muted); }
  .patch-shelves__btn { display: block; width: 100%; text-align: center; font-size: var(--pk-fs-label); font-weight: 700; padding: 0.65rem 1.1rem; border-radius: var(--pk-radius-sm); box-sizing: border-box; }
  /* Whole-card hover swaps this to brand green (not the standard Dark-CTA
     hover darken) - a deliberate "this tile is active" cue, kept as-is. */
  .patch-shelves__tile:hover .patch-shelves__btn { background: var(--pk-btn-primary-bg); }
  .patch-shelves__tabs { display: flex; gap: 0.5rem; margin: 0 0 1.25rem; padding: 0.15rem; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
  .patch-shelves__tabs::-webkit-scrollbar { display: none; }
  .patch-shelves__tab { flex: 0 0 auto; display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.55rem 1rem; border: 1px solid #d1d5db; border-radius: var(--pk-radius-pill); background: #fff; color: var(--pk-text-primary); font: inherit; font-size: var(--pk-fs-label); font-weight: 600; cursor: pointer; white-space: nowrap; transition: border-color var(--pk-btn-transition), background-color var(--pk-btn-transition), color var(--pk-btn-transition); }
  .patch-shelves__tab:hover { border-color: var(--pk-text-primary); }
  .patch-shelves__tab:focus-visible { outline: 2px solid var(--pk-btn-primary-bg); outline-offset: 2px; }
  .patch-shelves__tab[aria-selected="true"] { background: var(--pk-btn-dark-bg); border-color: var(--pk-btn-dark-bg); color: var(--pk-btn-dark-fg); }
  .patch-shelves__tab-count { font-weight: 500; color: var(--pk-text-muted); }
  .patch-shelves__tab[aria-selected="true"] .patch-shelves__tab-count { color: var(--pk-text-inverse-secondary); }
  .patch-shelves__item[hidden] { display: none; }
  @media (max-width: 899px) {
    .patch-shelves__track { grid-template-columns: repeat(2, 1fr); gap: 0.9rem; }
    .patch-shelves__heading { font-size: var(--pk-fs-heading-mobile); }
    /* Tab row bleeds to the screen edge so it reads as swipeable. */
    .patch-shelves__tabs { margin-left: -1.5rem; margin-right: -1.5rem; padding-left: 1.5rem; padding-right: 1.5rem; }
  }
</style>

<section class="patch-shelves" style="--ps-cols: {{ section.settings.columns | default: 4 }};{% if section.settings.heading == blank %} padding-top: 0;{% endif %}">
  <div class="patch-shelves__inner">
    {%- if section.settings.heading != blank -%}
    <div class="patch-shelves__header">
      <h2 class="patch-shelves__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.view_all_label != blank -%}
        <a class="patch-shelves__viewall" href="{{ section.settings.view_all_link | default: '/collections/all' }}">{{ section.settings.view_all_label }} &rarr;</a>
      {%- endif -%}
    </div>
    {%- endif -%}
    <div class="patch-shelves__rail">
      {%- liquid
        assign total_count = 0
        assign best_count = 0
        assign emb_count = 0
        assign printed_count = 0
        assign pvc_count = 0
        assign leather_count = 0
        for block in section.blocks
          if block.settings.product != blank
            assign total_count = total_count | plus: 1
            if block.settings.best_seller
              assign best_count = best_count | plus: 1
            endif
            case block.settings.group
              when 'embroidered'
                assign emb_count = emb_count | plus: 1
              when 'printed'
                assign printed_count = printed_count | plus: 1
              when 'pvc'
                assign pvc_count = pvc_count | plus: 1
              when 'leather'
                assign leather_count = leather_count | plus: 1
            endcase
          endif
        endfor
        if best_count > 0
          assign default_tab = 'best'
        else
          assign default_tab = 'all'
        endif
      -%}
      {%- if section.settings.show_tabs -%}
        <div class="patch-shelves__tabs" role="tablist" aria-label="{{ section.settings.heading | default: 'Patch types' | escape }}" data-ps-tabs data-ps-default="{{ default_tab }}">
          {%- if best_count > 0 -%}
            <button type="button" class="patch-shelves__tab" role="tab" aria-selected="true" aria-controls="ps-track-{{ section.id }}" data-ps-filter="best">{{ section.settings.best_tab_label }} <span class="patch-shelves__tab-count">{{ best_count }}</span></button>
          {%- endif -%}
          {%- if emb_count > 0 -%}
            <button type="button" class="patch-shelves__tab" role="tab" aria-selected="false" aria-controls="ps-track-{{ section.id }}" data-ps-filter="embroidered">Embroidered &amp; Woven <span class="patch-shelves__tab-count">{{ emb_count }}</span></button>
          {%- endif -%}
          {%- if printed_count > 0 -%}
            <button type="button" class="patch-shelves__tab" role="tab" aria-selected="false" aria-controls="ps-track-{{ section.id }}" data-ps-filter="printed">Printed &amp; Flex <span class="patch-shelves__tab-count">{{ printed_count }}</span></button>
          {%- endif -%}
          {%- if pvc_count > 0 -%}
            <button type="button" class="patch-shelves__tab" role="tab" aria-selected="false" aria-controls="ps-track-{{ section.id }}" data-ps-filter="pvc">PVC &amp; Rubber <span class="patch-shelves__tab-count">{{ pvc_count }}</span></button>
          {%- endif -%}
          {%- if leather_count > 0 -%}
            <button type="button" class="patch-shelves__tab" role="tab" aria-selected="false" aria-controls="ps-track-{{ section.id }}" data-ps-filter="leather">Leather <span class="patch-shelves__tab-count">{{ leather_count }}</span></button>
          {%- endif -%}
          <button type="button" class="patch-shelves__tab" role="tab" aria-selected="{% if best_count > 0 %}false{% else %}true{% endif %}" aria-controls="ps-track-{{ section.id }}" data-ps-filter="all">{{ section.settings.all_tab_label }} <span class="patch-shelves__tab-count">{{ total_count }}</span></button>
        </div>
      {%- else -%}
      <div class="patch-shelves__rail-head">
        <h3 class="patch-shelves__rail-label">{{ section.settings.rail_label }}</h3>
        {%- if section.settings.rail_sub != blank -%}
          <p class="patch-shelves__rail-sub">{{ section.settings.rail_sub }}</p>
        {%- endif -%}
      </div>
      {%- endif -%}
      <div class="patch-shelves__track" id="ps-track-{{ section.id }}"{% if section.settings.show_tabs %} role="tabpanel"{% endif %}>
        {%- for block in section.blocks -%}
          {%- assign product = block.settings.product -%}
          {%- if product != blank -%}
            <div class="patch-shelves__item" data-ps-group="{{ block.settings.group }}" data-ps-best="{% if block.settings.best_seller %}1{% endif %}" {{ block.shopify_attributes }}>
              <a class="patch-shelves__tile" href="{{ product.url }}">
                <div class="patch-shelves__media">
                  {%- assign card_image = block.settings.image | default: product.featured_image -%}
                  {%- if card_image -%}
                    <img class="patch-shelves__img" src="{{ card_image | img_url: '560x560', crop: 'center' }}" loading="lazy" alt="{{ product.title | escape }}">
                  {%- endif -%}
                  <span class="patch-shelves__scrim" aria-hidden="true"></span>
                  {%- if section.settings.moq_text != blank -%}
                    <span class="patch-shelves__moq">{{ section.settings.moq_text }}</span>
                  {%- endif -%}
                </div>
                <div class="patch-shelves__info">
                  <span class="patch-shelves__title">{{ product.title }}</span>
                  <div class="patch-shelves__meta">
                    <span class="patch-shelves__price">From {{ product.price_min | money }}</span>
                    {%- if block.settings.rating != blank -%}
                      <span class="patch-shelves__rating">
                        <span class="patch-shelves__star">&#9733;</span>{{ block.settings.rating }}
                        {%- if block.settings.review_count != blank -%}
                          <span class="patch-shelves__count">({{ block.settings.review_count }})</span>
                        {%- endif -%}
                      </span>
                    {%- endif -%}
                  </div>
                  <span class="patch-shelves__btn pk-btn-dark">Customize</span>
                </div>
              </a>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{%- if section.settings.show_tabs -%}
<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    var tabs = root.querySelectorAll('[data-ps-filter]');
    var items = root.querySelectorAll('.patch-shelves__item');
    function apply(filter) {
      tabs.forEach(function (t) { t.setAttribute('aria-selected', t.dataset.psFilter === filter ? 'true' : 'false'); });
      items.forEach(function (it) {
        var show = filter === 'all' ||
          (filter === 'best' ? it.dataset.psBest === '1' : it.dataset.psGroup === filter);
        it.hidden = !show;
      });
    }
    tabs.forEach(function (t) {
      t.addEventListener('click', function () { apply(t.dataset.psFilter); });
    });
    var list = root.querySelector('[data-ps-tabs]');
    list.addEventListener('keydown', function (e) {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      var arr = Array.prototype.slice.call(tabs);
      var i = arr.indexOf(document.activeElement);
      if (i < 0) return;
      var next = arr[(i + (e.key === 'ArrowRight' ? 1 : arr.length - 1)) % arr.length];
      next.focus(); next.click(); e.preventDefault();
    });
    apply(list.dataset.psDefault);
  })();
</script>
{%- endif -%}
