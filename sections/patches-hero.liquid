{% comment %}
  Ninja-style homepage hero: dark panel, left headline + value props + CTAs,
  right stat card + patches imagery with a starburst badge.
{% endcomment %}

{% schema %}
{
  "name": "Patches Hero",
  "settings": [
    { "type": "text", "id": "eyebrow_text", "label": "Eyebrow text (above heading)", "default": "Made in USA", "info": "Leave empty to hide it." },
    { "type": "checkbox", "id": "eyebrow_animate", "label": "Type the eyebrow letter by letter on a loop", "default": true },
    { "type": "range", "id": "eyebrow_speed", "label": "Typing speed", "unit": "ms", "min": 40, "max": 220, "step": 10, "default": 110, "info": "Delay per letter." },
    { "type": "text", "id": "title", "label": "Heading", "default": "Premium Custom Patches with Low 10-Piece Minimums" },
    { "type": "textarea", "id": "subtitle", "label": "Subheading", "default": "Premium custom patches for any design — embroidered, woven, PVC, leather and more. Low minimums, fast turnaround." },
    { "type": "text", "id": "prop_1", "label": "Value prop 1", "default": "Free Fast Shipping" },
    { "type": "text", "id": "prop_2", "label": "Value prop 2", "default": "100% Satisfaction" },
    { "type": "text", "id": "prop_3", "label": "Value prop 3", "default": "No Setup Fees" },
    { "type": "text", "id": "btn_primary_label", "label": "Primary button label", "default": "Shop Custom Patches" },
    { "type": "url", "id": "btn_primary_link", "label": "Primary button link" },
    { "type": "text", "id": "btn_secondary_label", "label": "Secondary button label", "default": "Get a Free Quote" },
    { "type": "url", "id": "btn_secondary_link", "label": "Secondary button link" },
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "NEW! 10 PIECE MINIMUM" },
    { "type": "text", "id": "stat_1_value", "label": "Stat 1 value", "default": "15+ Varieties" },
    { "type": "text", "id": "stat_1_label", "label": "Stat 1 label", "default": "Of Patch Types" },
    { "type": "text", "id": "stat_2_value", "label": "Stat 2 value", "default": "10 Piece" },
    { "type": "text", "id": "stat_2_label", "label": "Stat 2 label", "default": "Minimum Order" },
    { "type": "text", "id": "stat_banner", "label": "Stat card banner", "default": "Ships as Fast as 5 Business Days!" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image (right side)", "info": "Also used as the video poster / fallback. Leave empty to use the Full Color Printed Patches product image." },
    { "type": "header", "content": "Hero video (optional)" },
    { "type": "video", "id": "hero_video", "label": "Video", "info": "Shopify-hosted video. Falls back to the hero image if left empty or if the video fails to load." },
    { "type": "video_url", "id": "hero_video_url", "label": "External video URL", "accept": ["youtube", "vimeo"], "info": "Used only when no Shopify-hosted video is chosen. Plays in an embed, so it cannot autoplay silently." },
    { "type": "checkbox", "id": "video_autoplay", "label": "Autoplay and loop silently", "default": true, "info": "Muted autoplay. Turn off to show a play button instead." },
    { "type": "checkbox", "id": "video_controls", "label": "Show video controls", "default": false },
    { "type": "range", "id": "video_max_height", "label": "Video height", "unit": "px", "min": 240, "max": 720, "step": 20, "default": 420, "info": "The video keeps its own aspect ratio, so this caps its height." }
  ],
  "presets": [{ "name": "Patches Hero" }]
}
{% endschema %}

<style>
  .patches-hero { background: #0a0a0a; color: #fff; position: relative; overflow: hidden; }
  .patches-hero__glow { position: absolute; top: -40%; right: -10%; width: 60%; height: 180%; background: radial-gradient(closest-side, rgba(16,185,129,0.18), transparent 70%); pointer-events: none; }
  .patches-hero__inner { max-width: 1200px; margin: 0 auto; padding: 3.5rem 1.5rem; display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; align-items: center; position: relative; }
  {% comment %} Stars-and-stripes eyebrow. The gradient rides the border via a padding-box/border-box pair so the pill interior stays flat black. {% endcomment %}
  .patches-hero__eyebrow { display: inline-flex; align-items: center; justify-content: center; gap: 0.7rem; min-width: 21rem; max-width: 100%; margin: 0 0 1rem; padding: 0.6rem 1.5rem; border: 1px solid transparent; border-radius: 999px; background: linear-gradient(#111318, #111318) padding-box, linear-gradient(90deg, #b22234, #ffffff 50%, #5b7fd4) border-box; font-size: 1rem; font-weight: 800; letter-spacing: 0.2em; text-transform: uppercase; color: #fff; }
  .patches-hero__flag { width: 1.8rem; height: 1.2rem; flex-shrink: 0; border-radius: 2px; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,0.5); display: block; }
  {% comment %} The ghost copy reserves the final width so the pill does not jitter while the letters land. {% endcomment %}
  .patches-hero__eyebrow-type { position: relative; display: inline-block; }
  {% comment %} opacity, not visibility — the ghost stays in the accessibility tree so the label is still announced while the typed copy is aria-hidden. {% endcomment %}
  .patches-hero__eyebrow-ghost { opacity: 0; }
  .patches-hero__eyebrow-out { position: absolute; left: 0; top: 0; white-space: nowrap; transition: opacity 0.3s ease; }
  .patches-hero__eyebrow-out[data-fading='true'] { opacity: 0; }
  .patches-hero__eyebrow--typing .patches-hero__eyebrow-out::after { content: ''; display: inline-block; width: 2px; height: 0.95em; margin-left: 3px; vertical-align: -0.12em; background: #e11d2f; animation: pk-eyebrow-caret 0.9s steps(1, end) infinite; }
  @keyframes pk-eyebrow-caret { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .patches-hero__eyebrow-out { transition: none; }
    .patches-hero__eyebrow--typing .patches-hero__eyebrow-out::after { animation: none; opacity: 0; }
  }
  .patches-hero__title { font-size: 2.6rem; line-height: 1.12; font-weight: 800; margin: 0 0 1rem; }
  .patches-hero__subtitle { font-size: 1.05rem; line-height: 1.55; color: #d1d5db; margin: 0 0 1.4rem; max-width: 34rem; }
  .patches-hero__props { display: flex; flex-wrap: wrap; gap: 1.25rem 1.75rem; margin-bottom: 1.75rem; }
  .patches-hero__prop { display: flex; align-items: center; gap: 0.5rem; font-size: 0.95rem; color: #e5e7eb; }
  .patches-hero__prop-icon { width: 1.15rem; height: 1.15rem; color: #10b981; flex-shrink: 0; }
  .patches-hero__buttons { display: flex; flex-wrap: wrap; gap: 0.9rem; }
  .patches-hero__btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.9rem 1.5rem; border-radius: 0.6rem; font-weight: 700; font-size: 1rem; text-decoration: none; transition: transform 0.15s, background 0.15s; }
  .patches-hero__btn:hover { transform: translateY(-1px); }
  .patches-hero__btn--primary { background: #10b981; color: #fff; }
  .patches-hero__btn--primary:hover { background: #059669; }
  .patches-hero__btn--secondary { background: #1f2937; color: #fff; border: 1px solid #374151; }
  .patches-hero__btn--secondary:hover { background: #111827; }
  .patches-hero__btn-arrow { width: 1.1rem; height: 1.1rem; }
  .patches-hero__right { position: relative; min-height: 320px; display: flex; align-items: center; justify-content: center; }
  .patches-hero__img { max-width: 100%; max-height: 420px; object-fit: contain; border-radius: 0.75rem; }
  {% comment %} Width/height stay auto so the element takes the video's own aspect ratio — forcing width:100% pillarboxes portrait clips with black bars. {% endcomment %}
  .patches-hero__video { display: block; width: auto; height: auto; max-width: 100%; max-height: var(--hero-video-height, 420px); object-fit: contain; border-radius: 0.75rem; background: transparent; }
  .patches-hero__embed { position: relative; width: 100%; max-width: 560px; aspect-ratio: 16 / 9; border-radius: 0.75rem; overflow: hidden; background: #0a0a0a; }
  .patches-hero__embed iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .patches-hero__card { position: absolute; top: 0; left: 0; background: #fff; color: #111827; border-radius: 0.6rem; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.35); z-index: 2; }
  .patches-hero__card-stats { display: flex; }
  .patches-hero__card-stat { padding: 0.8rem 1.1rem; }
  .patches-hero__card-stat + .patches-hero__card-stat { border-left: 1px solid #e5e7eb; }
  .patches-hero__card-value { font-weight: 800; font-size: 1rem; }
  .patches-hero__card-label { font-size: 0.78rem; color: #6b7280; }
  .patches-hero__card-banner { background: #10b981; color: #fff; text-align: center; font-size: 0.82rem; font-weight: 700; padding: 0.45rem 0.75rem; font-style: italic; }
  .patches-hero__badge { position: absolute; top: -1.25rem; right: 8%; z-index: 3; background: #dc2626; color: #fff; font-weight: 800; font-style: italic; font-size: 0.8rem; line-height: 1.15; text-align: center; padding: 1rem 0.8rem; border-radius: 999px; transform: rotate(12deg); box-shadow: 0 6px 18px rgba(220,38,38,0.45); }
  @media (max-width: 899px) {
    .patches-hero__inner { grid-template-columns: 1fr; padding: 2.5rem 1.25rem; }
    .patches-hero__title { font-size: 1.9rem; }
    {% comment %} The card goes static here, so the column direction is what stacks it above the media instead of squeezing both into one flex row. {% endcomment %}
    .patches-hero__right { min-height: 0; margin-top: 1rem; flex-direction: column; }
    .patches-hero__card { position: static; margin: 0 auto 1rem; width: fit-content; }
    .patches-hero__badge { top: auto; bottom: -0.5rem; right: 2%; }
  }
</style>

<section class="patches-hero">
  <div class="patches-hero__glow"></div>
  <div class="patches-hero__inner">
    <div class="patches-hero__left">
      {%- if section.settings.eyebrow_text != blank -%}
        <p
          class="patches-hero__eyebrow{% if section.settings.eyebrow_animate %} patches-hero__eyebrow--typing{% endif %}"
          id="PatchesHeroEyebrow-{{ section.id }}"
        >
          <svg class="patches-hero__flag" viewBox="0 0 26 18" role="img" aria-label="United States flag">
            <rect width="26" height="18" fill="#fff"/>
            <g fill="#b22234">
              <rect width="26" height="2.77"/>
              <rect y="5.54" width="26" height="2.77"/>
              <rect y="11.08" width="26" height="2.77"/>
              <rect y="16.62" width="26" height="1.38"/>
            </g>
            <rect width="11" height="9.69" fill="#3c3b6e"/>
            <g fill="#fff">
              <circle cx="2.4" cy="2.2" r="0.7"/><circle cx="5.5" cy="2.2" r="0.7"/><circle cx="8.6" cy="2.2" r="0.7"/>
              <circle cx="3.95" cy="4.8" r="0.7"/><circle cx="7.05" cy="4.8" r="0.7"/>
              <circle cx="2.4" cy="7.4" r="0.7"/><circle cx="5.5" cy="7.4" r="0.7"/><circle cx="8.6" cy="7.4" r="0.7"/>
            </g>
          </svg>
          {%- if section.settings.eyebrow_animate -%}
            <span class="patches-hero__eyebrow-type">
              <span class="patches-hero__eyebrow-ghost">{{ section.settings.eyebrow_text }}</span>
              <span class="patches-hero__eyebrow-out" data-eyebrow-out aria-hidden="true"></span>
            </span>
          {%- else -%}
            <span>{{ section.settings.eyebrow_text }}</span>
          {%- endif -%}
        </p>
      {%- endif -%}
      <h1 class="patches-hero__title">{{ section.settings.title }}</h1>
      <p class="patches-hero__subtitle">{{ section.settings.subtitle }}</p>
      <div class="patches-hero__props">
        {% for i in (1..3) %}
          {% assign prop_key = 'prop_' | append: i %}
          {% assign prop_text = section.settings[prop_key] %}
          {% if prop_text != blank %}
            <div class="patches-hero__prop">
              {% case forloop.index %}
                {% when 1 %}
                  <svg class="patches-hero__prop-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                {% when 2 %}
                  <svg class="patches-hero__prop-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                {% else %}
                  <svg class="patches-hero__prop-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v10"/><path d="M14.5 9.3a2.6 2.6 0 0 0-2.5-1.6 2.2 2.2 0 0 0 0 4.4 2.2 2.2 0 0 1 0 4.4 2.6 2.6 0 0 1-2.5-1.6"/></svg>
              {% endcase %}
              <span class="patches-hero__prop-label">{{ prop_text }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>
      <div class="patches-hero__buttons">
        <a class="patches-hero__btn patches-hero__btn--primary" href="{{ section.settings.btn_primary_link | default: '/products/embroidered-patches' }}">
          {{ section.settings.btn_primary_label }}
          <svg class="patches-hero__btn-arrow" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 10h10"/><path d="M11 6l4 4-4 4"/></svg>
        </a>
        <a class="patches-hero__btn patches-hero__btn--secondary" href="{{ section.settings.btn_secondary_link | default: '/pages/quote' }}">
          {{ section.settings.btn_secondary_label }}
          <svg class="patches-hero__btn-arrow" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 10h10"/><path d="M11 6l4 4-4 4"/></svg>
        </a>
      </div>
    </div>
    <div class="patches-hero__right">
      {% if section.settings.badge_text != blank %}
        <div class="patches-hero__badge">{{ section.settings.badge_text | newline_to_br }}</div>
      {% endif %}
      <div class="patches-hero__card">
        <div class="patches-hero__card-stats">
          <div class="patches-hero__card-stat">
            <div class="patches-hero__card-value">{{ section.settings.stat_1_value }}</div>
            <div class="patches-hero__card-label">{{ section.settings.stat_1_label }}</div>
          </div>
          <div class="patches-hero__card-stat">
            <div class="patches-hero__card-value">{{ section.settings.stat_2_value }}</div>
            <div class="patches-hero__card-label">{{ section.settings.stat_2_label }}</div>
          </div>
        </div>
        {% if section.settings.stat_banner != blank %}
          <div class="patches-hero__card-banner">{{ section.settings.stat_banner }}</div>
        {% endif %}
      </div>
      {%- liquid
        # Poster / fallback image: the chosen hero image, else the printed-patches
        # product shot the hero has always defaulted to.
        assign hero_img = section.settings.hero_image
        assign hero_img_alt = section.settings.hero_image.alt | default: 'Custom patches'
        unless hero_img
          assign fallback_product = all_products['full-color-printed-patches']
          assign hero_img = fallback_product.featured_image
          assign hero_img_alt = 'Custom patches collage'
        endunless
      -%}

      {%- if section.settings.hero_video != blank -%}
        <video
          class="patches-hero__video"
          style="--hero-video-height: {{ section.settings.video_max_height }}px;{% if section.settings.hero_video.aspect_ratio %} aspect-ratio: {{ section.settings.hero_video.aspect_ratio }};{% endif %}"
          {% if hero_img %}poster="{{ hero_img | image_url: width: 900 }}"{% endif %}
          {% if section.settings.video_autoplay %}autoplay muted loop{% endif %}
          {% if section.settings.video_controls %}controls{% endif %}
          playsinline
          preload="metadata"
          aria-label="{{ hero_img_alt | escape }}"
        >
          {%- for source in section.settings.hero_video.sources -%}
            <source src="{{ source.url }}" type="{{ source.mime_type }}">
          {%- endfor -%}
          {%- if hero_img -%}
            <img class="patches-hero__img" src="{{ hero_img | image_url: width: 900 }}" alt="{{ hero_img_alt | escape }}" width="900" height="{{ 900 | divided_by: hero_img.aspect_ratio | round }}" loading="eager">
          {%- endif -%}
        </video>

      {%- elsif section.settings.hero_video_url != blank -%}
        <div class="patches-hero__embed">
          {%- if section.settings.hero_video_url.type == 'youtube' -%}
            <iframe
              src="https://www.youtube.com/embed/{{ section.settings.hero_video_url.id }}?rel=0&playsinline=1{% if section.settings.video_autoplay %}&autoplay=1&mute=1&loop=1&playlist={{ section.settings.hero_video_url.id }}{% endif %}"
              title="{{ hero_img_alt | escape }}"
              allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"></iframe>
          {%- else -%}
            <iframe
              src="https://player.vimeo.com/video/{{ section.settings.hero_video_url.id }}?playsinline=1{% if section.settings.video_autoplay %}&autoplay=1&muted=1&loop=1{% endif %}"
              title="{{ hero_img_alt | escape }}"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen
              loading="lazy"></iframe>
          {%- endif -%}
        </div>

      {%- elsif hero_img -%}
        <img class="patches-hero__img" src="{{ hero_img | image_url: width: 900 }}" alt="{{ hero_img_alt | escape }}" width="900" height="{{ 900 | divided_by: hero_img.aspect_ratio | round }}" loading="eager">
      {%- endif -%}
    </div>
  </div>
</section>

{%- if section.settings.eyebrow_text != blank and section.settings.eyebrow_animate -%}
  <script>
    (function () {
      var wrap = document.getElementById('PatchesHeroEyebrow-{{ section.id }}');
      if (!wrap) return;

      var out = wrap.querySelector('[data-eyebrow-out]');
      var text = {{ section.settings.eyebrow_text | json }};
      var SPEED = {{ section.settings.eyebrow_speed | default: 110 }};
      var HOLD = 1600;
      var GAP = 500;
      if (!out || !text) return;

      // Reduced motion: show the finished line and never animate it.
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        out.textContent = text;
        return;
      }

      var timers = [];
      function later(fn, ms) {
        timers.push(window.setTimeout(fn, ms));
      }
      function stop() {
        timers.forEach(window.clearTimeout);
        timers = [];
      }

      function type(i) {
        out.textContent = text.slice(0, i);
        if (i < text.length) {
          later(function () {
            type(i + 1);
          }, SPEED);
          return;
        }
        later(vanish, HOLD);
      }

      function vanish() {
        out.setAttribute('data-fading', 'true');
        later(function () {
          out.textContent = '';
          out.removeAttribute('data-fading');
          later(function () {
            type(1);
          }, GAP);
        }, 320);
      }

      // Only run while the hero is on screen — a hidden loop is wasted work.
      var loopRunning = false;
      function start() {
        if (loopRunning) return;
        loopRunning = true;
        type(1);
      }

      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              start();
            } else if (loopRunning) {
              loopRunning = false;
              stop();
              out.textContent = '';
              out.removeAttribute('data-fading');
            }
          });
        }, { threshold: 0.1 }).observe(wrap);
      } else {
        start();
      }
    })();
  </script>
{%- endif -%}
