{% comment %}
  What the price on a product page covers, and what is added on top of it.
  A heading, then two cards side by side: the things that are included and
  the things that cost extra, each a short list.

  Every line is a block: a few words, an optional note (a detail, or the
  price for something that costs extra) and which list it belongs to.

  This section states prices and terms, so every line has to match the order
  form and the checkout on the day it is written: the product page's
  Finishing step for shapes, colors and backing, and /cart/shipping_rates.json
  for shipping. Check both before changing a line. Do not list anything here
  that cannot be checked that way.
{% endcomment %}

{% schema %}
{
  "name": "Price Includes (PK)",
  "class": "section-price-includes",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label above the heading", "default": "Pricing", "info": "Leave empty to hide." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Your Price Includes" },
    { "type": "textarea", "id": "text", "label": "Text under the heading", "default": "The price on a product page is per piece. This is what it covers, and what is added on top." },
    { "type": "text", "id": "included_title", "label": "Title of the first list", "default": "Included" },
    { "type": "text", "id": "extra_title", "label": "Title of the second list", "default": "Costs extra" },
    { "type": "color_background", "id": "background", "label": "Background (color or gradient)", "default": "#f7f4fc" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Line",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Artwork setup" },
        { "type": "text", "id": "note", "label": "Note or price", "info": "Optional. A short detail, or the price for something that costs extra." },
        {
          "type": "select", "id": "kind", "label": "List", "default": "included",
          "options": [
            { "value": "included", "label": "Included" },
            { "value": "extra", "label": "Costs extra" }
          ]
        }
      ]
    }
  ],
  "max_blocks": 14,
  "presets": [
    {
      "name": "Price Includes (PK)",
      "blocks": [
        { "type": "item", "settings": { "text": "Artwork setup", "note": "No setup fee", "kind": "included" } },
        { "type": "item", "settings": { "text": "A digital mockup when you ask for one", "note": "24–48 hours", "kind": "included" } },
        { "type": "item", "settings": { "text": "Velcro backing", "note": "+$0.25 per piece", "kind": "extra" } }
      ]
    }
  ]
}
{% endschema %}

<style>
  .pk-pi { background: var(--pi-bg, #f7f4fc); padding: 3.5rem 0; }
  .pk-pi__inner { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
  .pk-pi__head { max-width: 40rem; margin-bottom: 1.75rem; }
  .pk-pi__eyebrow { margin: 0 0 0.6rem; font-size: var(--pk-fs-label); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--pk-text-brand); }
  .pk-pi__heading { margin: 0; font-size: var(--pk-fs-heading); font-weight: 800; line-height: 1.15; letter-spacing: -0.01em; color: var(--pk-text-primary); }
  .pk-pi__text { margin: 0.7rem 0 0; font-size: var(--pk-fs-body); line-height: 1.55; color: var(--pk-text-secondary); }

  /* Two cards: the wider one holds what is included, in two columns. */
  .pk-pi__cards { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 1.25rem; align-items: start; }
  .pk-pi__cards--one { grid-template-columns: minmax(0, 1fr); }
  .pk-pi__card { padding: 1.4rem 1.5rem 1.5rem; background: #fff; border: 1px solid #e5e7eb; border-radius: var(--pk-radius-lg); }
  .pk-pi__card--extra { background: #fdfcff; border-style: dashed; border-color: #d8c8f5; }
  .pk-pi__title { margin: 0 0 1rem; font-size: var(--pk-fs-subheading); font-weight: 800; color: var(--pk-text-primary); }
  .pk-pi__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.95rem 1.5rem; }
  .pk-pi__card--included .pk-pi__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .pk-pi__item { display: flex; align-items: flex-start; gap: 0.7rem; }
  .pk-pi__icon { flex-shrink: 0; display: grid; place-items: center; width: 1.6rem; height: 1.6rem; margin-top: 0.05rem; border-radius: 50%; background: #f3e8ff; color: #7e22ce; }
  .pk-pi__card--extra .pk-pi__icon { background: #f3f4f6; color: #4b5563; }
  .pk-pi__icon svg { width: 0.95rem; height: 0.95rem; }
  .pk-pi__line { margin: 0; font-size: var(--pk-fs-body); font-weight: 700; line-height: 1.35; color: var(--pk-text-primary); }
  .pk-pi__note { display: block; margin-top: 0.15rem; font-size: var(--pk-fs-label); font-weight: 400; line-height: 1.45; color: var(--pk-text-secondary); }
  .pk-pi__card--extra .pk-pi__note { font-weight: 700; color: var(--pk-text-brand); }

  @media (max-width: 899px) {
    .pk-pi { padding: 2.5rem 0; }
    .pk-pi__cards { grid-template-columns: minmax(0, 1fr); }
    .pk-pi__heading { font-size: var(--pk-fs-heading-sm); }
  }
  @media (max-width: 599px) {
    .pk-pi__inner { padding: 0 1rem; }
    .pk-pi__card { padding: 1.15rem 1.1rem 1.25rem; }
    .pk-pi__card--included .pk-pi__list { grid-template-columns: minmax(0, 1fr); }
  }
</style>

{%- liquid
  assign pi_included = 0
  assign pi_extra = 0
  for block in section.blocks
    if block.settings.text == blank
      continue
    endif
    if block.settings.kind == 'extra'
      assign pi_extra = pi_extra | plus: 1
    else
      assign pi_included = pi_included | plus: 1
    endif
  endfor
  assign pi_total = pi_included | plus: pi_extra
-%}

{%- if pi_total > 0 -%}
<section class="pk-pi" id="included" style="--pi-bg: {{ section.settings.background | default: '#f7f4fc' }};">
  <div class="pk-pi__inner">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="pk-pi__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="pk-pi__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="pk-pi__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="pk-pi__text">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="pk-pi__cards{% if pi_included == 0 or pi_extra == 0 %} pk-pi__cards--one{% endif %}">
      {%- if pi_included > 0 -%}
        <div class="pk-pi__card pk-pi__card--included">
          {%- if section.settings.included_title != blank -%}
            <h3 class="pk-pi__title">{{ section.settings.included_title }}</h3>
          {%- endif -%}
          <ul class="pk-pi__list">
            {%- for block in section.blocks -%}
              {%- if block.settings.text == blank or block.settings.kind == 'extra' -%}{%- continue -%}{%- endif -%}
              <li class="pk-pi__item" {{ block.shopify_attributes }}>
                <span class="pk-pi__icon" aria-hidden="true">{{ 'icon-checkmark.svg' | inline_asset_content }}</span>
                <p class="pk-pi__line">
                  {{ block.settings.text }}
                  {%- if block.settings.note != blank -%}<span class="pk-pi__note">{{ block.settings.note }}</span>{%- endif -%}
                </p>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- if pi_extra > 0 -%}
        <div class="pk-pi__card pk-pi__card--extra">
          {%- if section.settings.extra_title != blank -%}
            <h3 class="pk-pi__title">{{ section.settings.extra_title }}</h3>
          {%- endif -%}
          <ul class="pk-pi__list">
            {%- for block in section.blocks -%}
              {%- if block.settings.text == blank -%}{%- continue -%}{%- endif -%}
              {%- unless block.settings.kind == 'extra' -%}{%- continue -%}{%- endunless -%}
              <li class="pk-pi__item" {{ block.shopify_attributes }}>
                <span class="pk-pi__icon" aria-hidden="true">{{ 'icon-plus.svg' | inline_asset_content }}</span>
                <p class="pk-pi__line">
                  {{ block.settings.text }}
                  {%- if block.settings.note != blank -%}<span class="pk-pi__note">{{ block.settings.note }}</span>{%- endif -%}
                </p>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}
