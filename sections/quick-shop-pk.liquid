{% schema %}
{
  "name": "Quick Shop Cards",
  "class": "section-pk-quick-shop",
  "settings": [
    { "type": "color_background", "id": "background", "label": "Background (color or gradient)", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 4,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title", "info": "Defaults to the collection's title." },
        { "type": "text", "id": "text", "label": "One line under the title" },
        { "type": "text", "id": "button", "label": "Button label", "default": "Shop now" },
        { "type": "product", "id": "photo_product", "label": "Product for the picture (optional)", "info": "Uses this product's photo. Without it: the collection's first product with a photo, else the collection's own image." },
        { "type": "image_picker", "id": "image", "label": "Picture override (optional)" }
      ]
    }
  ],
  "presets": [{ "name": "Quick Shop Cards" }]
}
{% endschema %}

{%- comment -%}
  A slim row of shop cards under the home page hero (Ready-Made Patches,
  Blank Hats): picture, title, one line, the number of products in the
  collection, and a button. The whole card is the link. A card whose
  collection is missing or empty is left out, and the row closes up.
  Pictures pass through pk-image-ok like every other product photo.
{%- endcomment -%}

<style>
  #pk-qs-{{ section.id }} { background: {{ section.settings.background | default: '#ffffff' }}; }
  .pk-qs { padding: 1.5rem 0; }
  .pk-qs__inner { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; display: grid; grid-template-columns: repeat(var(--qs-cols, 2), minmax(0, 1fr)); gap: 1rem; }
  .pk-qs__card { display: flex; align-items: center; gap: 1.1rem; min-width: 0; padding: 0.85rem 1.1rem 0.85rem 0.85rem; border: 1px solid #e9d5ff; border-radius: var(--pk-radius-lg); background: #faf5ff; color: var(--pk-text-primary); text-decoration: none; transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease; }
  .pk-qs__card:hover { border-color: #c084fc; box-shadow: 0 16px 30px -22px rgba(88, 28, 135, 0.55); transform: translateY(-1px); }
  .pk-qs__card:focus-visible { outline: 3px solid var(--pk-btn-primary-bg); outline-offset: 3px; }
  .pk-qs__pic { flex: 0 0 auto; width: 6.5rem; height: 6.5rem; border-radius: var(--pk-radius-md); overflow: hidden; background: #fff; }
  .pk-qs__pic img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pk-qs__body { flex: 1 1 auto; min-width: 0; }
  .pk-qs__title { display: block; margin: 0; font-size: var(--pk-fs-subheading); font-weight: 800; line-height: 1.2; }
  .pk-qs__text { display: block; margin: 0.3rem 0 0; font-size: var(--pk-fs-label); line-height: 1.45; color: var(--pk-text-secondary); }
  .pk-qs__count { display: inline-block; margin-top: 0.45rem; font-size: var(--pk-fs-tiny); font-weight: 700; color: #7e22ce; }
  .pk-qs__btn { flex: 0 0 auto; display: inline-flex; align-items: center; gap: 0.35rem; min-height: 2.5rem; padding: 0 1.1rem; border-radius: var(--pk-radius-sm); font-size: var(--pk-fs-label); font-weight: 700; white-space: nowrap; }
  @media (max-width: 989px) {
    .pk-qs__btn { display: none; }
  }
  @media (max-width: 749px) {
    .pk-qs { padding: 1rem 0; }
    .pk-qs__inner { grid-template-columns: minmax(0, 1fr); gap: 0.6rem; padding: 0 1rem; }
    .pk-qs__card { gap: 0.85rem; padding: 0.6rem 0.9rem 0.6rem 0.6rem; }
    .pk-qs__pic { width: 4.5rem; height: 4.5rem; }
    .pk-qs__title { font-size: var(--pk-fs-body); }
    .pk-qs__card::after { content: "\2192"; margin-left: auto; padding-left: 0.5rem; font-weight: 700; color: #7e22ce; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pk-qs__card { transition: none; }
    .pk-qs__card:hover { transform: none; }
  }
</style>

{%- capture qs_cards -%}
  {%- for block in section.blocks -%}
    {%- assign c = block.settings.collection -%}
    {%- if c == blank or c.products_count == 0 -%}{%- continue -%}{%- endif -%}

    {%- comment -%}
      The picture: override, picked product, else the first product photo
      pk-image-ok allows. The collection's own image comes last: those are
      often banners or generated art, not a photo of the product.
    {%- endcomment -%}
    {%- assign qs_img = block.settings.image -%}
    {%- if qs_img == blank and block.settings.photo_product != blank -%}
      {%- assign qs_img = block.settings.photo_product.featured_image -%}
    {%- endif -%}
    {%- if qs_img == blank -%}
      {%- for p in c.products limit: 8 -%}
        {%- if p.featured_image == blank -%}{%- continue -%}{%- endif -%}
        {%- capture qs_ok -%}{%- render 'pk-image-ok', src: p.featured_image.src -%}{%- endcapture -%}
        {%- assign qs_ok = qs_ok | strip -%}
        {%- if qs_ok != blank -%}{%- assign qs_img = p.featured_image -%}{%- break -%}{%- endif -%}
      {%- endfor -%}
    {%- endif -%}
    {%- if qs_img == blank and c.image -%}{%- assign qs_img = c.image -%}{%- endif -%}

    <a class="pk-qs__card" href="{{ c.url }}" {{ block.shopify_attributes }}>
      {%- if qs_img != blank -%}
        <span class="pk-qs__pic"><img src="{{ qs_img | image_url: width: 240, height: 240, crop: 'center' }}" width="240" height="240" loading="lazy" alt=""></span>
      {%- endif -%}
      <span class="pk-qs__body">
        <span class="pk-qs__title">{{ block.settings.title | default: c.title }}</span>
        {%- if block.settings.text != blank -%}<span class="pk-qs__text">{{ block.settings.text }}</span>{%- endif -%}
        <span class="pk-qs__count">{{ c.products_count }} {% if c.products_count == 1 %}product{% else %}products{% endif %}</span>
      </span>
      {%- if block.settings.button != blank -%}
        <span class="pk-qs__btn pk-btn-primary">{{ block.settings.button }} <span aria-hidden="true">&rarr;</span></span>
      {%- endif -%}
    </a>
  {%- endfor -%}
{%- endcapture -%}

{%- assign qs_count = qs_cards | split: 'class="pk-qs__card"' | size | minus: 1 -%}
{%- if qs_count > 0 -%}
<section id="pk-qs-{{ section.id }}" class="pk-qs" aria-label="Shop by collection">
  <div class="pk-qs__inner" style="--qs-cols: {{ qs_count }};">{{ qs_cards }}</div>
</section>
{%- endif -%}
