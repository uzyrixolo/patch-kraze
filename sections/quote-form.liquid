{%- comment -%}
  Quote request form — uses Shopify's {% form 'contact' %} so the storefront
  spam-protection (CAPTCHA) token is attached automatically. This fixes the
  "Missing CAPTCHA token" error caused by submitting a raw <form action="/contact">
  that was pasted into the page body.

  Add this section to the Contact page (theme editor) and DELETE the old
  hand-coded form from the page body content in Shopify admin.
{%- endcomment -%}

<div class="quote-form page-width" id="quote-form">
  {%- assign form_id = 'QuoteForm-' | append: section.id -%}
  {%- form 'contact', id: form_id, class: 'quote-form__form' -%}
    {%- if form.posted_successfully? -%}
      <div class="quote-form__success" tabindex="-1" autofocus>
        {{ 'blocks.contact_form.post_success' | t }}
      </div>
    {%- elsif form.errors -%}
      <div class="quote-form__error" tabindex="-1" autofocus>
        {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
      </div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="quote-form__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="quote-form__row">
      <label class="quote-form__label" for="QuoteForm-name">Name</label>
      <input type="text" id="QuoteForm-name" name="contact[name]"
        value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
        autocomplete="name">
    </div>

    <div class="quote-form__row">
      <label class="quote-form__label" for="QuoteForm-email">Email <span aria-hidden="true">*</span></label>
      <input type="email" id="QuoteForm-email" name="contact[email]" required
        value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
        autocomplete="email" spellcheck="false" autocapitalize="off">
    </div>

    <div class="quote-form__row">
      <label class="quote-form__label" for="QuoteForm-phone">Phone</label>
      <input type="tel" id="QuoteForm-phone" name="contact[phone]" pattern="[0-9\-]*"
        value="{% if form.phone %}{{ form.phone }}{% endif %}" autocomplete="tel">
    </div>

    {%- comment -%} Quote-specific fields. Any name="contact[Label]" is emailed to you. {%- endcomment -%}
    <div class="quote-form__row">
      <label class="quote-form__label" for="QuoteForm-quantity">Quantity</label>
      <input type="text" id="QuoteForm-quantity" name="contact[Quantity]">
    </div>

    <div class="quote-form__row">
      <label class="quote-form__label" for="QuoteForm-details">Details</label>
      <textarea rows="8" id="QuoteForm-details" name="contact[body]"></textarea>
    </div>

    <button type="submit" class="button quote-form__submit">
      {{ section.settings.button_label | default: 'Request a quote' }}
    </button>
  {%- endform -%}
</div>

{% stylesheet %}
  .quote-form__form { display: flex; flex-direction: column; gap: var(--gap-md); max-width: 640px; }
  .quote-form__row { display: flex; flex-direction: column; gap: var(--gap-xs); }
  .quote-form__form input,
  .quote-form__form textarea {
    width: 100%;
    color: var(--color-input-text);
    background-color: var(--color-input-background);
    padding: var(--padding-lg) var(--padding-xl);
    border-radius: var(--style-border-radius-inputs);
    border: var(--style-border-width-inputs) solid var(--color-input-border);
  }
  .quote-form__success { color: var(--color-success, #1a7f37); }
  .quote-form__error { color: var(--color-error, #d72c0d); }
{% endstylesheet %}

{% schema %}
{
  "name": "Quote form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Request a quote" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Request a quote" }
  ],
  "presets": [{ "name": "Quote form" }]
}
{% endschema %}
