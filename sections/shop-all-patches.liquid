{% schema %}
{
  "name": "Shop All Patch Types",
  "class": "section-shop-all-patches",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Shop All Patch Types"
    }
  ],
  "blocks": [
    {
      "type": "patch_item",
      "name": "Patch Type",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Patch Image",
          "info": "Upload image or use assets: embroidered-main.jpg, pvc-main.jpg, leather-main.jpg, woven-main.jpg from patch-images folder"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Patch Type"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price Text",
          "default": "As low as $1.25 ea."
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "url",
          "id": "product_url",
          "label": "Product URL"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge Text",
          "default": "10pc min"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop All Patch Types",
      "blocks": [
        {
          "type": "patch_item",
          "settings": {
            "title": "Embroidered Patches",
            "price": "As low as $1.25 ea.",
            "description": "Embroidered with premium thread on durable fabric, these patches deliver rich texture and visual detail for a quality finish on any apparel.",
            "product_url": "/products/embroidered-patches",
            "badge": "10pc min"
          }
        },
        {
          "type": "patch_item",
          "settings": {
            "title": "PVC Rubber Patches",
            "price": "As low as $1.96 ea.",
            "description": "PVC patches use advanced molding techniques to create durable, visually striking designs with crisp detailing in vibrant colors.",
            "product_url": "/products/pvc-rubber-patches",
            "badge": "10pc min"
          }
        },
        {
          "type": "patch_item",
          "settings": {
            "title": "Leather Patches",
            "price": "As low as $1.40 ea.",
            "description": "Premium leather patches with embossed or engraved designs for a sophisticated, durable look.",
            "product_url": "/products/leather-patches",
            "badge": "10pc min"
          }
        },
        {
          "type": "patch_item",
          "settings": {
            "title": "Woven Patches",
            "price": "As low as $1.50 ea.",
            "description": "Intricately woven patches with vibrant colors and detailed designs for a classic, professional appearance.",
            "product_url": "/products/woven-patches",
            "badge": "10pc min"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

  .shop-all-patches-section {
    width: 100%;
    background-color: #fff;
    padding: 2rem 1rem;
    font-family: 'Inter', sans-serif !important;
  }

  @media (min-width: 768px) {
    .shop-all-patches-section {
      padding: 5rem 1rem;
    }
  }
  .shop-patches-container {
    max-width: 1300px; /* max-w-6xl */
    margin: 0 auto;
    padding: 0; 
  }
  .shop-patches-heading {
    font-size: 1.25rem; /* xl */
    font-weight: 700;
    text-align: left;
    margin-bottom: 2rem;
    color: #000;
  }
  
  .patch-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .patch-grid { grid-template-columns: repeat(2, 1fr); gap: 2rem; }
  }
  @media (min-width: 1024px) {
    .patch-grid { grid-template-columns: repeat(4, 1fr); } 
  }
  
  .patch-card {
    display: flex;
    flex-direction: column;
  }
  
  .patch-image-wrapper {
    position: relative;
    margin-bottom: 1rem;
    background-color: #f3f4f6; /* gray-100 */
    border-radius: 0.5rem; /* rounded-lg */
    overflow: hidden;
    aspect-ratio: 1/1;
    cursor: pointer;
    display: block;
  }
  
  .patch-img-container {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  
  .patch-static-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    inset: 0;
    z-index: 10;
    transition: transform 0.5s ease;
  }
  
  /* Hover effect: Scale image */
  .patch-image-wrapper:hover .patch-static-img {
    transform: scale(1.1);
  }

  .patch-badge {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background-color: #14b8a6; /* teal-500 */
    color: #fff;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.875rem; /* sm */
    font-weight: 600;
    z-index: 20;
  }
  
  .patch-title {
    font-size: 1.125rem; /* lg */
    font-weight: 700;
    color: #000;
    margin-bottom: 0.5rem;
  }
  .patch-price {
    color: #0d9488; /* teal-600 */
    font-weight: 600;
    margin-bottom: 0.75rem;
  }
  .patch-desc {
    color: #4b5563; /* gray-600 */
    font-size: 0.875rem; /* sm */
    margin-bottom: 1rem;
    flex-grow: 1;
  }
  
  @media (max-width: 768px) {
    .patch-desc { display: none; }
  }
  
  .btn-customize {
    background-color: #000;
    color: #fff;
    padding: 0.5rem 1.5rem;
    border-radius: 0.25rem;
    font-weight: 600;
    transition: background-color 0.2s;
    width: fit-content; /* w-fit */
    display: inline-block;
    text-decoration: none;
    border: none;
    cursor: pointer;
  }
  .btn-customize:hover {
    background-color: #1f2937; /* gray-800 */
  }
</style>

<div class="shop-all-patches-section">
  <div class="shop-patches-container">
    {% if section.settings.heading != blank %}
      <h2 class="shop-patches-heading">{{ section.settings.heading }}</h2>
    {% endif %}
    
    <div class="patch-grid">
      {% for block in section.blocks %}
        <div class="patch-card" {{ block.shopify_attributes }}>
          {% if block.settings.product_url != blank %}
            <a href="{{ block.settings.product_url }}" class="patch-image-wrapper group">
              <div class="patch-img-container">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 800 | image_tag: alt: block.settings.title, width: 800, height: 800, class: 'patch-static-img' }}
                {% else %}
                  <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: white; font-size: 1.5rem;">{{ block.settings.title }}</div>
                {% endif %}
              </div>
              {% if block.settings.badge != blank %}
                <div class="patch-badge">{{ block.settings.badge }}</div>
              {% endif %}
            </a>
          {% endif %}
          
          {% if block.settings.title != blank %}
            <h3 class="patch-title">{{ block.settings.title }}</h3>
          {% endif %}
          
          {% if block.settings.price != blank %}
            <p class="patch-price">{{ block.settings.price }}</p>
          {% endif %}
          
          {% if block.settings.description != blank %}
            <p class="patch-desc">{{ block.settings.description }}</p>
          {% endif %}
          
          {% if block.settings.product_url != blank %}
            <a href="{{ block.settings.product_url }}" class="btn-customize">Customize</a>
          {% endif %}
        </div>
      {% endfor %}

    </div>
  </div>
</div>
