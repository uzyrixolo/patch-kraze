{% comment %}
  Homepage grid of product styles. Each block picks a product and becomes a
  card: the product's photo, its name, its lowest per-piece price, up to two
  short points about the style, then a button to the product page and a text
  link to the quote form.

  The price is read live from the product (its cheapest variant), so it never
  needs updating here. The two points are typed per card: keep them to plain
  facts about the style, in Patch Kraze's own words.

  Optional filter tabs ("Show filter tabs"): each card is tagged with a group
  and/or "most popular", and the tab row filters the cards client-side. Every
  card is always in the HTML - without JS they all simply show - and the first
  tab lists the full set, so no product is ever unreachable.

  Phones: "Layout on phones" picks between one row that is swiped sideways and
  a two-per-row grid.

  Background: a color or gradient, or a picture (with its own mobile version
  and a tint). "Heading color" switches the heading, link and selected tab to
  suit a dark background; the cards themselves always stay white.
{% endcomment %}

{% schema %}
{
  "name": "Style Grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Section heading (blank to hide)", "default": "Browse Every Patch Style" },
    { "type": "range", "id": "columns", "label": "Cards per row (desktop)", "min": 3, "max": 5, "step": 1, "default": 4 },
    {
      "type": "select", "id": "mobile_layout", "label": "Layout on phones", "default": "swipe",
      "options": [
        { "value": "swipe", "label": "One row, swipe sideways" },
        { "value": "grid", "label": "Grid, two per row" }
      ]
    },
    { "type": "text", "id": "view_all_label", "label": "View-all link label", "default": "See the Full Lineup" },
    { "type": "url", "id": "view_all_link", "label": "View-all link" },
    { "type": "text", "id": "rail_label", "label": "Label (shown when tabs are off)", "default": "Customer Favorites" },
    { "type": "text", "id": "rail_sub", "label": "Subtext (shown when tabs are off)", "default": "The styles our customers reorder most" },
    { "type": "header", "content": "Background" },
    { "type": "color_background", "id": "background", "label": "Background (color or gradient)", "default": "#f7f4fc", "info": "Sits behind the white cards. Hidden by a background image when one is set below." },
    { "type": "image_picker", "id": "bg_image", "label": "Background image", "info": "Optional. Fills the whole section behind the cards and is cropped to fit." },
    { "type": "image_picker", "id": "bg_image_mobile", "label": "Background image, mobile", "info": "Optional. Used on screens under 750px; falls back to the image above." },
    { "type": "range", "id": "bg_tint", "label": "Tint over the image", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 30, "info": "Light tint behind a dark heading, dark tint behind a white one. 0 turns it off." },
    {
      "type": "select", "id": "text_tone", "label": "Heading color", "default": "dark",
      "options": [
        { "value": "dark", "label": "Dark (for light backgrounds)" },
        { "value": "light", "label": "White (for dark backgrounds)" }
      ]
    },
    { "type": "header", "content": "Cards" },
    { "type": "text", "id": "price_prefix", "label": "Text before the price", "default": "From" },
    { "type": "text", "id": "price_suffix", "label": "Text after the price", "default": "each in bulk", "info": "The price shown is the product's lowest per-piece price, which applies at its largest quantity tier." },
    { "type": "text", "id": "btn_label", "label": "Button label", "default": "Start Your Order", "info": "Goes to the product page. Leave empty to hide." },
    { "type": "text", "id": "link_label", "label": "Text link label", "default": "Get a quote", "info": "Leave empty to hide." },
    { "type": "url", "id": "link_url", "label": "Text link", "info": "Defaults to /pages/quote." },
    { "type": "header", "content": "Filter tabs" },
    { "type": "checkbox", "id": "show_tabs", "label": "Show filter tabs", "info": "Filters cards by each card's Group / Most popular setting. The label and subtext above are replaced by the tab row.", "default": false },
    { "type": "text", "id": "best_tab_label", "label": "Top-picks tab label", "default": "Top Picks" },
    { "type": "text", "id": "all_tab_label", "label": "All tab label", "default": "Everything" }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Image override (optional)" },
        { "type": "text", "id": "point_1", "label": "Point 1", "info": "A short fact about this style, about 35 characters. Leave empty to hide." },
        { "type": "text", "id": "point_2", "label": "Point 2" },
        {
          "type": "select", "id": "group", "label": "Group (filter tabs)", "default": "",
          "options": [
            { "value": "", "label": "None" },
            { "value": "embroidered", "label": "Embroidered & Woven" },
            { "value": "printed", "label": "Printed & Flex" },
            { "value": "pvc", "label": "PVC & Rubber" },
            { "value": "leather", "label": "Leather" }
          ]
        },
        { "type": "checkbox", "id": "best_seller", "label": "Top pick", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Style Grid" }]
}
{% endschema %}

<style>
  .pk-sg { position: relative; background: var(--sg-bg, #f7f4fc); padding: 3rem 0; scroll-margin-top: 5rem; }
  .pk-sg__inner { position: relative; z-index: 1; max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
  .pk-sg__top { display: flex; align-items: baseline; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
  .pk-sg__heading { font-size: var(--pk-fs-heading); font-weight: 800; margin: 0; color: var(--pk-text-primary); }
  .pk-sg__all { font-size: var(--pk-fs-body); font-weight: 600; color: var(--pk-text-link); text-decoration: none; border-left: 1px solid #d1d5db; padding-left: 1rem; }
  .pk-sg__all:hover { color: var(--pk-text-link-hover); }
  /* White heading and link for a dark background. The selected tab turns
     purple, since its usual near-black would disappear. */
  .pk-sg--light .pk-sg__heading, .pk-sg--light .pk-sg__label, .pk-sg--light .pk-sg__all, .pk-sg--light .pk-sg__all:hover { color: #fff; }
  .pk-sg--light .pk-sg__sub { color: #e5e7eb; }
  .pk-sg--light .pk-sg__all { border-left-color: rgba(255, 255, 255, 0.4); }
  .pk-sg--light .pk-sg__all:hover { text-decoration: underline; text-underline-offset: 3px; }
  .pk-sg--light .pk-sg__tab[aria-selected="true"] { background: var(--pk-btn-primary-bg); border-color: var(--pk-btn-primary-bg); color: #fff; }
  .pk-sg--light .pk-sg__tab[aria-selected="true"] .pk-sg__tab-count { color: #f3e8ff; }
  .pk-sg__label { font-size: var(--pk-fs-heading-sm); font-weight: 800; margin: 0; color: var(--pk-text-primary); }
  .pk-sg__sub { font-size: var(--pk-fs-body); color: var(--pk-text-secondary); margin: 0.15rem 0 1rem; }

  .pk-sg__tabs { display: flex; gap: 0.5rem; margin: 0 0 1.75rem; padding: 0.15rem; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
  .pk-sg__tabs::-webkit-scrollbar { display: none; }
  .pk-sg__tab { flex: 0 0 auto; display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.55rem 1rem; border: 1px solid #d1d5db; border-radius: var(--pk-radius-pill); background: #fff; color: var(--pk-text-primary); font: inherit; font-size: var(--pk-fs-label); font-weight: 600; cursor: pointer; white-space: nowrap; transition: background var(--pk-btn-transition), border-color var(--pk-btn-transition), color var(--pk-btn-transition); }
  .pk-sg__tab:hover { border-color: var(--pk-text-primary); }
  .pk-sg__tab:focus-visible { outline: 2px solid var(--pk-btn-primary-bg); outline-offset: 2px; }
  .pk-sg__tab[aria-selected="true"] { background: var(--pk-btn-dark-bg); border-color: var(--pk-btn-dark-bg); color: var(--pk-btn-dark-fg); }
  .pk-sg__tab-count { font-weight: 500; color: var(--pk-text-muted); }
  .pk-sg__tab[aria-selected="true"] .pk-sg__tab-count { color: var(--pk-text-inverse-secondary); }

  /* Cards: a bordered panel holding the photo, then the text, with the two
     actions pinned to the bottom so they line up across a row. */
  .pk-sg__grid { display: grid; grid-template-columns: repeat(var(--sg-desktop-cols, 4), minmax(0, 1fr)); gap: 1.25rem; }
  /* The base theme's layered-slideshow section styles every [role="tabpanel"]
     on the site (width, height, stacking). Undo that here. */
  .pk-sg__grid[role="tabpanel"] { width: auto; height: auto; min-width: 0; min-height: 0; z-index: auto; border-radius: 0; }
  .pk-sg__cell { display: flex; flex-direction: column; min-width: 0; padding: 0.4rem; background: #fff; border: 1px solid #e5e7eb; border-radius: var(--pk-radius-lg); transition: border-color 0.15s ease, box-shadow 0.15s ease; }
  .pk-sg__cell[hidden] { display: none; }
  .pk-sg__cell:hover { border-color: #d8b4fe; box-shadow: 0 18px 32px -24px rgba(88, 28, 135, 0.5); }
  .pk-sg__photo { display: block; aspect-ratio: 1 / 1; border-radius: calc(var(--pk-radius-lg) - 0.35rem); overflow: hidden; background: #f3f4f6; }
  .pk-sg__photo img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease; }
  .pk-sg__cell:hover .pk-sg__photo img { transform: scale(1.04); }
  .pk-sg__body { display: flex; flex-direction: column; flex: 1; padding: 0.85rem 0.6rem 0.6rem; }
  .pk-sg__name { margin: 0; font-size: var(--pk-fs-body); font-weight: 700; line-height: 1.3; }
  .pk-sg__name a { color: var(--pk-text-primary); text-decoration: none; }
  .pk-sg__name a:hover { color: var(--pk-text-brand); }
  .pk-sg__from { margin: 0.3rem 0 0; font-size: var(--pk-fs-label); line-height: 1.4; color: var(--pk-text-muted); }
  .pk-sg__from strong { font-weight: 700; color: var(--pk-text-brand); }
  .pk-sg__points { list-style: none; margin: 0.6rem 0 0; padding: 0; display: grid; gap: 0.2rem; font-size: var(--pk-fs-label); line-height: 1.4; color: var(--pk-text-secondary); }
  .pk-sg__points li { position: relative; padding-left: 0.8rem; }
  .pk-sg__points li::before { content: ""; position: absolute; left: 0; top: 0.55em; width: 0.3rem; height: 0.3rem; border-radius: 50%; background: #c084fc; }
  .pk-sg__actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 0.75rem; margin-top: auto; padding-top: 0.9rem; }
  .pk-sg__btn { display: inline-flex; align-items: center; justify-content: center; min-height: 2.5rem; padding: 0 1.15rem; border-radius: var(--pk-radius-sm); font-size: var(--pk-fs-label); font-weight: 700; text-decoration: none; white-space: nowrap; }
  .pk-sg__link { font-size: var(--pk-fs-label); font-weight: 600; color: var(--pk-text-primary); text-decoration: none; white-space: nowrap; }
  .pk-sg__link:hover { color: var(--pk-text-brand); }
  .pk-sg__link:focus-visible, .pk-sg__name a:focus-visible { outline: 2px solid var(--pk-btn-primary-bg); outline-offset: 2px; border-radius: 0.25rem; }

  @media (max-width: 1099px) {
    .pk-sg__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 749px) {
    .pk-sg { padding: 2.25rem 0; }
    .pk-sg__heading { font-size: var(--pk-fs-heading-sm); }
    .pk-sg__top { gap: 0.35rem 1rem; margin-bottom: 1.1rem; }
    .pk-sg__all { border-left: none; padding-left: 0; font-size: var(--pk-fs-label); }
    /* Tab row bleeds to the screen edge so it reads as swipeable. */
    .pk-sg__tabs { margin: 0 -1.5rem 1.25rem; padding-left: 1.5rem; padding-right: 1.5rem; }

    /* Swipe: one row, most of a card in view and the next one peeking in. */
    .pk-sg--swipe .pk-sg__grid { display: flex; gap: 0.85rem; margin: 0 -1.5rem; padding: 0 1.5rem 0.5rem; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scroll-padding: 0 1.5rem; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
    .pk-sg--swipe .pk-sg__grid::-webkit-scrollbar { display: none; }
    .pk-sg--swipe .pk-sg__cell { flex: 0 0 78%; max-width: 19rem; scroll-snap-align: start; }
    .pk-sg--swipe .pk-sg__btn { padding: 0 0.95rem; }

    /* Grid: two narrow cards, so the actions stack. */
    .pk-sg--grid .pk-sg__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; }
    .pk-sg--grid .pk-sg__body { padding: 0.7rem 0.35rem 0.4rem; }
    .pk-sg--grid .pk-sg__name { font-size: var(--pk-fs-label); }
    .pk-sg--grid .pk-sg__from, .pk-sg--grid .pk-sg__points { font-size: var(--pk-fs-tiny); }
    .pk-sg--grid .pk-sg__actions { flex-direction: column; align-items: stretch; text-align: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pk-sg__cell, .pk-sg__photo img { transition: none; }
  }
</style>

{%- liquid
  assign total_count = 0
  assign best_count = 0
  assign emb_count = 0
  assign printed_count = 0
  assign pvc_count = 0
  assign leather_count = 0
  for block in section.blocks
    if block.settings.product != blank
      assign total_count = total_count | plus: 1
      if block.settings.best_seller
        assign best_count = best_count | plus: 1
      endif
      case block.settings.group
        when 'embroidered'
          assign emb_count = emb_count | plus: 1
        when 'printed'
          assign printed_count = printed_count | plus: 1
        when 'pvc'
          assign pvc_count = pvc_count | plus: 1
        when 'leather'
          assign leather_count = leather_count | plus: 1
      endcase
    endif
  endfor

  assign quote_link = section.settings.link_url | default: '/pages/quote'
-%}

<section class="pk-sg pk-sg--{{ section.settings.mobile_layout | default: 'swipe' }}{% if section.settings.text_tone == 'light' %} pk-sg--light{% endif %}" id="styles" style="--sg-desktop-cols: {{ section.settings.columns | default: 4 }}; --sg-bg: {{ section.settings.background | default: '#f7f4fc' }};">
  {%- render 'pk-section-bg', image: section.settings.bg_image, image_mobile: section.settings.bg_image_mobile, tint: section.settings.bg_tint, tone: section.settings.text_tone -%}
  <div class="pk-sg__inner">
    {%- if section.settings.heading != blank -%}
      <div class="pk-sg__top">
        <h2 class="pk-sg__heading">{{ section.settings.heading }}</h2>
        {%- if section.settings.view_all_label != blank -%}
          <a class="pk-sg__all" href="{{ section.settings.view_all_link | default: '/collections/all' }}">{{ section.settings.view_all_label }} &rarr;</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_tabs -%}
      <div class="pk-sg__tabs" role="tablist" aria-label="{{ section.settings.heading | default: 'Product styles' | escape }}" data-sg-tabs>
        <button type="button" class="pk-sg__tab" role="tab" aria-selected="true" aria-controls="sg-grid-{{ section.id }}" data-sg-filter="all">{{ section.settings.all_tab_label }} <span class="pk-sg__tab-count">{{ total_count }}</span></button>
        {%- if best_count > 0 -%}
          <button type="button" class="pk-sg__tab" role="tab" aria-selected="false" aria-controls="sg-grid-{{ section.id }}" data-sg-filter="best">{{ section.settings.best_tab_label }} <span class="pk-sg__tab-count">{{ best_count }}</span></button>
        {%- endif -%}
        {%- if emb_count > 0 -%}
          <button type="button" class="pk-sg__tab" role="tab" aria-selected="false" aria-controls="sg-grid-{{ section.id }}" data-sg-filter="embroidered">Embroidered &amp; Woven <span class="pk-sg__tab-count">{{ emb_count }}</span></button>
        {%- endif -%}
        {%- if printed_count > 0 -%}
          <button type="button" class="pk-sg__tab" role="tab" aria-selected="false" aria-controls="sg-grid-{{ section.id }}" data-sg-filter="printed">Printed &amp; Flex <span class="pk-sg__tab-count">{{ printed_count }}</span></button>
        {%- endif -%}
        {%- if pvc_count > 0 -%}
          <button type="button" class="pk-sg__tab" role="tab" aria-selected="false" aria-controls="sg-grid-{{ section.id }}" data-sg-filter="pvc">PVC &amp; Rubber <span class="pk-sg__tab-count">{{ pvc_count }}</span></button>
        {%- endif -%}
        {%- if leather_count > 0 -%}
          <button type="button" class="pk-sg__tab" role="tab" aria-selected="false" aria-controls="sg-grid-{{ section.id }}" data-sg-filter="leather">Leather <span class="pk-sg__tab-count">{{ leather_count }}</span></button>
        {%- endif -%}
      </div>
    {%- elsif section.settings.rail_label != blank -%}
      <h3 class="pk-sg__label">{{ section.settings.rail_label }}</h3>
      {%- if section.settings.rail_sub != blank -%}
        <p class="pk-sg__sub">{{ section.settings.rail_sub }}</p>
      {%- endif -%}
    {%- endif -%}

    <div class="pk-sg__grid" id="sg-grid-{{ section.id }}"{% if section.settings.show_tabs %} role="tabpanel"{% endif %}>
      {%- for block in section.blocks -%}
        {%- assign product = block.settings.product -%}
        {%- if product != blank -%}
          {%- assign card_image = block.settings.image | default: product.featured_image -%}
          <article class="pk-sg__cell" data-sg-group="{{ block.settings.group }}"{% if block.settings.best_seller %} data-sg-best{% endif %} {{ block.shopify_attributes }}>
            {%- comment -%} The photo repeats the name link, so it is kept out of the tab order. {%- endcomment -%}
            <a class="pk-sg__photo" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
              {%- if card_image -%}
                <img src="{{ card_image | image_url: width: 600, height: 600, crop: 'center' }}" width="600" height="600" loading="lazy" alt="">
              {%- endif -%}
            </a>
            <div class="pk-sg__body">
              <h3 class="pk-sg__name"><a href="{{ product.url }}">{{ product.title }}</a></h3>
              <p class="pk-sg__from">{{ section.settings.price_prefix }} <strong>{{ product.price_min | money }}</strong> {{ section.settings.price_suffix }}</p>
              {%- if block.settings.point_1 != blank or block.settings.point_2 != blank -%}
                <ul class="pk-sg__points">
                  {%- if block.settings.point_1 != blank -%}<li>{{ block.settings.point_1 }}</li>{%- endif -%}
                  {%- if block.settings.point_2 != blank -%}<li>{{ block.settings.point_2 }}</li>{%- endif -%}
                </ul>
              {%- endif -%}
              {%- if section.settings.btn_label != blank or section.settings.link_label != blank -%}
                <div class="pk-sg__actions">
                  {%- if section.settings.btn_label != blank -%}
                    <a class="pk-sg__btn pk-btn-primary" href="{{ product.url }}" aria-label="{{ section.settings.btn_label | escape }}: {{ product.title | escape }}">{{ section.settings.btn_label }}</a>
                  {%- endif -%}
                  {%- if section.settings.link_label != blank -%}
                    <a class="pk-sg__link" href="{{ quote_link }}">{{ section.settings.link_label }} &rarr;</a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if section.settings.show_tabs -%}
<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    var list = root.querySelector('[data-sg-tabs]');
    if (!list) return;
    var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-sg-filter]'));
    var grid = root.querySelector('.pk-sg__grid');
    var cells = root.querySelectorAll('.pk-sg__cell');

    function show(filter) {
      tabs.forEach(function (tab) {
        tab.setAttribute('aria-selected', tab.dataset.sgFilter === filter ? 'true' : 'false');
      });
      cells.forEach(function (cell) {
        var match = filter === 'all' ||
          (filter === 'best' ? cell.hasAttribute('data-sg-best') : cell.dataset.sgGroup === filter);
        cell.hidden = !match;
      });
      // On phones the cards sit in one swiped row: start each filter at its first card.
      if (grid) grid.scrollLeft = 0;
    }

    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () { show(tab.dataset.sgFilter); });
    });
    list.addEventListener('keydown', function (event) {
      if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
      var i = tabs.indexOf(document.activeElement);
      if (i < 0) return;
      var next = tabs[(i + (event.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
      next.focus();
      next.click();
      event.preventDefault();
    });
  })();
</script>
{%- endif -%}
