{% comment %}
  Homepage grid of product styles. Each block picks a product; the tile shows
  that product's photo in a round frame with its name and starting price
  underneath, and the whole tile links to the product.

  Optional filter tabs ("Show filter tabs"): each tile is tagged with a group
  and/or "most popular", and the tab row filters the grid client-side. Every
  tile is always in the HTML - without JS they all simply show - and the first
  tab lists the full set, so no product is ever unreachable.
{% endcomment %}

{% schema %}
{
  "name": "Style Grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Section heading (blank to hide)", "default": "Browse Every Patch Style" },
    { "type": "range", "id": "columns", "label": "Tiles per row (desktop)", "min": 4, "max": 6, "step": 1, "default": 6 },
    { "type": "text", "id": "view_all_label", "label": "View-all link label", "default": "See the Full Lineup" },
    { "type": "url", "id": "view_all_link", "label": "View-all link" },
    { "type": "text", "id": "rail_label", "label": "Label (shown when tabs are off)", "default": "Customer Favorites" },
    { "type": "text", "id": "rail_sub", "label": "Subtext (shown when tabs are off)", "default": "The styles our customers reorder most" },
    { "type": "header", "content": "Filter tabs" },
    { "type": "checkbox", "id": "show_tabs", "label": "Show filter tabs", "info": "Filters tiles by each tile's Group / Most popular setting. The label and subtext above are replaced by the tab row.", "default": false },
    { "type": "text", "id": "best_tab_label", "label": "Most-popular tab label", "default": "Most Popular" },
    { "type": "text", "id": "all_tab_label", "label": "All tab label", "default": "Everything" }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Tile",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Image override (optional)" },
        {
          "type": "select", "id": "group", "label": "Group (filter tabs)", "default": "",
          "options": [
            { "value": "", "label": "None" },
            { "value": "embroidered", "label": "Embroidered & Woven" },
            { "value": "printed", "label": "Printed & Flex" },
            { "value": "pvc", "label": "PVC & Rubber" },
            { "value": "leather", "label": "Leather" }
          ]
        },
        { "type": "checkbox", "id": "best_seller", "label": "Most popular", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Style Grid" }]
}
{% endschema %}

<style>
  .pk-sg { background: #fff; padding: 3rem 0; }
  .pk-sg__inner { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
  .pk-sg__top { display: flex; align-items: baseline; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
  .pk-sg__heading { font-size: var(--pk-fs-heading); font-weight: 800; margin: 0; color: var(--pk-text-primary); }
  .pk-sg__all { font-size: var(--pk-fs-body); font-weight: 600; color: var(--pk-text-link); text-decoration: none; border-left: 1px solid #d1d5db; padding-left: 1rem; }
  .pk-sg__all:hover { color: var(--pk-text-link-hover); }
  .pk-sg__label { font-size: var(--pk-fs-heading-sm); font-weight: 800; margin: 0; color: var(--pk-text-primary); }
  .pk-sg__sub { font-size: var(--pk-fs-body); color: var(--pk-text-secondary); margin: 0.15rem 0 1rem; }

  .pk-sg__tabs { display: flex; gap: 0.5rem; margin: 0 0 1.75rem; padding: 0.15rem; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
  .pk-sg__tabs::-webkit-scrollbar { display: none; }
  .pk-sg__tab { flex: 0 0 auto; display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.55rem 1rem; border: 1px solid #d1d5db; border-radius: var(--pk-radius-pill); background: #fff; color: var(--pk-text-primary); font: inherit; font-size: var(--pk-fs-label); font-weight: 600; cursor: pointer; white-space: nowrap; transition: background var(--pk-btn-transition), border-color var(--pk-btn-transition), color var(--pk-btn-transition); }
  .pk-sg__tab:hover { border-color: var(--pk-text-primary); }
  .pk-sg__tab:focus-visible { outline: 2px solid var(--pk-btn-primary-bg); outline-offset: 2px; }
  .pk-sg__tab[aria-selected="true"] { background: var(--pk-btn-dark-bg); border-color: var(--pk-btn-dark-bg); color: var(--pk-btn-dark-fg); }
  .pk-sg__tab-count { font-weight: 500; color: var(--pk-text-muted); }
  .pk-sg__tab[aria-selected="true"] .pk-sg__tab-count { color: var(--pk-text-inverse-secondary); }

  /* Tiles: round photo, caption underneath. The ring is an outline so it
     never changes the tile's size on hover. */
  .pk-sg__grid { display: grid; grid-template-columns: repeat(var(--sg-desktop-cols, 6), minmax(0, 1fr)); gap: 2.25rem 1.5rem; }
  .pk-sg__cell { display: flex; min-width: 0; }
  .pk-sg__cell[hidden] { display: none; }
  .pk-sg__card { display: flex; flex-direction: column; align-items: center; width: 100%; text-align: center; text-decoration: none; color: inherit; }
  .pk-sg__photo { width: 100%; aspect-ratio: 1 / 1; border-radius: 50%; overflow: hidden; background: #f3f4f6; box-shadow: 0 0 0 1px rgba(17, 24, 39, 0.08); outline: 3px solid transparent; outline-offset: 4px; transition: outline-color 0.15s ease; }
  .pk-sg__photo img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.3s ease; }
  .pk-sg__card:hover .pk-sg__photo,
  .pk-sg__card:focus-visible .pk-sg__photo { outline-color: var(--pk-btn-primary-bg); }
  .pk-sg__card:focus-visible { outline: none; }
  .pk-sg__card:hover .pk-sg__photo img { transform: scale(1.06); }
  .pk-sg__name { margin-top: 0.9rem; font-size: var(--pk-fs-body); font-weight: 700; line-height: 1.3; color: var(--pk-text-primary); }
  .pk-sg__card:hover .pk-sg__name { text-decoration: underline; text-underline-offset: 3px; }
  .pk-sg__from { margin-top: 0.2rem; font-size: var(--pk-fs-label); color: var(--pk-text-muted); }
  .pk-sg__from strong { font-weight: 700; color: var(--pk-text-brand); }

  @media (max-width: 1099px) {
    .pk-sg__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (max-width: 699px) {
    .pk-sg__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem 1rem; }
    .pk-sg__heading { font-size: var(--pk-fs-heading-mobile); }
    /* Tab row bleeds to the screen edge so it reads as swipeable. */
    .pk-sg__tabs { margin-left: -1.5rem; margin-right: -1.5rem; padding-left: 1.5rem; padding-right: 1.5rem; }
  }
  @media (max-width: 479px) {
    .pk-sg__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem 1.25rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pk-sg__photo, .pk-sg__photo img { transition: none; }
  }
</style>

{%- liquid
  assign total_count = 0
  assign best_count = 0
  assign emb_count = 0
  assign printed_count = 0
  assign pvc_count = 0
  assign leather_count = 0
  for block in section.blocks
    if block.settings.product != blank
      assign total_count = total_count | plus: 1
      if block.settings.best_seller
        assign best_count = best_count | plus: 1
      endif
      case block.settings.group
        when 'embroidered'
          assign emb_count = emb_count | plus: 1
        when 'printed'
          assign printed_count = printed_count | plus: 1
        when 'pvc'
          assign pvc_count = pvc_count | plus: 1
        when 'leather'
          assign leather_count = leather_count | plus: 1
      endcase
    endif
  endfor
-%}

<section class="pk-sg" style="--sg-desktop-cols: {{ section.settings.columns | default: 6 }};{% if section.settings.heading == blank %} padding-top: 0;{% endif %}">
  <div class="pk-sg__inner">
    {%- if section.settings.heading != blank -%}
      <div class="pk-sg__top">
        <h2 class="pk-sg__heading">{{ section.settings.heading }}</h2>
        {%- if section.settings.view_all_label != blank -%}
          <a class="pk-sg__all" href="{{ section.settings.view_all_link | default: '/collections/all' }}">{{ section.settings.view_all_label }} &rarr;</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_tabs -%}
      <div class="pk-sg__tabs" role="tablist" aria-label="{{ section.settings.heading | default: 'Product styles' | escape }}" data-sg-tabs>
        <button type="button" class="pk-sg__tab" role="tab" aria-selected="true" aria-controls="sg-grid-{{ section.id }}" data-sg-filter="all">{{ section.settings.all_tab_label }} <span class="pk-sg__tab-count">{{ total_count }}</span></button>
        {%- if best_count > 0 -%}
          <button type="button" class="pk-sg__tab" role="tab" aria-selected="false" aria-controls="sg-grid-{{ section.id }}" data-sg-filter="best">{{ section.settings.best_tab_label }} <span class="pk-sg__tab-count">{{ best_count }}</span></button>
        {%- endif -%}
        {%- if emb_count > 0 -%}
          <button type="button" class="pk-sg__tab" role="tab" aria-selected="false" aria-controls="sg-grid-{{ section.id }}" data-sg-filter="embroidered">Embroidered &amp; Woven <span class="pk-sg__tab-count">{{ emb_count }}</span></button>
        {%- endif -%}
        {%- if printed_count > 0 -%}
          <button type="button" class="pk-sg__tab" role="tab" aria-selected="false" aria-controls="sg-grid-{{ section.id }}" data-sg-filter="printed">Printed &amp; Flex <span class="pk-sg__tab-count">{{ printed_count }}</span></button>
        {%- endif -%}
        {%- if pvc_count > 0 -%}
          <button type="button" class="pk-sg__tab" role="tab" aria-selected="false" aria-controls="sg-grid-{{ section.id }}" data-sg-filter="pvc">PVC &amp; Rubber <span class="pk-sg__tab-count">{{ pvc_count }}</span></button>
        {%- endif -%}
        {%- if leather_count > 0 -%}
          <button type="button" class="pk-sg__tab" role="tab" aria-selected="false" aria-controls="sg-grid-{{ section.id }}" data-sg-filter="leather">Leather <span class="pk-sg__tab-count">{{ leather_count }}</span></button>
        {%- endif -%}
      </div>
    {%- elsif section.settings.rail_label != blank -%}
      <h3 class="pk-sg__label">{{ section.settings.rail_label }}</h3>
      {%- if section.settings.rail_sub != blank -%}
        <p class="pk-sg__sub">{{ section.settings.rail_sub }}</p>
      {%- endif -%}
    {%- endif -%}

    <div class="pk-sg__grid" id="sg-grid-{{ section.id }}"{% if section.settings.show_tabs %} role="tabpanel"{% endif %}>
      {%- for block in section.blocks -%}
        {%- assign product = block.settings.product -%}
        {%- if product != blank -%}
          {%- assign tile_image = block.settings.image | default: product.featured_image -%}
          <div class="pk-sg__cell" data-sg-group="{{ block.settings.group }}"{% if block.settings.best_seller %} data-sg-best{% endif %} {{ block.shopify_attributes }}>
            <a class="pk-sg__card" href="{{ product.url }}">
              <span class="pk-sg__photo">
                {%- if tile_image -%}
                  <img src="{{ tile_image | image_url: width: 480, height: 480, crop: 'center' }}" width="480" height="480" loading="lazy" alt="">
                {%- endif -%}
              </span>
              <span class="pk-sg__name">{{ product.title }}</span>
              <span class="pk-sg__from">from <strong>{{ product.price_min | money }}</strong></span>
            </a>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if section.settings.show_tabs -%}
<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    var list = root.querySelector('[data-sg-tabs]');
    if (!list) return;
    var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-sg-filter]'));
    var cells = root.querySelectorAll('.pk-sg__cell');

    function show(filter) {
      tabs.forEach(function (tab) {
        tab.setAttribute('aria-selected', tab.dataset.sgFilter === filter ? 'true' : 'false');
      });
      cells.forEach(function (cell) {
        var match = filter === 'all' ||
          (filter === 'best' ? cell.hasAttribute('data-sg-best') : cell.dataset.sgGroup === filter);
        cell.hidden = !match;
      });
    }

    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () { show(tab.dataset.sgFilter); });
    });
    list.addEventListener('keydown', function (event) {
      if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
      var i = tabs.indexOf(document.activeElement);
      if (i < 0) return;
      var next = tabs[(i + (event.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
      next.focus();
      next.click();
      event.preventDefault();
    });
  })();
</script>
{%- endif -%}
