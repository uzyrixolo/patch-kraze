{% schema %}
{
  "name": "Testimonials PK",
  "class": "section-testimonials-patch-kraze",
  "settings": [],
  "presets": [
    {
      "name": "Testimonials PK"
    }
  ]
}
{% endschema %}

{% comment %}
  Only genuine reviews from Patch Kraze customers belong in this section, word
  for word as the customer wrote them. Do not add a "Verified buyer" entry that
  cannot be traced to a real Patch Kraze order.
{% endcomment %}

<style>
  .testimonials-section {
    width: 100%;
    background-color: #faf7ff;
    overflow: hidden;
    padding: 4rem 0;
  }

  .testimonials-header {
    text-align: center;
    margin-bottom: 5rem;
    padding: 0 1rem;
  }
  .testimonials-title {
    font-size: 2rem; /* 5xl */
    font-weight: 700;
    color: #111827;
    margin-bottom: 1rem;
    line-height: 1.1;
  }
  .testimonials-subtitle {
    font-size: 1.125rem; /* lg */
    color: #6b7280;
  }

  /* Marquee Containers */
  .marquee-container {
    width: 100%;
    overflow: hidden;
    padding-top: 1.5rem;
    display: flex;
    position: relative;
    margin-bottom: 0rem;
  }

  .marquee-content {
    display: flex;
    gap: 1.5rem; /* 6 (24px) */
    animation: marquee 120s linear infinite; /* Increased duration for smoother scroll */
    flex-shrink: 0;
  }
  
  .marquee-content.reverse {
     animation-direction: reverse;
  }

  .marquee-content:hover {
    animation-play-state: paused;
  }

  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); } 
  }
  
  /* Testimonial Card Styles (Scoped from Snippet) */
  .testimonial-card {
    flex-shrink: 0;
    width: 20rem; /* 80 (320px) */
    background-color: #fff;
    border: 1px solid #e9d5ff;
    border-radius: 0.5rem;
    padding: 1.5rem;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .testimonial-card:hover {
    border-color: #a855f7;
    box-shadow: 0 10px 20px -8px rgba(147, 51, 234, 0.2);
  }

  .stars-row {
    display: flex;
    gap: 0.25rem;
    margin-bottom: 1rem;
  }
  .star-icon {
    color: #facc15; /* yellow-400 */
    fill: #facc15;
    width: 20px;
    height: 20px;
  }

  .client-name {
    color: #111827;
    font-weight: 600;
    margin-bottom: 0.25rem;
    font-size: 1rem;
  }

  .verified-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    font-size: 0.875rem; /* sm */
  }
  .check-icon {
    color: #a855f7;
    width: 16px;
    height: 16px;
  }
  .verified-text {
    color: #6b7280;
  }

  .review-text {
    color: #374151;
    font-size: 0.875rem; /* sm */
    line-height: 1.625;
  }
</style>

<div class="testimonials-section">
  <div class="testimonials-header">
    <h2 class="testimonials-title">What Patch Kraze Customers Say</h2>
    <p class="testimonials-subtitle">Reviews from people who ordered from us</p>
  </div>

  <!-- Top Marquee (Left) -->
  <div class="marquee-container">
    <div class="marquee-content">
      <!-- Loop twice to ensure continuity -->
      {% for i in (1..2) %}
          {% render 'card-review', name: 'Michael Torres', rating: 5, text: "Best patches I've ever ordered. The embroidery detail is incredible and they arrived faster than expected!" %}
          {% render 'card-review', name: 'Sarah Mitchell', rating: 5, text: 'Perfect for our team uniforms. Patch Kraze delivered exactly what we needed. Highly professional!' %}
          {% render 'card-review', name: 'David Chen', rating: 5, text: 'Outstanding quality and customer service. Will definitely order again for our club patches.' %}
          {% render 'card-review', name: 'Jessica Brown', rating: 5, text: 'The custom design process was smooth and the final patches exceeded my expectations!' %}
          {% render 'card-review', name: 'Marcus Williams', rating: 5, text: 'Great communication throughout the process. Patches look professional and durable.' %}
          {% render 'card-review', name: 'Emily Rodriguez', rating: 5, text: 'Love the rush shipping option! Got my patches in time for the event. Top-notch quality!' %}
          {% render 'card-review', name: 'Andrew Thompson', rating: 5, text: 'The attention to detail is phenomenal. Our company logo patches look exactly like the digital proof!' %}
          {% render 'card-review', name: 'Patricia Garcia', rating: 5, text: 'Third time ordering and always impressed. The velcro backing is super strong and holds up great.' %}
          {% render 'card-review', name: 'Kevin O_Brien', rating: 5, text: 'Fast turnaround and excellent customer support. They helped me perfect my design before production.' %}
          {% render 'card-review', name: 'Michelle Lee', rating: 5, text: 'These patches are perfect for our scout troop. Durable, colorful, and reasonably priced!' %}
          {% render 'card-review', name: 'Brandon Davis', rating: 5, text: 'Ordered custom patches for my motorcycle club. Everyone loves them! Will be back for more.' %}
          {% render 'card-review', name: 'Amanda Wilson', rating: 5, text: 'The heat-press application was so easy. Patches look professionally sewn on!' %}
          {% render 'card-review', name: 'Christopher Martinez', rating: 5, text: 'Bulk order discount saved us a ton. Quality remained excellent across all 500 patches.' %}
          {% render 'card-review', name: 'Nicole Taylor', rating: 5, text: 'My small business logo patches turned out beautifully. Customers always ask where I got them!' %}
          {% render 'card-review', name: 'Ryan Anderson', rating: 5, text: 'The 3D puff embroidery option makes our patches stand out. Absolutely love the texture!' %}
          {% render 'card-review', name: 'Stephanie White', rating: 5, text: 'Ordered for a family reunion. Everyone was impressed with the quality and quick delivery!' %}
      {% endfor %}
    </div>
  </div>

  <!-- Bottom Marquee (Right/Reverse) -->
  <div class="marquee-container">
    <div class="marquee-content reverse">
