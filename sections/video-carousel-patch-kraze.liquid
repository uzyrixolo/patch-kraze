{% schema %}
{
  "name": "Video Carousel PK",
  "class": "section-video-carousel-pk",
  "settings": [
    {
      "type": "text",
      "id": "heading_prefix",
      "label": "Heading Prefix",
      "default": "Trusted By"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Heading Highlight",
      "default": "Thousands of People"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight Color",
      "default": "#eb1d25"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "visible_videos_desktop",
      "label": "Videos Visible (Desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "visible_videos_mobile",
      "label": "Videos Visible (Mobile)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "autoplay_visible",
      "label": "Autoplay Visible Videos",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Pick a video from your Content / Files library"
        },
        {
          "type": "image_picker",
          "id": "poster_image",
          "label": "Poster Image (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video Carousel PK",
      "blocks": [
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" }
      ]
    }
  ]
}
{% endschema %}

{%- assign uid = section.id -%}

<section class="vc-pk-{{ uid }}" style="background:{{ section.settings.background_color }}; padding:{{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;">
  {%- if section.settings.heading_prefix != blank or section.settings.heading_highlight != blank -%}
    <h2 class="vc-pk-heading">
      {%- if section.settings.heading_prefix != blank -%}<span>{{ section.settings.heading_prefix }}</span>{%- endif -%}
      {%- if section.settings.heading_highlight != blank -%}
        <span class="vc-pk-highlight" style="color:{{ section.settings.highlight_color }};">{{ section.settings.heading_highlight }}</span>
      {%- endif -%}
    </h2>
  {%- endif -%}

  <div class="vc-pk-wrapper">
    <button class="vc-pk-arrow vc-pk-arrow-prev" type="button" aria-label="Previous">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>

    <div class="vc-pk-track" id="vc-pk-track-{{ uid }}">
      {%- for block in section.blocks -%}
        {%- assign block_video = block.settings.video -%}
        {%- if block_video != blank -%}
          <div class="vc-pk-slide" {{ block.shopify_attributes }}>
            <div class="vc-pk-card">
              <video
                class="vc-pk-video"
                muted
                loop
                playsinline
                preload="metadata"
                {% if block.settings.poster_image != blank %}poster="{{ block.settings.poster_image | image_url: width: 600 }}"{% elsif block_video.preview_image != blank %}poster="{{ block_video.preview_image | image_url: width: 600 }}"{% endif %}
              >
                {%- for source in block_video.sources -%}
                  <source src="{{ source.url }}" type="{{ source.mime_type }}">
                {%- endfor -%}
              </video>
              <button class="vc-pk-mute" type="button" aria-label="Toggle sound">
                <svg class="vc-pk-icon-muted" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
                <svg class="vc-pk-icon-unmuted" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg>
              </button>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <button class="vc-pk-arrow vc-pk-arrow-next" type="button" aria-label="Next">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
  </div>
</section>

<style>
  .vc-pk-{{ uid }} { width: 100%; }
  .vc-pk-{{ uid }} .vc-pk-heading {
    text-align: center;
    font-size: 1.75rem;
    font-weight: 600;
    color: #111827;
    margin: 0 0 1.5rem 0;
    padding: 0 1rem;
  }
  .vc-pk-{{ uid }} .vc-pk-heading span { display: inline; }
  .vc-pk-{{ uid }} .vc-pk-highlight { font-weight: 700; }
  @media (min-width: 768px) {
    .vc-pk-{{ uid }} .vc-pk-heading { font-size: 2rem; }
  }

  .vc-pk-{{ uid }} .vc-pk-wrapper {
    position: relative;
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    padding: 0 0.5rem;
  }

  .vc-pk-{{ uid }} .vc-pk-track {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding: 0.5rem 0;
    scrollbar-width: none;
  }
  .vc-pk-{{ uid }} .vc-pk-track::-webkit-scrollbar { display: none; }

  .vc-pk-{{ uid }} .vc-pk-slide {
    flex: 0 0 calc((100% - (0.75rem * ({{ section.settings.visible_videos_mobile }} - 1))) / {{ section.settings.visible_videos_mobile }});
    scroll-snap-align: start;
  }
  @media (min-width: 1024px) {
    .vc-pk-{{ uid }} .vc-pk-slide {
      flex: 0 0 calc((100% - (0.75rem * ({{ section.settings.visible_videos_desktop }} - 1))) / {{ section.settings.visible_videos_desktop }});
    }
  }

  .vc-pk-{{ uid }} .vc-pk-card {
    position: relative;
    aspect-ratio: 9 / 16;
    width: 100%;
    border-radius: 0.75rem;
    overflow: hidden;
    background: #000;
  }
  .vc-pk-{{ uid }} .vc-pk-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .vc-pk-{{ uid }} .vc-pk-mute {
    position: absolute;
    bottom: 0.5rem;
    right: 0.5rem;
    width: 32px;
    height: 32px;
    border: none;
    border-radius: 9999px;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }
  .vc-pk-{{ uid }} .vc-pk-mute:hover { background: rgba(0, 0, 0, 0.75); }

  .vc-pk-{{ uid }} .vc-pk-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 36px;
    height: 36px;
    border: none;
    border-radius: 9999px;
    background: #fff;
    color: #111827;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 5;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    transition: background 0.2s, transform 0.2s;
  }
  .vc-pk-{{ uid }} .vc-pk-arrow:hover { background: #f3f4f6; }
  .vc-pk-{{ uid }} .vc-pk-arrow-prev { left: 0.25rem; }
  .vc-pk-{{ uid }} .vc-pk-arrow-next { right: 0.25rem; }
  .vc-pk-{{ uid }} .vc-pk-arrow[disabled] { opacity: 0.4; cursor: not-allowed; }

  @media (min-width: 1024px) {
    .vc-pk-{{ uid }} .vc-pk-wrapper { padding: 0 2.5rem; }
    .vc-pk-{{ uid }} .vc-pk-arrow-prev { left: 0.5rem; }
    .vc-pk-{{ uid }} .vc-pk-arrow-next { right: 0.5rem; }
  }
</style>

<script>
  (function() {
    const root = document.querySelector('.vc-pk-{{ uid }}');
    if (!root) return;
    const track = root.querySelector('#vc-pk-track-{{ uid }}');
    const prev = root.querySelector('.vc-pk-arrow-prev');
    const next = root.querySelector('.vc-pk-arrow-next');
    const slides = root.querySelectorAll('.vc-pk-slide');
    if (!track || slides.length === 0) return;

    const autoplayVisible = {{ section.settings.autoplay_visible | json }};

    function getStep() {
      const slide = slides[0];
      if (!slide) return 0;
      const rect = slide.getBoundingClientRect();
      const styles = window.getComputedStyle(track);
      const gap = parseFloat(styles.columnGap || styles.gap || 0) || 0;
      return rect.width + gap;
    }

    function updateArrowState() {
      if (!prev || !next) return;
      const max = track.scrollWidth - track.clientWidth - 2;
      prev.toggleAttribute('disabled', track.scrollLeft <= 0);
      next.toggleAttribute('disabled', track.scrollLeft >= max);
    }

    if (prev) prev.addEventListener('click', () => {
      track.scrollBy({ left: -getStep(), behavior: 'smooth' });
    });
    if (next) next.addEventListener('click', () => {
      track.scrollBy({ left: getStep(), behavior: 'smooth' });
    });
    track.addEventListener('scroll', updateArrowState);
    window.addEventListener('resize', updateArrowState);
    updateArrowState();

    // Mute toggle (per video) — sync UI; default state is muted (loop autoplay)
    root.querySelectorAll('.vc-pk-card').forEach(card => {
      const video = card.querySelector('.vc-pk-video');
      const btn = card.querySelector('.vc-pk-mute');
      const iconMuted = card.querySelector('.vc-pk-icon-muted');
      const iconUnmuted = card.querySelector('.vc-pk-icon-unmuted');
      if (!video || !btn) return;

      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        // Mute all OTHER videos when unmuting this one
        if (video.muted) {
          root.querySelectorAll('.vc-pk-video').forEach(v => {
            if (v !== video) {
              v.muted = true;
              const otherCard = v.closest('.vc-pk-card');
              if (otherCard) {
                const m = otherCard.querySelector('.vc-pk-icon-muted');
                const u = otherCard.querySelector('.vc-pk-icon-unmuted');
                if (m) m.style.display = '';
                if (u) u.style.display = 'none';
              }
            }
          });
          video.muted = false;
        } else {
          video.muted = true;
        }
        if (iconMuted) iconMuted.style.display = video.muted ? '' : 'none';
        if (iconUnmuted) iconUnmuted.style.display = video.muted ? 'none' : '';
      });
    });

    // Autoplay videos when in viewport (loops automatically because of `loop` attribute)
    if (autoplayVisible && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          const video = entry.target;
          if (entry.isIntersecting) {
            const playPromise = video.play();
            if (playPromise && typeof playPromise.catch === 'function') {
              playPromise.catch(() => {});
            }
          } else {
            video.pause();
          }
        });
      }, { threshold: 0.5 });
      root.querySelectorAll('.vc-pk-video').forEach(v => io.observe(v));
    }
  })();
</script>
