{%- doc -%}
  Links for one group of the header menu, each with a small thumbnail.

  Product links come from the header section's "menu_product" blocks whose
  group matches; the thumbnail is the product's first photo that may be shown
  (see snippets/pk-image-ok), so it follows the product if its photos change.
  A block whose product is no longer available uses its backup product
  (the "backup_handle" setting) when that one is available, and otherwise
  prints nothing, so a group can come back empty; the caller then leaves the
  group's heading out. Only when
  the group has no blocks at all is the `fallback` list used instead:
  "Label|/url" or "Label|/url|file-name" entries, the optional third part
  naming an image in Files.

  @param {object} blocks - section.blocks of the header section
  @param {string} group - group key to render
  @param {object} [fallback] - array of "Label|/url[|file-name]" strings
  @param {string} [variant] - 'panel' wraps each link in <li>; anything else does not
{%- enddoc -%}

{%- assign rendered = 0 -%}
{%- assign configured = 0 -%}
{%- for block in blocks -%}
  {%- if block.type != 'menu_product' or block.settings.group != group -%}
    {%- continue -%}
  {%- endif -%}
  {%- assign configured = configured | plus: 1 -%}
  {%- comment -%}
    A product that is no longer available resolves to blank. Try the backup
    product; with neither, skip the link.
  {%- endcomment -%}
  {%- assign item = block.settings.product -%}
  {%- if item == blank and block.settings.backup_handle != blank -%}
    {%- assign item_backup_handle = block.settings.backup_handle | strip -%}
    {%- assign item_backup = all_products[item_backup_handle] -%}
    {%- if item_backup.handle == item_backup_handle -%}{%- assign item = item_backup -%}{%- endif -%}
  {%- endif -%}
  {%- if item == blank -%}
    {%- continue -%}
  {%- endif -%}
  {%- assign rendered = rendered | plus: 1 -%}
  {%- if variant == 'panel' -%}<li {{ block.shopify_attributes }}>{%- endif -%}
    <a href="{{ item.url }}">
      {%- assign item_thumb = '' -%}
      {%- for item_image in item.images -%}
        {%- capture item_image_ok -%}{%- render 'pk-image-ok', src: item_image.src -%}{%- endcapture -%}
        {%- assign item_image_ok = item_image_ok | strip -%}
        {%- if item_image_ok != blank -%}
          {%- assign item_thumb = item_image -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if item_thumb != blank -%}
        <img class="pk-thumb" src="{{ item_thumb | image_url: width: 96, height: 96, crop: 'center' }}" width="48" height="48" alt="" loading="lazy" decoding="async">
      {%- else -%}
        <span class="pk-thumb" aria-hidden="true"></span>
      {%- endif -%}
      <span>{{ block.settings.label | default: item.title }}</span>
    </a>
  {%- if variant == 'panel' -%}</li>{%- endif -%}
{%- endfor -%}

{%- if configured == 0 -%}
  {%- for entry in fallback -%}
    {%- assign pair = entry | split: '|' -%}
    {%- if variant == 'panel' -%}<li>{%- endif -%}
      <a href="{{ pair[1] }}">
        {%- if pair[2] != blank -%}
          {%- assign file_image = images[pair[2]] -%}
          {%- if file_image -%}
            <img class="pk-thumb" src="{{ file_image | image_url: width: 96, height: 96, crop: 'center' }}" width="48" height="48" alt="" loading="lazy" decoding="async">
          {%- else -%}
            <span class="pk-thumb" aria-hidden="true"></span>
          {%- endif -%}
        {%- endif -%}
        <span>{{ pair[0] }}</span>
      </a>
    {%- if variant == 'panel' -%}</li>{%- endif -%}
  {%- endfor -%}
{%- endif -%}
