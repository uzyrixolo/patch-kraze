<style>
  .pk-modal-overlay {
    display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.5); z-index: 1000; justify-content: center; align-items: center;
  }
  .pk-modal-overlay.open { display: flex; animation: fadeIn 0.2s; }
  .pk-modal-content {
    background: white; width: 90%; max-width: 500px; border-radius: 1rem; padding: 2rem;
    position: relative; box-shadow: 0 10px 25px rgba(0,0,0,0.1);
  }
  .pk-close-btn {
    position: absolute; top: 1rem; right: 1rem; background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #6b7280;
  }
  .pk-modal-title { font-size: 1.5rem; font-weight: 700; margin-bottom: 1.5rem; text-align: center; }
  
  .pk-size-table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
  .pk-size-table th { text-align: left; padding: 0.75rem; border-bottom: 2px solid #e5e7eb; color: #374151; font-weight: 600; }
  .pk-size-table td { padding: 0.75rem; border-bottom: 1px solid #f3f4f6; color: #4b5563; }
  .pk-size-table tr:last-child td { border-bottom: none; }
  
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
</style>

<div id="size-guide-modal" class="pk-modal-overlay">
  <div class="pk-modal-content">
    <button class="pk-close-btn" onclick="document.getElementById('size-guide-modal').classList.remove('open')">&times;</button>
    <h3 class="pk-modal-title">Patch Size Guide</h3>
    <p style="text-align: center; color: #6b7280; margin-bottom: 1rem;">Recommended sizes for different placements.</p>
    
    <table class="pk-size-table">
      <thead>
        <tr>
          <th>Product / Placement</th>
          <th>Preferred Size</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Hat Square/Circle Patch</td>
          <td>2 inches</td>
        </tr>
        <tr>
          <td>Hat Rectangle Patch</td>
          <td>4 inches</td>
        </tr>
        <tr>
          <td>Front Left Chest Shirt</td>
          <td>4 inches</td>
        </tr>
        <tr>
          <td>Sleeve</td>
          <td>3 inches</td>
        </tr>
        <tr>
          <td>Back Neckline</td>
          <td>3 inches</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<script>
  function openSizeGuide() {
    document.getElementById('size-guide-modal').classList.add('open');
  }
  document.getElementById('size-guide-modal').addEventListener('click', function(e) {
    if (e.target === this) this.classList.remove('open');
  });
</script>
